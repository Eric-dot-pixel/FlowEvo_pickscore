{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"sed -n '320,520p' /inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/logs/flow_autotts/pickscore_sd35/history_autotts_b64_baseline_injected_20260526_112748/r0001_20260526_112748_8ce8bc14/flow_autotts/controllers/optimal.py\"","aggregated_output":"        if to_prune:\n            try:\n                env.prune(to_prune)\n            except InvalidActionError:\n                pass\n\n    def _should_finish_after_mid(\n        self,\n        env: FlowTTSEnv,\n        particle_id: int,\n        plan: dict[str, float | int | str],\n    ) -> bool:\n        ranked = self._ranked_previews(env)\n        if not ranked:\n            return False\n        preview_id = env.get_state().particles[particle_id].last_preview_id\n        if preview_id is None:\n            return False\n        current = env.get_state().previews.get(preview_id)\n        if current is None or current.score is None:\n            return False\n        best = ranked[0]\n        gap = float(best.score) - float(current.score)\n        uncertainty = float(current.uncertainty or 0.0)\n        return gap <= float(plan[\"confirm_margin\"]) or uncertainty >= float(plan[\"uncertain_threshold\"])\n\n    def _should_refine(\n        self,\n        top_preview: PreviewRecord,\n        runner_up: PreviewRecord | None,\n        plan: dict[str, float | int | str],\n    ) -> bool:\n        uncertainty = float(top_preview.uncertainty or 0.0)\n        if runner_up is None or runner_up.score is None or top_preview.score is None:\n            return uncertainty >= float(plan[\"uncertain_threshold\"])\n        gap = float(top_preview.score) - float(runner_up.score)\n        return gap <= float(plan[\"confirm_margin\"]) or uncertainty >= float(plan[\"uncertain_threshold\"])\n\n    def _rank_active_by_preview(self, env: FlowTTSEnv) -> list[int]:\n        state = env.get_state()\n        active = []\n        unseen = []\n        for particle_id in state.active_particle_ids:\n            particle = state.particles[particle_id]\n            if particle.last_preview_id is None:\n                unseen.append(particle_id)\n                continue\n            preview = state.previews.get(particle.last_preview_id)\n            if preview is None or preview.score is None:\n                unseen.append(particle_id)\n                continue\n            active.append((particle_id, preview))\n        active.sort(\n            key=lambda item: (\n                float(item[1].score),\n                -float(item[1].uncertainty or 0.0),\n                float(item[1].time),\n            ),\n            reverse=True,\n        )\n        return [particle_id for particle_id, _ in active] + unseen\n\n    def _rank_particle_ids_by_preview(self, env: FlowTTSEnv, particle_ids: list[int]) -> list[int]:\n        state = env.get_state()\n        scored = []\n        for particle_id in particle_ids:\n            particle = state.particles.get(particle_id)\n            if particle is None or particle.last_preview_id is None:\n                continue\n            preview = state.previews.get(particle.last_preview_id)\n            if preview is None or preview.score is None:\n                continue\n            scored.append((particle_id, preview))\n        scored.sort(\n            key=lambda item: (\n                float(item[1].score),\n                -float(item[1].uncertainty or 0.0),\n                float(item[1].time),\n            ),\n            reverse=True,\n        )\n        return [particle_id for particle_id, _ in scored]\n\n    def _ranked_previews(self, env: FlowTTSEnv) -> list[PreviewRecord]:\n        state = env.get_state()\n        previews = []\n        for preview in state.previews.values():\n            if preview.score is None:\n                continue\n            particle = state.particles.get(preview.particle_id)\n            if particle is None or particle.status == \"pruned\":\n                continue\n            previews.append(preview)\n        return sorted(\n            previews,\n            key=lambda preview: (\n                float(preview.score),\n                -float(preview.uncertainty or 0.0),\n                float(preview.time),\n            ),\n            reverse=True,\n        )\n\n    def _forward_to(self, env: FlowTTSEnv, particle_id: int, target_time: float, solver: str) -> None:\n        particle = env.get_state().particles.get(particle_id)\n        if particle is None or particle.status != \"active\":\n            return\n        if target_time <= particle.time:\n            return\n        env.forward(particle_id, target_time=target_time, solver=solver)\n\n    def _cost_to_reach(self, env: FlowTTSEnv, particle_id: int, target_time: float) -> int:\n        particle = env.get_state().particles.get(particle_id)\n        if particle is None or particle.status != \"active\":\n            return 0\n        target_step = self._step_index_for_time(env, target_time)\n        current_step = self._step_index_for_time(env, particle.time)\n        return max(0, target_step - current_step)\n\n    def _cost_from_time(self, env: FlowTTSEnv, start_time: float, target_time: float) -> int:\n        return max(0, self._step_index_for_time(env, target_time) - self._step_index_for_time(env, start_time))\n\n    def _child_cost(self, env: FlowTTSEnv, child_time: float, with_mid_preview: bool) -> int:\n        remaining = self._cost_from_time(env, child_time, 1.0)\n        preview_cost = 1\n        if with_mid_preview:\n            preview_cost += 3\n        return remaining + preview_cost\n\n    def _time_at_step(self, env: FlowTTSEnv, step_index: int) -> float:\n        clamped = min(max(int(step_index), 0), len(env.time_grid) - 1)\n        return float(env.time_grid[clamped])\n\n    def _step_index_for_time(self, env: FlowTTSEnv, target_time: float) -> int:\n        best_index = 0\n        best_time = float(env.time_grid[0])\n        for index, time in enumerate(env.time_grid):\n            if float(time) <= float(target_time) + 1e-9:\n                best_index = index\n                best_time = float(time)\n            if float(time) >= float(target_time) - 1e-9:\n                if abs(float(time) - float(target_time)) <= abs(best_time - float(target_time)):\n                    best_index = index\n                break\n        return best_index\n\n    def _next_time(self, env: FlowTTSEnv, particle_id: int) -> float | None:\n        particle = env.get_state().particles.get(particle_id)\n        if particle is None or particle.status != \"active\":\n            return None\n        for time in env.time_grid:\n            if float(time) > float(particle.time):\n                return float(time)\n        return None\n\n    def _can_afford(self, env: FlowTTSEnv, target_nfe: int, cost: int) -> bool:\n        return self._spent(env) + max(0, int(cost)) <= target_nfe and env.budget_left >= max(0, int(cost))\n\n    def _is_active(self, env: FlowTTSEnv, particle_id: int) -> bool:\n        particle = env.get_state().particles.get(particle_id)\n        return particle is not None and particle.status == \"active\"\n\n    def _spent(self, env: FlowTTSEnv) -> int:\n        return max(0, int(env.budget - env.budget_left))\n","exit_code":0,"status":"completed"}}
