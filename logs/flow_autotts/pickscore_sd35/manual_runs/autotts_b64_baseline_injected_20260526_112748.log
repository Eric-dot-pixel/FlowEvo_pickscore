{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' logs/flow_autotts/pickscore_sd35/history_autotts_b64_baseline_injected_20260526_112748/r0003_20260526_112748_8ce8bc14/flow_autotts/controllers/optimal.py\"","aggregated_output":"\"\"\"Candidate controller for SD3.5 PickScore discovery.\"\"\"\n\nfrom __future__ import annotations\n\nfrom flow_autotts.core.env import FlowTTSEnv\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, PreviewRecord\n\n\nclass OptimalController:\n    \"\"\"Beta-shaped late-duel controller with one optional ambiguity repair.\"\"\"\n\n    def solve(self, env: FlowTTSEnv, beta: float) -> AnswerRecord:\n        beta = min(max(float(beta), 0.0), 1.0)\n        plan = self._schedule(env, beta)\n        target_nfe = min(int(plan[\"target_nfe\"]), int(env.budget))\n\n        try:\n            if str(plan[\"mode\"]) == \"single_track\":\n                self._run_single_track(env, target_nfe, int(plan[\"probe_steps\"]))\n            else:\n                active_ids = list(env.spawn(int(plan[\"root_count\"])))\n                for stage in list(plan[\"stages\"]):\n                    selected = self._top_candidate_ids(env, active_ids, int(stage[\"count\"]))\n                    for particle_id in selected:\n                        self._advance_and_preview(\n                            env,\n                            particle_id,\n                            int(stage[\"step\"]),\n                            target_nfe,\n                        )\n                    active_ids = self._prune_after_stage(\n                        env,\n                        active_ids,\n                        keep_count=int(stage.get(\"keep\", stage[\"count\"])),\n                        prune_gap=float(stage.get(\"prune_gap\", 0.0)),\n                    )\n\n                self._late_tail(env, plan, target_nfe)\n        except (BudgetExceededError, InvalidActionError):\n            pass\n\n        try:\n            return env.answer(rule=\"best_preview_score\")\n        except (BudgetExceededError, InvalidActionError):\n            return env.answer(rule=\"latest_active\")\n\n    def _schedule(self, env: FlowTTSEnv, beta: float) -> dict[str, object]:\n        budget = max(0, int(env.budget))\n        steps = max(1, len(env.time_grid) - 1)\n\n        if beta <= 0.0:\n            return {\n                \"mode\": \"single_track\",\n                \"target_nfe\": min(budget, 10),\n                \"probe_steps\": min(5, steps),\n                \"tail_children\": 0,\n            }\n\n        if beta <= 0.25:\n            return {\n                \"mode\": \"multi_root\",\n                \"target_nfe\": min(budget, 20),\n                \"root_count\": 2,\n                \"stages\": [\n                    {\"step\": 1, \"count\": 2, \"keep\": 2},\n                    {\"step\": 4, \"count\": 2, \"keep\": 1, \"prune_gap\": 0.030},\n                    {\"step\": 7, \"count\": 1, \"keep\": 1},\n                    {\"step\": 10, \"count\": 1, \"keep\": 1},\n                ],\n                \"tail_children\": 0,\n            }\n\n        if beta <= 0.5:\n            return {\n                \"mode\": \"multi_root\",\n                \"target_nfe\": min(budget, 36),\n                \"root_count\": 4,\n                \"stages\": [\n                    {\"step\": 1, \"count\": 4, \"keep\": 3, \"prune_gap\": 0.018},\n                    {\"step\": 4, \"count\": 3, \"keep\": 2, \"prune_gap\": 0.022},\n                    {\"step\": 8, \"count\": 2, \"keep\": 2},\n                    {\"step\": 10, \"count\": 2, \"keep\": 2},\n                ],\n                \"tail_children\": 0,\n            }\n\n        if beta <= 0.75:\n            return {\n                \"mode\": \"multi_root\",\n                \"target_nfe\": min(budget, 48),\n                \"root_count\": 4,\n                \"stages\": [\n                    {\"step\": 1, \"count\": 4, \"keep\": 4},\n                    {\"step\": 5, \"count\": 4, \"keep\": 3, \"prune_gap\": 0.014},\n                    {\"step\": 8, \"count\": 3, \"keep\": 2, \"prune_gap\": 0.016},\n                    {\"step\": 9, \"count\": 2, \"keep\": 2},\n                    {\"step\": 10, \"count\": 2, \"keep\": 2},\n                ],\n                \"tail_children\": 0,\n            }\n\n        return {\n            \"mode\": \"multi_root\",\n            \"target_nfe\": min(budget, 64),\n            \"root_count\": 4,\n            \"stages\": [\n                {\"step\": 1, \"count\": 4, \"keep\": 4},\n                {\"step\": 4, \"count\": 4, \"keep\": 4},\n                {\"step\": 7, \"count\": 4, \"keep\": 4},\n                {\"step\": 9, \"count\": 4, \"keep\": 4},\n                {\"step\": 10, \"count\": 4, \"keep\": 4},\n            ],\n            \"tail_children\": 1,\n            \"repair_step\": 8,\n            \"repair_min_time\": self._time_at_step(env, min(9, steps)),\n            \"repair_gap\": 0.012,\n            \"repair_uncertainty\": 0.16,\n            \"repair_noise_policy\": \"mixed_noise\",\n            \"repair_strength\": 0.35,\n        }\n\n    def _run_single_track(self, env: FlowTTSEnv, target_nfe: int, probe_steps: int) -> None:\n        particle_id = env.spawn(1)[0]\n        for step_index in range(1, probe_steps + 1):\n            self._advance_and_preview(env, particle_id, step_index, target_nfe)\n\n    def _late_tail(self, env: FlowTTSEnv, plan: dict[str, object], target_nfe: int) -> None:\n        if int(plan.get(\"tail_children\", 0)) <= 0:\n            return\n\n        ranked = self._rank_latest_previews(env)\n        if not ranked:\n            return\n\n        anchor = self._choose_repair_anchor(\n            ranked,\n            min_time=float(plan[\"repair_min_time\"]),\n            gap_threshold=float(plan[\"repair_gap\"]),\n            uncertainty_gate=float(plan[\"repair_uncertainty\"]),\n        )\n        if anchor is None:\n            return\n\n        repair_step = int(plan[\"repair_step\"])\n        child_cost = self._child_finish_preview_cost(env, repair_step)\n        self._require_budget(env, target_nfe, child_cost)\n\n        child_id = env.backward(\n            anchor.id,\n            target_time=self._time_at_step(env, repair_step),\n            noise_policy=str(plan[\"repair_noise_policy\"]),\n            num_children=1,\n            strength=float(plan[\"repair_strength\"]),\n        )[0]\n        self._advance_and_preview(env, child_id, len(env.time_grid) - 1, target_nfe)\n\n    def _choose_repair_anchor(\n        self,\n        ranked: list[PreviewRecord],\n        min_time: float,\n        gap_threshold: float,\n        uncertainty_gate: float,\n    ) -> PreviewRecord | None:\n        late = [preview for preview in ranked if float(preview.time) >= min_time]\n        if not late:\n            return None\n\n        best = late[0]\n        runner = late[1] if len(late) > 1 else None\n        if runner is not None and best.score is not None and runner.score is not None:\n            if float(best.score) - float(runner.score) <= gap_threshold:\n                runner_uncertainty = float(runner.uncertainty or 0.0)\n                best_uncertainty = float(best.uncertainty or 0.0)\n                return runner if runner_uncertainty >= best_uncertainty - 0.02 else best\n\n        if float(best.uncertainty or 0.0) >= uncertainty_gate:\n            return best\n        return None\n\n    def _advance_and_preview(\n        self,\n        env: FlowTTSEnv,\n        particle_id: int,\n        step_index: int,\n        target_nfe: int,\n    ) -> None:\n        state = env.get_state()\n        particle = state.particles.get(particle_id)\n        if particle is None or particle.status == \"pruned\":\n            raise InvalidActionError(f\"particle {particle_id} is unavailable\")\n\n        target_step = max(0, min(step_index, len(env.time_grid) - 1))\n        current_step = self._step_index(env, float(particle.time))\n        forward_cost = max(0, target_step - current_step)\n        self._require_budget(env, target_nfe, forward_cost + 1)\n\n        if target_step > current_step:\n            if particle.status != \"active\":\n                raise InvalidActionError(f\"particle {particle_id} is no longer active\")\n            env.forward(\n                particle_id,\n                target_time=self._time_at_step(env, target_step),\n                solver=\"euler\",\n            )\n        env.preview(particle_id, mode=\"clean_anchor\", scorer=\"default\")\n\n    def _top_candidate_ids(\n        self,\n        env: FlowTTSEnv,\n        particle_ids: list[int],\n        count: int,\n    ) -> list[int]:\n        ranked = self._rank_particle_ids(env, particle_ids)\n        return ranked[: max(0, min(len(ranked), count))]\n\n    def _prune_after_stage(\n        self,\n        env: FlowTTSEnv,\n        particle_ids: list[int],\n        keep_count: int,\n        prune_gap: float,\n    ) -> list[int]:\n        state = env.get_state()\n        active = [\n            particle_id\n            for particle_id in particle_ids\n            if particle_id in state.particles and state.particles[particle_id].status == \"active\"\n        ]\n        if keep_count <= 0 or len(active) <= keep_count:\n            return active\n\n        ranked = self._rank_particle_ids(env, active)\n        survivors = ranked[:keep_count]\n        cutoff_preview = self._latest_preview(env, survivors[-1]) if survivors else None\n        cutoff_score = float(cutoff_preview.score) if cutoff_preview and cutoff_preview.score is not None else float(\"-inf\")\n\n        losers: list[int] = []\n        for particle_id in ranked[keep_count:]:\n            preview = self._latest_preview(env, particle_id)\n            if preview is None or preview.score is None:\n                losers.append(particle_id)\n                continue\n            if float(preview.score) <= cutoff_score - prune_gap:\n                losers.append(particle_id)\n\n        if losers:\n            env.prune(losers)\n\n        state = env.get_state()\n        return [\n            particle_id\n            for particle_id in survivors\n            if particle_id in state.particles and state.particles[particle_id].status == \"active\"\n        ]\n\n    def _rank_particle_ids(self, env: FlowTTSEnv, particle_ids: list[int]) -> list[int]:\n        state = env.get_state()\n\n        def key(particle_id: int) -> tuple[float, float, float, int]:\n            preview = self._latest_preview_from_state(state, particle_id)\n            if preview is None or preview.score is None:\n                particle = state.particles.get(particle_id)\n                time_value = float(particle.time) if particle is not None else 0.0\n                return (float(\"-inf\"), float(\"-inf\"), time_value, -particle_id)\n            return (\n                float(preview.score),\n                -float(preview.uncertainty or 0.0),\n                float(preview.time),\n                -particle_id,\n            )\n\n        return sorted(particle_ids, key=key, reverse=True)\n\n    def _rank_latest_previews(self, env: FlowTTSEnv) -> list[PreviewRecord]:\n        state = env.get_state()\n        latest: list[PreviewRecord] = []\n        for particle in state.particles.values():\n            if particle.last_preview_id is None:\n                continue\n            preview = state.previews.get(particle.last_preview_id)\n            if preview is None or preview.score is None:\n                continue\n            latest.append(preview)\n        return sorted(\n            latest,\n            key=lambda preview: (\n                float(preview.score),\n                -float(preview.uncertainty or 0.0),\n                float(preview.time),\n                -preview.particle_id,\n            ),\n            reverse=True,\n        )\n\n    def _latest_preview(self, env: FlowTTSEnv, particle_id: int) -> PreviewRecord | None:\n        return self._latest_preview_from_state(env.get_state(), particle_id)\n\n    def _latest_preview_from_state(\n        self,\n        state,\n        particle_id: int,\n    ) -> PreviewRecord | None:\n        particle = state.particles.get(particle_id)\n        if particle is None or particle.last_preview_id is None:\n            return None\n        return state.previews.get(particle.last_preview_id)\n\n    def _child_finish_preview_cost(self, env: FlowTTSEnv, step_index: int) -> int:\n        target_step = max(0, min(step_index, len(env.time_grid) - 1))\n        return max(0, (len(env.time_grid) - 1) - target_step) + 1\n\n    def _require_budget(self, env: FlowTTSEnv, target_nfe: int, needed: int) -> None:\n        if needed <= 0:\n            return\n        if env.budget_left < needed or self._spent(env) + needed > target_nfe:\n            raise BudgetExceededError(\"target compute band reached\")\n\n    def _step_index(self, env: FlowTTSEnv, time_value: float) -> int:\n        return min(\n","exit_code":0,"status":"completed"}}
