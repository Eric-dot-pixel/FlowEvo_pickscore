len(active) <= max(keep_count, preserve):\n            return active\n\n        ranked = self._rank_particle_ids(env, active)\n        cutoff_index = max(preserve, min(len(ranked), keep_count)) - 1\n        cutoff_preview = self._latest_preview(env, ranked[cutoff_index])\n        cutoff_score = float(cutoff_preview.score) if cutoff_preview and cutoff_preview.score is not None else float(\"-inf\")\n\n        survivors = ranked[: max(preserve, keep_count)]\n        losers: list[int] = []\n        for particle_id in ranked[max(preserve, keep_count):]:\n            preview = self._latest_preview(env, particle_id)\n            if preview is None or preview.score is None:\n                losers.append(particle_id)\n                continue\n            if float(preview.score) <= cutoff_score - prune_gap:\n                losers.append(particle_id)\n            else:\n                survivors.append(particle_id)\n\n        if losers:\n            try:\n                env.prune(losers)\n            except InvalidActionError:\n                pass\n\n        return self._available_particle_ids(env, survivors)\n\n    def _advance_and_preview(\n        self,\n        env: FlowTTSEnv,\n        particle_id: int,\n        step_index: int,\n        target_nfe: int,\n    ) -> None:\n        state = env.get_state()\n        particle = state.particles.get(particle_id)\n        if particle is None or particle.status == \"pruned\":\n            raise InvalidActionError(f\"particle {particle_id} is unavailable\")\n\n        target_step = max(0, min(step_index, len(env.time_grid) - 1))\n        current_step = self._step_index(env, float(particle.time))\n        forward_cost = max(0, target_step - current_step)\n        self._require_budget(env, target_nfe, forward_cost + 1)\n\n        if target_step > current_step:\n            env.forward(\n                particle_id,\n                target_time=self._time_at_step(env, target_step),\n                solver=\"euler\",\n            )\n        env.preview(particle_id, mode=\"clean_anchor\", scorer=\"default\")\n\n    def _advance_and_preview_if_possible(\n        self,\n        env: FlowTTSEnv,\n        particle_id: int,\n        step_index: int,\n        target_nfe: int,\n    ) -> bool:\n        try:\n            self._advance_and_preview(env, particle_id, step_index, target_nfe)\n            return True\n        except (BudgetExceededError, InvalidActionError):\n            return False\n\n    def _rank_particle_ids(self, env: FlowTTSEnv, particle_ids: list[int]) -> list[int]:\n        state = env.get_state()\n\n        def key(particle_id: int) -> tuple[float, float, float, int]:\n            preview = self._latest_preview_from_state(state, particle_id)\n            particle = state.particles.get(particle_id)\n            time_value = float(particle.time) if particle is not None else 0.0\n            if preview is None or preview.score is None:\n                return (float(\"-inf\"), float(\"-inf\"), time_value, -particle_id)\n            return (\n                float(preview.score),\n                -float(preview.uncertainty or 0.0),\n                float(preview.time),\n                -particle_id,\n            )\n\n        return sorted(\n            [\n                particle_id\n                for particle_id in particle_ids\n                if particle_id in state.particles and state.particles[particle_id].status != \"pruned\"\n            ],\n            key=key,\n            reverse=True,\n        )\n\n    def _rank_latest_previews(\n        self,\n        env: FlowTTSEnv,\n        particle_ids: list[int] | None = None,\n    ) -> list[PreviewRecord]:\n        state = env.get_state()\n        allowed = None if particle_ids is None else set(particle_ids)\n        previews: list[PreviewRecord] = []\n        for particle in state.particles.values():\n            if allowed is not None and particle.id not in allowed:\n                continue\n            if particle.status == \"pruned\" or particle.last_preview_id is None:\n                continue\n            preview = state.previews.get(particle.last_preview_id)\n            if preview is None or preview.score is None:\n                continue\n            previews.append(preview)\n        return sorted(\n","exit_code":0,"status":"completed"}}
