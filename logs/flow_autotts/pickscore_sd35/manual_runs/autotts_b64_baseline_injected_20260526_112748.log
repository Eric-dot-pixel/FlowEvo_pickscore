{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"sed -n '320,520p' flow_autotts/controllers/optimal.py\"","aggregated_output":"        if to_prune:\n            try:\n                env.prune(to_prune)\n            except InvalidActionError:\n                pass\n\n    def _should_finish_after_mid(\n        self,\n        env: FlowTTSEnv,\n        particle_id: int,\n        plan: dict[str, float | int | str],\n    ) -> bool:\n        ranked = self._ranked_previews(env)\n        if not ranked:\n            return False\n        preview_id = env.get_state().particles[particle_id].last_preview_id\n        if preview_id is None:\n            return False\n        current = env.get_state().previews.get(preview_id)\n        if current is None or current.score is None:\n            return False\n        best = ranked[0]\n        gap = float(best.score) - float(current.score)\n        uncertainty = float(current.uncertainty or 0.0)\n        return gap <= float(plan[\"confirm_margin\"]) or uncertainty >= float(plan[\"uncertain_threshold\"])\n\n    def _should_refine(\n        self,\n        top_preview: PreviewRecord,\n        runner_up: PreviewRecord | None,\n        plan: dict[str, float | int | str],\n    ) -> bool:\n        uncertainty = float(top_preview.uncertainty or 0.0)\n        if runner_up is None or runner_up.score is None or top_preview.score is None:\n            return uncertainty >= float(plan[\"uncertain_threshold\"])\n        gap = float(top_preview.score) - float(runner_up.score)\n        return gap <= float(plan[\"confirm_margin\"]) or uncertainty >= float(plan[\"uncertain_threshold\"])\n\n    def _rank_active_by_preview(self, env: FlowTTSEnv) -> list[int]:\n        state = env.get_state()\n        active = []\n        unseen = []\n        for particle_id in state.active_particle_ids:\n            particle = state.particles[particle_id]\n            if particle.last_preview_id is None:\n                unseen.append(particle_id)\n                continue\n            preview = state.previews.get(particle.last_preview_id)\n            if preview is None or preview.score is None:\n                unseen.append(particle_id)\n                continue\n            active.append((particle_id, preview))\n        active.sort(\n            key=lambda item: (\n                float(item[1].score),\n                -float(item[1].uncertainty or 0.0),\n                float(item[1].time),\n            ),\n            reverse=True,\n        )\n        return [particle_id for particle_id, _ in active] + unseen\n\n    def _rank_particle_ids_by_preview(self, env: FlowTTSEnv, particle_ids: list[int]) -> list[int]:\n        state = env.get_state()\n        scored = []\n        for particle_id in particle_ids:\n            particle = state.particles.get(particle_id)\n            if particle is None or particle.last_preview_id is None:\n                continue\n            preview = state.previews.get(particle.last_preview_id)\n            if preview is None or preview.score is None:\n                continue\n            scored.append((particle_id, preview))\n        scored.sort(\n            key=lambda item: (\n                float(item[1].score),\n                -float(item[1].uncertainty or 0.0),\n                float(item[1].time),\n            ),\n            reverse=True,\n        )\n        return [particle_id for particle_id, _ in scored]\n\n    def _ranked_previews(self, env: FlowTTSEnv) -> list[PreviewRecord]:\n        state = env.get_state()\n        previews = []\n        for preview in state.previews.values():\n            if preview.score is None:\n                continue\n            particle = state.particles.get(preview.particle_id)\n            if particle is None or particle.status == \"pruned\":\n                continue\n            previews.append(preview)\n        return sorted(\n            previews,\n            key=lambda preview: (\n                float(preview.score),\n                -float(preview.uncertainty or 0.0),\n                float(preview.time),\n            ),\n            reverse=True,\n        )\n\n    def _forward_to(self, env: FlowTTSEnv, particle_id: int, target_time: float, solver: str) -> None:\n        particle = env.get_state().particles.get(particle_id)\n        if particle is None or particle.status != \"active\":\n            return\n        if target_time <= particle.time:\n            return\n        env.forward(particle_id, target_time=target_time, solver=solver)\n\n    def _cost_to_reach(self, env: FlowTTSEnv, particle_id: int, target_time: float) -> int:\n        particle = env.get_state().particles.get(particle_id)\n        if particle is None or particle.status != \"active\":\n            return 0\n        target_step = self._step_index_for_time(env, target_time)\n        current_step = self._step_index_for_time(env, particle.time)\n        return max(0, target_step - current_step)\n\n    def _cost_from_time(self, env: FlowTTSEnv, start_time: float, target_time: float) -> int:\n        return max(0, self._step_index_for_time(env, target_time) - self._step_index_for_time(env, start_time))\n\n    def _child_cost(self, env: FlowTTSEnv, child_time: float, with_mid_preview: bool) -> int:\n        remaining = self._cost_from_time(env, child_time, 1.0)\n        preview_cost = 1\n        if with_mid_preview:\n            preview_cost += 3\n        return remaining + preview_cost\n\n    def _time_at_step(self, env: FlowTTSEnv, step_index: int) -> float:\n        clamped = min(max(int(step_index), 0), len(env.time_grid) - 1)\n        return float(env.time_grid[clamped])\n\n    def _step_index_for_time(self, env: FlowTTSEnv, target_time: float) -> int:\n        best_index = 0\n        best_time = float(env.time_grid[0])\n        for index, time in enumerate(env.time_grid):\n            if float(time) <= float(target_time) + 1e-9:\n                best_index = index\n                best_time = float(time)\n            if float(time) >= float(target_time) - 1e-9:\n                if abs(float(time) - float(target_time)) <= abs(best_time - float(target_time)):\n                    best_index = index\n                break\n        return best_index\n\n    def _next_time(self, env: FlowTTSEnv, particle_id: int) -> float | None:\n        particle = env.get_state().particles.get(particle_id)\n        if particle is None or particle.status != \"active\":\n            return None\n        for time in env.time_grid:\n            if float(time) > float(particle.time):\n                return float(time)\n        return None\n\n    def _can_afford(self, env: FlowTTSEnv, target_nfe: int, cost: int) -> bool:\n        return self._spent(env) + max(0, int(cost)) <= target_nfe and env.budget_left >= max(0, int(cost))\n\n    def _is_active(self, env: FlowTTSEnv, particle_id: int) -> bool:\n        particle = env.get_state().particles.get(particle_id)\n        return particle is not None and particle.status == \"active\"\n\n    def _spent(self, env: FlowTTSEnv) -> int:\n        return max(0, int(env.budget - env.budget_left))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass, field\nfrom typing import Any\n\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, EventRecord, ParticleSummary, PreviewRecord\n\n@dataclass\nclass Particle:\n    id: int\n    time: float = 0.0\n    status: str = 'active'\n    last_preview_id: int | None = None\n    nfe_used: int = 0\n    parent_id: int | None = None\n    source_anchor_id: int | None = None\n    num_children: int = 0\n\nclass FakeEnv:\n    def __init__(self, budget=64, steps=10):\n        self.budget = budget\n        self._nfe = 0\n        self.time_grid = tuple(i / steps for i in range(steps + 1))\n        self._next_pid = 0\n        self._next_aid = 0\n        self._particles = {}\n        self._previews = {}\n        self._events = []\n        self._answered = False\n    @property\n    def budget_left(self):\n        return self.budget - self._nfe\n    def _charge(self, n):\n        if self._nfe + n > self.budget:\n            raise BudgetExceededError\n        self._nfe += n\n    def spawn(self, n):\n        if n <= 0:\n            raise InvalidActionError\n        ids=[]\n        for _ in range(n):\n            pid=self._next_pid; self._next_pid += 1\n            self._particles[pid]=Particle(id=pid)\n            ids.append(pid)\n        return ids\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        p=self._particles[particle_id]\n        if p.status \"'!= '\"'active':\n            raise InvalidActionError\n        if target_time <= p.time:\n            raise InvalidActionError\n        ti=self.time_grid.index(target_time)\n        ci=self.time_grid.index(p.time)\n        cost=ti-ci\n        self._charge(cost)\n        p.time=target_time\n        p.nfe_used += cost\n        if abs(target_time-1.0) < 1e-9:\n            p.status='completed'\n        return self.get_state().particles[particle_id]\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p=self._particles[particle_id]\n        if p.status == 'pruned':\n            raise InvalidActionError\n        self._charge(1)\n        aid=self._next_aid; self._next_aid += 1\n        score = 0.5 + 0.05 * p.time + 0.01 * (particle_id % 4) - 0.003 * p.num_children\n        uncertainty = max(0.0, 1.0 - p.time)\n        rec=PreviewRecord(id=aid, particle_id=particle_id, time=p.time, score=score, uncertainty=uncertainty)\n        self._previews[aid]=rec\n        p.last_preview_id=aid\n        p.nfe_used += 1\n        return rec\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        if num_children <= 0:\n            raise InvalidActionError\n        parent_preview=self._previews[anchor_id]\n        parent=self._particles[parent_preview.particle_id]\n        ids=[]\n        for _ in range(num_children):\n            pid=self._next_pid; self._next_pid += 1\n            self._particles[pid]=Particle(id=pid, time=target_time, parent_id=parent.id, source_anchor_id=anchor_id)\n            ids.append(pid)\n        parent.num_children += num_children\n        return ids\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            p=self._particles[pid]\n            if p.status == 'completed':\n                raise InvalidActionError\n            p.status='pruned'\n    def answer(self, rule='best_preview_score'):\n        self._answered = True\n        if rule == 'best_preview_score' and self._previews:\n            best=max(self._previews.values(), key=lambda x: x.score)\n            return AnswerRecord(best.particle_id, best.id, (), best.score, self._nfe, rule, [])\n        active=[p for p in self._particles.values() if p.status in {'active','completed'}]\n        if not active:\n            return AnswerRecord(None,None,(),None,self._nfe,rule,[])\n        chosen=max(active, key=lambda p: (p.time, p.id))\n        if chosen.status == 'active':\n            self.forward(chosen.id, 1.0)\n            chosen=self._particles[chosen.id]\n        reward=0.5 + 0.05*chosen.time\n        return AnswerRecord(chosen.id, chosen.last_preview_id, (), reward, self._nfe, rule, [])\n    def get_state(self):\n        active=[]; completed=[]; pruned=[]\n        particles={}\n        for pid,p in self._particles.items():\n            particles[pid]=ParticleSummary(id=pid, time=p.time, parent_id=p.parent_id, source_anchor_id=p.source_anchor_id, nfe_used=p.nfe_used, status=p.status, last_preview_id=p.last_preview_id, num_children=p.num_children)\n            if p.status == 'active': active.append(pid)\n            elif p.status == 'completed': completed.append(pid)\n            else: pruned.append(pid)\n        return ControllerState(prompt='x', budget_left=self.budget_left, active_particle_ids=active, completed_particle_ids=completed, pruned_particle_ids=pruned, particles=particles, previews=dict(self._previews), event_log=[])\n\ncontroller=OptimalController()\nfor beta in [0.0,0.25,0.5,0.75,1.0]:\n    env=FakeEnv()\n    ans=controller.solve(env,beta)\n    print('beta', beta, 'nfe', ans.nfe_used, 'previews', len(env._previews), 'particles', len(env._particles), 'rule', ans.rule)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
