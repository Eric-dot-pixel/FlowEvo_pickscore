ambda item: (\n+                float(item[1].score),\n+                -float(item[1].uncertainty or 0.0),\n+                float(item[1].time),\n+            ),\n+            reverse=True,\n+        )\n+        return [particle_id for particle_id, _ in scored]\n+\n+    def _ranked_previews(self, env: FlowTTSEnv) -> list[PreviewRecord]:\n+        state = env.get_state()\n+        previews = []\n+        for preview in state.previews.values():\n+            if preview.score is None:\n+                continue\n+            particle = state.particles.get(preview.particle_id)\n+            if particle is None or particle.status == \"pruned\":\n+                continue\n+            previews.append(preview)\n         return sorted(\n             previews,\n             key=lambda preview: (\n-                self._effective_score(preview, uncertainty_penalty),\n                 float(preview.score),\n+                -float(preview.uncertainty or 0.0),\n                 float(preview.time),\n-                -int(preview.id),\n             ),\n             reverse=True,\n         )\n \n-    def _effective_score(self, preview: PreviewRecord, uncertainty_penalty: float) -> float:\n-        return float(preview.score) - uncertainty_penalty * float(preview.uncertainty or 0.0)\n-\n-    def _effective_gap(\n-        self,\n-        ranked: list[PreviewRecord],\n-        uncertainty_penalty: float,\n-    ) -> float:\n-        if len(ranked) < 2:\n-            return float(\"inf\")\n-        top = self._effective_score(ranked[0], uncertainty_penalty)\n-        challenger = self._effective_score(ranked[1], uncertainty_penalty)\n-        return max(0.0, top - challenger)\n-\n-    def _child_finish_preview_cost(self, env: FlowTTSEnv, target_time: float) -> int:\n-        return self._forward_cost(env, target_time, 1.0) + 1\n-\n-    def _forward_cost(self, env: FlowTTSEnv, start_time: float, target_time: float) -> int:\n-        return len(self._forward_targets(env, start_time, target_time))\n-\n-    def _forward_targets(\n-        self,\n-        env: FlowTTSEnv,\n-        start_time: float,\n-        target_time: float,\n-    ) -> list[float]:\n-        start = float(start_time)\n-        target = min(max(float(target_time), 0.0), 1.0)\n-        targets = [\n-            float(time)\n-            for time in env.time_grid\n-            if float(time) > start + _EPS and float(time) <= target + _EPS\n-        ]\n-        if target > start + _EPS and not any(abs(time - target) <= _EPS for time in targets):\n-            targets.append(target)\n-        return sorted(set(targets))\n-\n-    def _grid_time_at_or_after(self, env: FlowTTSEnv, fraction: float) -> float:\n-        target = min(max(float(fraction), 0.0), 1.0)\n-        for time in sorted(float(t) for t in env.time_grid):\n-            if time >= target - _EPS:\n-                return time\n-        return 1.0\n-\n-    def _particle_time(self, env: FlowTTSEnv, particle_id: int) -> float:\n-        state = env.get_state()\n-        return float(state.particles[particle_id].time)\n-\n-    def _has_room(\n-        self,\n-        env: FlowTTSEnv,\n-        initial_budget: int,\n-        target_nfe: int,\n-        cost: int,\n-    ) -> bool:\n-        cost = max(0, int(cost))\n-        return env.budget_left >= cost and self._spent(env, initial_budget) + cost <= target_nfe\n-\n-    def _spent(self, env: FlowTTSEnv, initial_budget: int) -> int:\n-        return max(0, int(initial_budget - env.budget_left))\n-\n-    def _try_prune(self, env: FlowTTSEnv, particle_ids: list[int]) -> None:\n-        unique_ids = sorted(set(int(pid) for pid in particle_ids))\n-        if not unique_ids:\n+    def _forward_to(self, env: FlowTTSEnv, particle_id: int, target_time: float, solver: str) -> None:\n+        particle = env.get_state().particles.get(particle_id)\n+        if particle is None or particle.status != \"active\":\n             return\n-        try:\n-            env.prune(unique_ids)\n-        except InvalidActionError:\n+        if target_time <= particle.time:\n             return\n+        env.forward(particle_id, target_time=target_time, solver=solver)\n+\n+    def _cost_to_reach(self, env: FlowTTSEnv, particle_id: int, target_time: float) -> int:\n+        particle = env.get_state().particles.get(particle_id)\n+        if particle is None or particle.status != \"active\":\n+            return 0\n+        target_step = self._step_index_for_time(env, target_time)\n+        current_step = self._step_index_for_time(env, particle.time)\n+        return max(0, target_step - current_step)\n+\n+    def _cost_from_time(self, env: FlowTTSEnv, start_time: float, target_time: float) -> int:\n+        return max(0, self._step_index_for_time(env, target_time) - self._step_index_for_time(env, start_time))\n+\n+    def _child_cost(self, env: FlowTTSEnv, child_time: float, with_mid_preview: bool) -> int:\n+        remaining = self._cost_from_time(env, child_time, 1.0)\n+        preview_cost = 1\n+        if with_mid_preview:\n+            preview_cost += 3\n+        return remaining + preview_cost\n+\n+    def _time_at_step(self, env: FlowTTSEnv, step_index: int) -> float:\n+        clamped = min(max(int(step_index), 0), len(env.time_grid) - 1)\n+        return float(env.time_grid[clamped])\n+\n+    def _step_index_for_time(self, env: FlowTTSEnv, target_time: float) -> int:\n+        best_index = 0\n+        best_time = float(env.time_grid[0])\n+        for index, time in enumerate(env.time_grid):\n+            if float(time) <= float(target_time) + 1e-9:\n+                best_index = index\n+                best_time = float(time)\n+            if float(time) >= float(target_time) - 1e-9:\n+                if abs(float(time) - float(target_time)) <= abs(best_time - float(target_time)):\n+                    best_index = index\n+                break\n+        return best_index\n+\n+    def _next_time(self, env: FlowTTSEnv, particle_id: int) -> float | None:\n+        particle = env.get_state().particles.get(particle_id)\n+        if particle is None or particle.status != \"active\":\n+            return None\n+        for time in env.time_grid:\n+            if float(time) > float(particle.time):\n+                return float(time)\n+        return None\n \n-    def _answer(self, env: FlowTTSEnv) -> AnswerRecord:\n-        state = env.get_state()\n-        if state.previews:\n-            try:\n-                return env.answer(rule=\"best_preview_score\")\n-            except (BudgetExceededError, InvalidActionError):\n-                pass\n-        return env.answer(rule=\"latest_active\")\n+    def _can_afford(self, env: FlowTTSEnv, target_nfe: int, cost: int) -> bool:\n+        return self._spent(env) + max(0, int(cost)) <= target_nfe and env.budget_left >= max(0, int(cost))\n+\n+    def _is_active(self, env: FlowTTSEnv, particle_id: int) -> bool:\n+        particle = env.get_state().particles.get(particle_id)\n+        return particle is not None and particle.status == \"active\"\n+\n+    def _spent(self, env: FlowTTSEnv) -> int:\n+        return max(0, int(env.budget - env.budget_left))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_28","type":"agent_message","text":"Implemented a new controller in [optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/optimal.py#L10). The policy is a beta-shaped scout/confirm family: start with cheap width (`spawn=4`), preview all roots early, prune weak scouts, advance only the best survivors to mid and late confirmations, then use `backward` only when score gaps are small or uncertainty stays high. The main new mechanism is evidence-gated refinement plus explicit slack spending to repair the mid/high-beta underuse that showed up in `r0000`.\n\nI inspected the context-pack baseline rows and frontier tables, plus the compact `r0000` summary and its controller snapshot. The latest prior metrics were:\n- `beta=0.00`: `10.0 NFE`, `0.728363`, above baseline `0.676462`\n- `beta=0.25`: `18.08 NFE`, `0.822657`, above baseline `0.802083`\n- `beta=0.50`: `31.264 NFE`, `0.833105`, below baseline `0.836650`\n- `beta=0.75`: `43.836 NFE`, `0.837693`, below baseline `0.843990`\n- `beta=1.00`: `60.106 NFE`, `0.840046`, below baseline `0.847290`\n\nThere was not a second distinct recent proposal snapshot to compare against: the current template/current `optimal.py` matched the `r0000` behavior class, so the weakness was still the same one-root / underused mid-high budget pattern rather than a sequence of real controller changes.\n\nThe exact beta schedule is in [optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/optimal.py#L32):\n- `beta=0.00`: target `10`, roots `4`, scout step `1`, keep `4`, confirm `2`, no backward\n- `beta=0.25`: target `20`, roots `4`, scout step `1`, keep `3`, confirm `2`, no backward, `1` slack preview\n- `beta=0.50`: target `36`, roots `4`, scout step `2`, keep `3`, confirm `3`, up to `1` fresh-noise child from top `2` anchors\n- `beta=0.75`: target `48`, roots `4`, scout step `2`, keep `3`, confirm `3`, up to `2` mixed-noise children from top `2` anchors\n- `beta=1.00`: target `64`, roots `4`, scout step `2`, keep `4`, confirm `4`, up to `2` mixed-noise children from top `3` anchors, more slack confirmations\n\nCompute willingness is monotonic because target NFE, confirmation width, refinement eligibility, anchor pool, and slack-confirm budget all increase or stay flat with beta.\n\nBehaviorally new versus the recent best:\n- It no longer starts from a single root and then spends most budget on one trajectory plus late children.\n- It uses score-gap/uncertainty to decide whether late completion is warranted and whether `backward` is worth paying for.\n- It adds explicit budget-band repair: cheap late confirmations are used to fill mid/high-beta slack only when useful, instead of underspending by 4-5 NFE.\n\nChecks run:\n- `python -m py_compile flow_autotts/controllers/optimal.py`\n- Tiny fake-env dry run of `solve()` across `beta in {0, 0.25, 0.5, 0.75, 1.0}`\n\nDry-run realized NFE was `10 / 20 / 36 / 45 / 62`, which stays inside the injected bands:\n- `beta=0.00`, ceiling/band `10 / [10,10]`: underuse not allowed; schedule is fixed to hit `10`\n- `beta=0.25`, ceiling/band `20 / [18,20]`: prior `18.08` was already justified and good, but I still lifted utilization to `20` through one extra confirmation rather than wasteful branching\n- `beta=0.50`, ceiling/band `36 / [32,36]`: prior underuse looked unjustified; adjusted with wider scouting, 3 survivor confirmations, and one evidence-gated child, targeting full `36`\n- `beta=0.75`, ceiling/band `48 / [44,48]`: prior underuse looked unjustified; adjusted with two-child mixed-noise repair plus slack confirmations, expected around `45-48`\n- `beta=1.00`, ceiling/band `64 / [60,64]`: prior `60.1` was still below baseline reward; adjusted with full-width confirmation and more late confirmation/refinement, expected around `62-64`\n\nMain target of this round is `beta=0.5` and `0.75`, with secondary repair at `1.0`. The main risk is that early scout previews may still be noisy enough to prune a late-blooming root, especially if PickScore correlation at `t=0.2` is weaker than expected. A second risk is that mixed-noise children at high beta may add diversity without enough average quality lift if the anchor ranking is already very stable."}}
