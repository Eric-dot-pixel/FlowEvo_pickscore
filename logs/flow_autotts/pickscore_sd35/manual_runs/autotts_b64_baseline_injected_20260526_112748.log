{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, ParticleSummary, PreviewRecord\n\n@dataclass\nclass Particle:\n    id: int\n    time: float = 0.0\n    status: str = 'active'\n    last_preview_id: int | None = None\n    parent_id: int | None = None\n    source_anchor_id: int | None = None\n    nfe_used: int = 0\n    num_children: int = 0\n\nclass FakeEnv:\n    def __init__(self, budget=64, steps=10):\n        self.budget = budget\n        self._nfe = 0\n        self.time_grid = tuple(i/steps for i in range(steps+1))\n        self._particles = {}\n        self._previews = {}\n        self._next_pid = 0\n        self._next_aid = 0\n    @property\n    def budget_left(self):\n        return self.budget - self._nfe\n    def spawn(self, n):\n        ids = []\n        for _ in range(n):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = Particle(id=pid)\n            ids.append(pid)\n        return ids\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        p = self._particles[particle_id]\n        if p.status \"'!= '\"'active':\n            raise InvalidActionError('inactive')\n        ci = self.time_grid.index(p.time)\n        ti = self.time_grid.index(target_time)\n        cost = ti - ci\n        if cost <= 0:\n            raise InvalidActionError('bad forward')\n        if self._nfe + cost > self.budget:\n            raise BudgetExceededError\n        self._nfe += cost\n        p.nfe_used += cost\n        p.time = target_time\n        if target_time >= 1.0:\n            p.status = 'completed'\n        return self.get_state().particles[particle_id]\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p = self._particles[particle_id]\n        if self._nfe + 1 > self.budget:\n            raise BudgetExceededError\n        self._nfe += 1\n        aid = self._next_aid\n        self._next_aid += 1\n        score = 0.52 + 0.11 * p.time + 0.015 * (particle_id % 4) - 0.01 * p.num_children\n        rec = PreviewRecord(id=aid, particle_id=particle_id, time=p.time, score=score, uncertainty=max(0.0, 0.18 - 0.08 * p.time), drift=1-p.time)\n        self._previews[aid] = rec\n        p.last_preview_id = aid\n        p.nfe_used += 1\n        return rec\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        src = self._previews[anchor_id].particle_id\n        self._particles[src].num_children += num_children\n        ids = []\n        for _ in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = Particle(id=pid, time=target_time, parent_id=src, source_anchor_id=anchor_id)\n            ids.append(pid)\n        return ids\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            p = self._particles[pid]\n            if p.status == 'completed':\n                raise InvalidActionError('completed prune')\n            p.status = 'pruned'\n    def answer(self, rule='best_preview_score'):\n        if rule == 'best_preview_score' and self._previews:\n            best = max(self._previews.values(), key=lambda x: x.score)\n            return AnswerRecord(best.particle_id, best.id, (), best.score, self._nfe, rule, [])\n        active = [p for p in self._particles.values() if p.status in {'active','completed'}]\n        best = max(active, key=lambda p: (p.time, p.id)) if active else None\n        return AnswerRecord(None if best is None else best.id, None if best is None else best.last_preview_id, (), None, self._nfe, rule, [])\n    def get_state(self):\n        active = [pid for pid,p in self._particles.items() if p.status == 'active']\n        completed = [pid for pid,p in self._particles.items() if p.status == 'completed']\n        pruned = [pid for pid,p in self._particles.items() if p.status == 'pruned']\n        return ControllerState(\n            prompt='x', budget_left=self.budget_left, active_particle_ids=active, completed_particle_ids=completed, pruned_particle_ids=pruned,\n            particles={pid: ParticleSummary(id=p.id, time=p.time, parent_id=p.parent_id, source_anchor_id=p.source_anchor_id, nfe_used=p.nfe_used, status=p.status, last_preview_id=p.last_preview_id, num_children=p.num_children) for pid,p in self._particles.items()},\n            previews=dict(self._previews), event_log=[])\n\ncontroller = OptimalController()\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FakeEnv()\n    ans = controller.solve(env, beta)\n    print({'beta': beta, 'nfe': ans.nfe_used, 'rule': ans.rule, 'preview_id': ans.preview_id})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, ParticleSummary, PreviewRecord\n\n@dataclass\nclass Particle:\n    id: int\n    time: float = 0.0\n    status: str = 'active'\n    last_preview_id: int | None = None\n    parent_id: int | None = None\n    source_anchor_id: int | None = None\n    nfe_used: int = 0\n    num_children: int = 0\n\nclass FakeEnv:\n    def __init__(self, budget=64, steps=10):\n        self.budget = budget\n        self._nfe = 0\n        self.time_grid = tuple(i/steps for i in range(steps+1))\n        self._particles = {}\n        self._previews = {}\n        self._next_pid = 0\n        self._next_aid = 0\n    @property\n    def budget_left(self):\n        return self.budget - self._nfe\n    def spawn(self, n):\n        ids = []\n        for _ in range(n):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = Particle(id=pid)\n            ids.append(pid)\n        return ids\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        p = self._particles[particle_id]\n        if p.status \"'!= '\"'active':\n            raise InvalidActionError('inactive')\n        ci = self.time_grid.index(p.time)\n        ti = self.time_grid.index(target_time)\n        cost = ti - ci\n        if cost <= 0:\n            raise InvalidActionError('bad forward')\n        if self._nfe + cost > self.budget:\n            raise BudgetExceededError\n        self._nfe += cost\n        p.nfe_used += cost\n        p.time = target_time\n        if target_time >= 1.0:\n            p.status = 'completed'\n        return self.get_state().particles[particle_id]\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p = self._particles[particle_id]\n        if self._nfe + 1 > self.budget:\n            raise BudgetExceededError\n        self._nfe += 1\n        aid = self._next_aid\n        self._next_aid += 1\n        score = 0.52 + 0.11 * p.time + 0.015 * (particle_id % 4) - 0.01 * p.num_children\n        rec = PreviewRecord(id=aid, particle_id=particle_id, time=p.time, score=score, uncertainty=max(0.0, 0.18 - 0.08 * p.time), drift=1-p.time)\n        self._previews[aid] = rec\n        p.last_preview_id = aid\n        p.nfe_used += 1\n        return rec\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        src = self._previews[anchor_id].particle_id\n        self._particles[src].num_children += num_children\n        ids = []\n        for _ in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = Particle(id=pid, time=target_time, parent_id=src, source_anchor_id=anchor_id)\n            ids.append(pid)\n        return ids\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            p = self._particles[pid]\n            if p.status == 'completed':\n                raise InvalidActionError('completed prune')\n            p.status = 'pruned'\n    def answer(self, rule='best_preview_score'):\n        if rule == 'best_preview_score' and self._previews:\n            best = max(self._previews.values(), key=lambda x: x.score)\n            return AnswerRecord(best.particle_id, best.id, (), best.score, self._nfe, rule, [])\n        active = [p for p in self._particles.values() if p.status in {'active','completed'}]\n        best = max(active, key=lambda p: (p.time, p.id)) if active else None\n        return AnswerRecord(None if best is None else best.id, None if best is None else best.last_preview_id, (), None, self._nfe, rule, [])\n    def get_state(self):\n        active = [pid for pid,p in self._particles.items() if p.status == 'active']\n        completed = [pid for pid,p in self._particles.items() if p.status == 'completed']\n        pruned = [pid for pid,p in self._particles.items() if p.status == 'pruned']\n        return ControllerState(\n            prompt='x', budget_left=self.budget_left, active_particle_ids=active, completed_particle_ids=completed, pruned_particle_ids=pruned,\n            particles={pid: ParticleSummary(id=p.id, time=p.time, parent_id=p.parent_id, source_anchor_id=p.source_anchor_id, nfe_used=p.nfe_used, status=p.status, last_preview_id=p.last_preview_id, num_children=p.num_children) for pid,p in self._particles.items()},\n            previews=dict(self._previews), event_log=[])\n\ncontroller = OptimalController()\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FakeEnv()\n    ans = controller.solve(env, beta)\n    print({'beta': beta, 'nfe': ans.nfe_used, 'rule': ans.rule, 'preview_id': ans.preview_id})\nPY\"","aggregated_output":"{'beta': 0.0, 'nfe': 10, 'rule': 'best_preview_score', 'preview_id': 4}\n{'beta': 0.25, 'nfe': 18, 'rule': 'best_preview_score', 'preview_id': 4}\n{'beta': 0.5, 'nfe': 32, 'rule': 'best_preview_score', 'preview_id': 4}\n{'beta': 0.75, 'nfe': 45, 'rule': 'best_preview_score', 'preview_id': 4}\n{'beta': 1.0, 'nfe': 56, 'rule': 'best_preview_score', 'preview_id': 4}\n","exit_code":0,"status":"completed"}}
