{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"nl -ba flow_autotts/controllers/optimal.py | sed -n '1,260p'\"","aggregated_output":"     1\t\"\"\"Candidate controller for SD3.5 PickScore discovery.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\tfrom flow_autotts.core.env import FlowTTSEnv\n     6\tfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\n     7\tfrom flow_autotts.core.state import AnswerRecord, PreviewRecord\n     8\t\n     9\t\n    10\tclass OptimalController:\n    11\t    \"\"\"Beta-shaped late-duel controller with one optional ambiguity repair.\"\"\"\n    12\t\n    13\t    def solve(self, env: FlowTTSEnv, beta: float) -> AnswerRecord:\n    14\t        beta = min(max(float(beta), 0.0), 1.0)\n    15\t        plan = self._schedule(env, beta)\n    16\t        target_nfe = min(int(plan[\"target_nfe\"]), int(env.budget))\n    17\t\n    18\t        try:\n    19\t            if str(plan[\"mode\"]) == \"single_track\":\n    20\t                self._run_single_track(env, target_nfe, int(plan[\"probe_steps\"]))\n    21\t            else:\n    22\t                active_ids = list(env.spawn(int(plan[\"root_count\"])))\n    23\t                for stage in list(plan[\"stages\"]):\n    24\t                    selected = self._top_candidate_ids(env, active_ids, int(stage[\"count\"]))\n    25\t                    for particle_id in selected:\n    26\t                        self._advance_and_preview(\n    27\t                            env,\n    28\t                            particle_id,\n    29\t                            int(stage[\"step\"]),\n    30\t                            target_nfe,\n    31\t                        )\n    32\t                    active_ids = self._prune_after_stage(\n    33\t                        env,\n    34\t                        active_ids,\n    35\t                        keep_count=int(stage.get(\"keep\", stage[\"count\"])),\n    36\t                        prune_gap=float(stage.get(\"prune_gap\", 0.0)),\n    37\t                    )\n    38\t\n    39\t                self._late_tail(env, plan, target_nfe)\n    40\t        except (BudgetExceededError, InvalidActionError):\n    41\t            pass\n    42\t\n    43\t        try:\n    44\t            return env.answer(rule=\"best_preview_score\")\n    45\t        except (BudgetExceededError, InvalidActionError):\n    46\t            return env.answer(rule=\"latest_active\")\n    47\t\n    48\t    def _schedule(self, env: FlowTTSEnv, beta: float) -> dict[str, object]:\n    49\t        budget = max(0, int(env.budget))\n    50\t        steps = max(1, len(env.time_grid) - 1)\n    51\t\n    52\t        if beta <= 0.0:\n    53\t            return {\n    54\t                \"mode\": \"single_track\",\n    55\t                \"target_nfe\": min(budget, 10),\n    56\t                \"probe_steps\": min(5, steps),\n    57\t                \"tail_children\": 0,\n    58\t            }\n    59\t\n    60\t        if beta <= 0.25:\n    61\t            return {\n    62\t                \"mode\": \"multi_root\",\n    63\t                \"target_nfe\": min(budget, 20),\n    64\t                \"root_count\": 2,\n    65\t                \"stages\": [\n    66\t                    {\"step\": 1, \"count\": 2, \"keep\": 2},\n    67\t                    {\"step\": 4, \"count\": 2, \"keep\": 1, \"prune_gap\": 0.030},\n    68\t                    {\"step\": 7, \"count\": 1, \"keep\": 1},\n    69\t                    {\"step\": 10, \"count\": 1, \"keep\": 1},\n    70\t                ],\n    71\t                \"tail_children\": 0,\n    72\t            }\n    73\t\n    74\t        if beta <= 0.5:\n    75\t            return {\n    76\t                \"mode\": \"multi_root\",\n    77\t                \"target_nfe\": min(budget, 36),\n    78\t                \"root_count\": 4,\n    79\t                \"stages\": [\n    80\t                    {\"step\": 1, \"count\": 4, \"keep\": 3, \"prune_gap\": 0.018},\n    81\t                    {\"step\": 4, \"count\": 3, \"keep\": 2, \"prune_gap\": 0.022},\n    82\t                    {\"step\": 8, \"count\": 2, \"keep\": 2},\n    83\t                    {\"step\": 10, \"count\": 2, \"keep\": 2},\n    84\t                ],\n    85\t                \"tail_children\": 0,\n    86\t            }\n    87\t\n    88\t        if beta <= 0.75:\n    89\t            return {\n    90\t                \"mode\": \"multi_root\",\n    91\t                \"target_nfe\": min(budget, 48),\n    92\t                \"root_count\": 4,\n    93\t                \"stages\": [\n    94\t                    {\"step\": 1, \"count\": 4, \"keep\": 4},\n    95\t                    {\"step\": 5, \"count\": 4, \"keep\": 3, \"prune_gap\": 0.014},\n    96\t                    {\"step\": 8, \"count\": 3, \"keep\": 2, \"prune_gap\": 0.016},\n    97\t                    {\"step\": 9, \"count\": 2, \"keep\": 2},\n    98\t                    {\"step\": 10, \"count\": 2, \"keep\": 2},\n    99\t                ],\n   100\t                \"tail_children\": 0,\n   101\t            }\n   102\t\n   103\t        return {\n   104\t            \"mode\": \"multi_root\",\n   105\t            \"target_nfe\": min(budget, 64),\n   106\t            \"root_count\": 4,\n   107\t            \"stages\": [\n   108\t                {\"step\": 1, \"count\": 4, \"keep\": 4},\n   109\t                {\"step\": 4, \"count\": 4, \"keep\": 4},\n   110\t                {\"step\": 7, \"count\": 4, \"keep\": 4},\n   111\t                {\"step\": 9, \"count\": 4, \"keep\": 4},\n   112\t                {\"step\": 10, \"count\": 4, \"keep\": 4},\n   113\t            ],\n   114\t            \"tail_children\": 1,\n   115\t            \"repair_step\": 8,\n   116\t            \"repair_min_time\": self._time_at_step(env, min(9, steps)),\n   117\t            \"repair_gap\": 0.012,\n   118\t            \"repair_uncertainty\": 0.16,\n   119\t            \"repair_noise_policy\": \"mixed_noise\",\n   120\t            \"repair_strength\": 0.35,\n   121\t        }\n   122\t\n   123\t    def _run_single_track(self, env: FlowTTSEnv, target_nfe: int, probe_steps: int) -> None:\n   124\t        particle_id = env.spawn(1)[0]\n   125\t        for step_index in range(1, probe_steps + 1):\n   126\t            self._advance_and_preview(env, particle_id, step_index, target_nfe)\n   127\t\n   128\t    def _late_tail(self, env: FlowTTSEnv, plan: dict[str, object], target_nfe: int) -> None:\n   129\t        if int(plan.get(\"tail_children\", 0)) <= 0:\n   130\t            return\n   131\t\n   132\t        ranked = self._rank_latest_previews(env)\n   133\t        if not ranked:\n   134\t            return\n   135\t\n   136\t        anchor = self._choose_repair_anchor(\n   137\t            ranked,\n   138\t            min_time=float(plan[\"repair_min_time\"]),\n   139\t            gap_threshold=float(plan[\"repair_gap\"]),\n   140\t            uncertainty_gate=float(plan[\"repair_uncertainty\"]),\n   141\t        )\n   142\t        if anchor is None:\n   143\t            return\n   144\t\n   145\t        repair_step = int(plan[\"repair_step\"])\n   146\t        child_cost = self._child_finish_preview_cost(env, repair_step)\n   147\t        self._require_budget(env, target_nfe, child_cost)\n   148\t\n   149\t        child_id = env.backward(\n   150\t            anchor.id,\n   151\t            target_time=self._time_at_step(env, repair_step),\n   152\t            noise_policy=str(plan[\"repair_noise_policy\"]),\n   153\t            num_children=1,\n   154\t            strength=float(plan[\"repair_strength\"]),\n   155\t        )[0]\n   156\t        self._advance_and_preview(env, child_id, len(env.time_grid) - 1, target_nfe)\n   157\t\n   158\t    def _choose_repair_anchor(\n   159\t        self,\n   160\t        ranked: list[PreviewRecord],\n   161\t        min_time: float,\n   162\t        gap_threshold: float,\n   163\t        uncertainty_gate: float,\n   164\t    ) -> PreviewRecord | None:\n   165\t        late = [preview for preview in ranked if float(preview.time) >= min_time]\n   166\t        if not late:\n   167\t            return None\n   168\t\n   169\t        best = late[0]\n   170\t        runner = late[1] if len(late) > 1 else None\n   171\t        if runner is not None and best.score is not None and runner.score is not None:\n   172\t            if float(best.score) - float(runner.score) <= gap_threshold:\n   173\t                runner_uncertainty = float(runner.uncertainty or 0.0)\n   174\t                best_uncertainty = float(best.uncertainty or 0.0)\n   175\t                return runner if runner_uncertainty >= best_uncertainty - 0.02 else best\n   176\t\n   177\t        if float(best.uncertainty or 0.0) >= uncertainty_gate:\n   178\t            return best\n   179\t        return None\n   180\t\n   181\t    def _advance_and_preview(\n   182\t        self,\n   183\t        env: FlowTTSEnv,\n   184\t        particle_id: int,\n   185\t        step_index: int,\n   186\t        target_nfe: int,\n   187\t    ) -> None:\n   188\t        state = env.get_state()\n   189\t        particle = state.particles.get(particle_id)\n   190\t        if particle is None or particle.status == \"pruned\":\n   191\t            raise InvalidActionError(f\"particle {particle_id} is unavailable\")\n   192\t\n   193\t        target_step = max(0, min(step_index, len(env.time_grid) - 1))\n   194\t        current_step = self._step_index(env, float(particle.time))\n   195\t        forward_cost = max(0, target_step - current_step)\n   196\t        self._require_budget(env, target_nfe, forward_cost + 1)\n   197\t\n   198\t        if target_step > current_step:\n   199\t            if particle.status != \"active\":\n   200\t                raise InvalidActionError(f\"particle {particle_id} is no longer active\")\n   201\t            env.forward(\n   202\t                particle_id,\n   203\t                target_time=self._time_at_step(env, target_step),\n   204\t                solver=\"euler\",\n   205\t            )\n   206\t        env.preview(particle_id, mode=\"clean_anchor\", scorer=\"default\")\n   207\t\n   208\t    def _top_candidate_ids(\n   209\t        self,\n   210\t        env: FlowTTSEnv,\n   211\t        particle_ids: list[int],\n   212\t        count: int,\n   213\t    ) -> list[int]:\n   214\t        ranked = self._rank_particle_ids(env, particle_ids)\n   215\t        return ranked[: max(0, min(len(ranked), count))]\n   216\t\n   217\t    def _prune_after_stage(\n   218\t        self,\n   219\t        env: FlowTTSEnv,\n   220\t        particle_ids: list[int],\n   221\t        keep_count: int,\n   222\t        prune_gap: float,\n   223\t    ) -> list[int]:\n   224\t        state = env.get_state()\n   225\t        active = [\n   226\t            particle_id\n   227\t            for particle_id in particle_ids\n   228\t            if particle_id in state.particles and state.particles[particle_id].status == \"active\"\n   229\t        ]\n   230\t        if keep_count <= 0 or len(active) <= keep_count:\n   231\t            return active\n   232\t\n   233\t        ranked = self._rank_particle_ids(env, active)\n   234\t        survivors = ranked[:keep_count]\n   235\t        cutoff_preview = self._latest_preview(env, survivors[-1]) if survivors else None\n   236\t        cutoff_score = float(cutoff_preview.score) if cutoff_preview and cutoff_preview.score is not None else float(\"-inf\")\n   237\t\n   238\t        losers: list[int] = []\n   239\t        for particle_id in ranked[keep_count:]:\n   240\t            preview = self._latest_preview(env, particle_id)\n   241\t            if preview is None or preview.score is None:\n   242\t                losers.append(particle_id)\n   243\t                continue\n   244\t            if float(preview.score) <= cutoff_score - prune_gap:\n   245\t                losers.append(particle_id)\n   246\t\n   247\t        if losers:\n   248\t            env.prune(losers)\n   249\t\n   250\t        state = env.get_state()\n   251\t        return [\n   252\t            particle_id\n   253\t            for particle_id in survivors\n   254\t            if particle_id in state.particles and state.particles[particle_id].status == \"active\"\n   255\t        ]\n   256\t\n   257\t    def _rank_particle_ids(self, env: FlowTTSEnv, particle_ids: list[int]) -> list[int]:\n   258\t        state = env.get_state()\n   259\t\n   260\t        def key(particle_id: int) -> tuple[float, float, float, int]:\n","exit_code":0,"status":"completed"}}
