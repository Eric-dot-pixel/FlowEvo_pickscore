{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' logs/flow_autotts/pickscore_sd35/history_autotts_b64_baseline_injected_20260526_112748/r0002_20260526_112748_8ce8bc14/flow_autotts/controllers/optimal.py\"","aggregated_output":"\"\"\"Candidate controller for SD3.5 PickScore discovery.\"\"\"\n\nfrom __future__ import annotations\n\nfrom flow_autotts.core.env import FlowTTSEnv\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, PreviewRecord\n\n\nclass OptimalController:\n    \"\"\"Ambiguity-aware champion/challenger controller with selective repair.\"\"\"\n\n    def solve(self, env: FlowTTSEnv, beta: float) -> AnswerRecord:\n        beta = min(max(float(beta), 0.0), 1.0)\n        plan = self._schedule(env, beta)\n        target_nfe = int(plan[\"target_nfe\"])\n        child_counts: dict[int, int] = {}\n\n        try:\n            if str(plan[\"mode\"]) == \"single_track\":\n                self._run_single_track_probe(env, target_nfe, int(plan[\"probe_steps\"]))\n            else:\n                root_ids = env.spawn(int(plan[\"root_count\"]))\n                self._advance_ids_to_step(env, root_ids, int(plan[\"scout_step\"]), target_nfe)\n                self._prune_after_scout(env, int(plan[\"scout_keep\"]))\n\n                self._advance_top_active_to_step(\n                    env,\n                    limit=int(plan[\"mid_count\"]),\n                    step_index=int(plan[\"mid_step\"]),\n                    target_nfe=target_nfe,\n                )\n                self._prune_trailing_active(env, int(plan[\"reserve_count\"]), float(plan[\"prune_gap\"]))\n\n                late_count = int(plan[\"late_count\"])\n                if late_count > 0:\n                    self._advance_top_active_to_step(\n                        env,\n                        limit=late_count,\n                        step_index=int(plan[\"late_step\"]),\n                        target_nfe=target_nfe,\n                    )\n\n                final_count = int(plan[\"final_count\"])\n                if final_count > 0:\n                    self._advance_top_active_to_step(\n                        env,\n                        limit=final_count,\n                        step_index=len(env.time_grid) - 1,\n                        target_nfe=target_nfe,\n                    )\n\n                self._allocate_tail_budget(env, plan, target_nfe, child_counts)\n        except (BudgetExceededError, InvalidActionError):\n            pass\n\n        try:\n            return env.answer(rule=\"best_preview_score\")\n        except (BudgetExceededError, InvalidActionError):\n            return env.answer(rule=\"latest_active\")\n\n    def _schedule(self, env: FlowTTSEnv, beta: float) -> dict[str, float | int | str]:\n        budget = max(0, int(env.budget))\n        steps = max(1, len(env.time_grid) - 1)\n        scout_step = 1 if steps >= 1 else 0\n        mid_step = min(steps, max(scout_step + 1, int(round(0.4 * steps))))\n        late_step = min(steps, max(mid_step + 1, int(round(0.7 * steps))))\n        low_amb_step = min(steps, max(mid_step + 1, int(round(0.6 * steps))))\n        low_clear_step = min(steps, max(low_amb_step + 1, int(round(0.7 * steps))))\n        low_runner_step = min(steps, max(mid_step + 1, mid_step + 1))\n\n        if beta <= 0.0:\n            return {\n                \"mode\": \"single_track\",\n                \"target_nfe\": min(budget, 10),\n                \"probe_steps\": min(5, steps),\n            }\n\n        if beta <= 0.25:\n            return {\n                \"mode\": \"multi_root\",\n                \"target_nfe\": min(budget, 20),\n                \"root_count\": 3,\n                \"scout_step\": scout_step,\n                \"scout_keep\": 2,\n                \"mid_count\": 2,\n                \"mid_step\": mid_step,\n                \"late_count\": 0,\n                \"late_step\": low_amb_step,\n                \"final_count\": 0,\n                \"reserve_count\": 2,\n                \"prune_gap\": 0.040,\n                \"ambiguity_gap\": 0.022,\n                \"uncertainty_gate\": 0.32,\n                \"challenger_gap\": 0.040,\n                \"low_ambiguous_step\": low_amb_step,\n                \"low_clear_step\": low_clear_step,\n                \"low_clear_runner_step\": low_runner_step,\n                \"refine_step\": low_amb_step,\n                \"noise_policy\": \"fresh_noise\",\n                \"strength\": 1.0,\n                \"ambiguous_children\": 0,\n                \"confident_children\": 0,\n            }\n\n        if beta <= 0.5:\n            return {\n                \"mode\": \"multi_root\",\n                \"target_nfe\": min(budget, 36),\n                \"root_count\": 4,\n                \"scout_step\": scout_step,\n                \"scout_keep\": 3,\n                \"mid_count\": 3,\n                \"mid_step\": mid_step,\n                \"late_count\": 2,\n                \"late_step\": late_step,\n                \"final_count\": 0,\n                \"reserve_count\": 3,\n                \"prune_gap\": 0.046,\n                \"ambiguity_gap\": 0.018,\n                \"uncertainty_gate\": 0.24,\n                \"challenger_gap\": 0.030,\n                \"refine_step\": late_step,\n                \"noise_policy\": \"fresh_noise\",\n                \"strength\": 1.0,\n                \"ambiguous_children\": 0,\n                \"confident_children\": 1,\n            }\n\n        if beta <= 0.75:\n            return {\n                \"mode\": \"multi_root\",\n                \"target_nfe\": min(budget, 48),\n                \"root_count\": 4,\n                \"scout_step\": scout_step,\n                \"scout_keep\": 3,\n                \"mid_count\": 3,\n                \"mid_step\": mid_step,\n                \"late_count\": 2,\n                \"late_step\": late_step,\n                \"final_count\": 2,\n                \"reserve_count\": 3,\n                \"prune_gap\": 0.055,\n                \"ambiguity_gap\": 0.015,\n                \"uncertainty_gate\": 0.20,\n                \"challenger_gap\": 0.024,\n                \"refine_step\": late_step,\n                \"noise_policy\": \"mixed_noise\",\n                \"strength\": 0.45,\n                \"ambiguous_children\": 2,\n                \"confident_children\": 3,\n            }\n\n        return {\n            \"mode\": \"multi_root\",\n            \"target_nfe\": min(budget, 64),\n            \"root_count\": 4,\n            \"scout_step\": scout_step,\n            \"scout_keep\": 4,\n            \"mid_count\": 4,\n            \"mid_step\": mid_step,\n            \"late_count\": 3,\n            \"late_step\": late_step,\n            \"final_count\": 2,\n            \"reserve_count\": 4,\n            \"prune_gap\": 0.065,\n            \"ambiguity_gap\": 0.012,\n            \"uncertainty_gate\": 0.18,\n            \"challenger_gap\": 0.020,\n            \"refine_step\": late_step,\n            \"noise_policy\": \"mixed_noise\",\n            \"strength\": 0.35,\n            \"ambiguous_children\": 3,\n            \"confident_children\": 4,\n        }\n\n    def _run_single_track_probe(self, env: FlowTTSEnv, target_nfe: int, probe_steps: int) -> None:\n        particle_id = env.spawn(1)[0]\n        for step_index in range(1, probe_steps + 1):\n            if not self._can_afford_to_step_and_preview(env, particle_id, step_index, target_nfe):\n                return\n            self._forward_to_step(env, particle_id, step_index, solver=\"euler\")\n            env.preview(particle_id, mode=\"clean_anchor\", scorer=\"default\")\n\n    def _allocate_tail_budget(\n        self,\n        env: FlowTTSEnv,\n        plan: dict[str, float | int | str],\n        target_nfe: int,\n        child_counts: dict[int, int],\n    ) -> None:\n        if int(plan[\"target_nfe\"]) <= self._spent(env):\n            return\n\n        if int(plan[\"target_nfe\"]) <= 20:\n            self._low_beta_tail(env, plan, target_nfe)\n            return\n\n        while env.budget_left > 0 and self._spent(env) < target_nfe:\n            ranked = self._ranked_latest_previews(env)\n            if not ranked:\n                return\n            second = ranked[1] if len(ranked) > 1 else None\n            ambiguous = self._is_ambiguous(ranked[0], second, plan)\n\n            progressed = False\n            if ambiguous:\n                progressed = self._promote_active_contenders(\n                    env,\n                    plan,\n                    target_nfe,\n                    desired=2,\n                    step_index=len(env.time_grid) - 1,\n                )\n                if not progressed and int(plan[\"target_nfe\"]) >= 48:\n                    progressed = self._promote_active_contenders(\n                        env,\n                        plan,\n                        target_nfe,\n                        desired=1,\n                        step_index=int(plan[\"late_step\"]),\n                        skip_top=2,\n                    )\n                if not progressed and int(plan[\"ambiguous_children\"]) > 0:\n                    progressed = self._refine_top_anchors(\n                        env,\n                        plan,\n                        target_nfe,\n                        child_counts,\n                        max_children=int(plan[\"ambiguous_children\"]),\n                        balanced=True,\n                    )\n            else:\n                if self._should_refine_clear_winner(env, plan):\n                    progressed = self._refine_top_anchors(\n                        env,\n                        plan,\n                        target_nfe,\n                        child_counts,\n                        max_children=int(plan[\"confident_children\"]),\n                        balanced=False,\n                    )\n                if not progressed:\n                    progressed = self._promote_active_contenders(\n                        env,\n                        plan,\n                        target_nfe,\n                        desired=1,\n                        step_index=len(env.time_grid) - 1,\n                    )\n\n            if progressed:\n                continue\n\n            if not self._step_best_active(env, target_nfe):\n                break\n\n    def _low_beta_tail(\n        self,\n        env: FlowTTSEnv,\n        plan: dict[str, float | int | str],\n        target_nfe: int,\n    ) -> None:\n        ranked = self._ranked_latest_previews(env)\n        if not ranked:\n            return\n\n        second = ranked[1] if len(ranked) > 1 else None\n        if self._is_ambiguous(ranked[0], second, plan):\n            self._promote_active_contenders(\n                env,\n                plan,\n                target_nfe,\n                desired=2,\n                step_index=int(plan[\"low_ambiguous_step\"]),\n            )\n            return\n\n        champion_id = ranked[0].particle_id\n        self._advance_particle_to_step(\n            env,\n            champion_id,\n            int(plan[\"low_clear_step\"]),\n            target_nfe,\n        )\n        self._promote_active_contenders(\n            env,\n            plan,\n            target_nfe,\n            desired=1,\n            step_index=int(plan[\"low_clear_runner_step\"]),\n            skip_top=1,\n        )\n\n    def _prune_after_scout(self, env: FlowTTSEnv, keep: int) -> None:\n        state = env.get_state()\n        ranked_ids = self._rank_active_ids_by_latest_preview(state)\n        survivors = set(ranked_ids[: max(1, min(len(ranked_ids), keep))])\n        losers = [\n            particle_id\n            for particle_id in state.active_particle_ids\n            if particle_id not in survivors\n        ]\n        if losers:\n            try:\n                env.prune(losers)\n            except InvalidActionError:\n                pass\n\n    def _prune_trailing_active(self, env: FlowTTSEnv, reserve_count: int, prune_gap: float) -> None:\n        state = env.get_state()\n        ranked = self._rank_active_latest_preview_records(state)\n        if len(ranked) <= reserve_count:\n            return\n        best_score = float(ranked[0].score)\n        to_prune: list[int] = []\n        for preview in ranked[reserve_count:]:\n            if preview.score is None:\n                continue\n            particle = state.particles.get(preview.particle_id)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"I’ve confirmed the current workspace controller is not the same as the recent best snapshot in the injected history. The history also shows `r0002 -> r0003` was a real behavior change at high beta: it cut backward children and spent that budget on extra late forward+preview confirmations, which helped `beta=0.75` but slightly hurt `beta=1.0`."}}
