{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\n\n@dataclass\nclass Particle:\n    id: int\n    time: float\n    status: str = 'active'\n    last_preview_id: int | None = None\n\n@dataclass\nclass Preview:\n    id: int\n    particle_id: int\n    time: float\n    score: float\n    uncertainty: float\n\nclass FakeState:\n    def __init__(self, particles, previews):\n        self.prompt = 'p'\n        self.budget_left = 0\n        self.active_particle_ids = [pid for pid,p in particles.items() if p.status=='active']\n        self.completed_particle_ids = [pid for pid,p in particles.items() if p.status=='completed']\n        self.pruned_particle_ids = [pid for pid,p in particles.items() if p.status=='pruned']\n        self.particles = particles\n        self.previews = previews\n        self.event_log = []\n\nclass FakeEnv:\n    def __init__(self, budget=64, num_steps=10):\n        self.budget = budget\n        self._spent = 0\n        self.time_grid = tuple(i/num_steps for i in range(num_steps+1))\n        self._particles = {}\n        self._previews = {}\n        self._next_pid = 0\n        self._next_aid = 0\n    @property\n    def budget_left(self):\n        return self.budget - self._spent\n    def get_state(self):\n        return FakeState(self._particles.copy(), self._previews.copy())\n    def spawn(self, n):\n        out=[]\n        for _ in range(n):\n            pid=self._next_pid; self._next_pid+=1\n            self._particles[pid]=Particle(id=pid,time=0.0)\n            out.append(pid)\n        return out\n    def _step(self, t):\n        return min(range(len(self.time_grid)), key=lambda i: abs(self.time_grid[i]-t))\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        p=self._particles[particle_id]\n        if p.status\"'!='\"'active':\n            raise InvalidActionError('inactive')\n        cur=self._step(p.time); tgt=self._step(target_time)\n        if tgt<=cur: raise InvalidActionError('non advancing')\n        cost=tgt-cur\n        if self._spent + cost > self.budget: raise BudgetExceededError()\n        self._spent += cost\n        p.time=self.time_grid[tgt]\n        if tgt==len(self.time_grid)-1:\n            p.status='completed'\n        return p\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p=self._particles[particle_id]\n        if p.status=='pruned': raise InvalidActionError('pruned')\n        if self._spent + 1 > self.budget: raise BudgetExceededError()\n        self._spent += 1\n        aid=self._next_aid; self._next_aid+=1\n        base_scores={0:0.52,1:0.49,2:0.51,3:0.55,4:0.50,5:0.48,6:0.53,7:0.47}\n        base=base_scores.get(particle_id, 0.50)\n        score=base + 0.02*p.time - 0.01*((particle_id+aid)%2)\n        uncertainty=max(0.0, 1.0-p.time)\n        pr=Preview(id=aid, particle_id=particle_id, time=p.time, score=score, uncertainty=uncertainty)\n        self._previews[aid]=pr\n        p.last_preview_id=aid\n        return pr\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        if num_children<=0: raise InvalidActionError('bad children')\n        anchor=self._previews[anchor_id]\n        out=[]\n        for _ in range(num_children):\n            pid=self._next_pid; self._next_pid+=1\n            self._particles[pid]=Particle(id=pid, time=target_time, status='active')\n            out.append(pid)\n        return out\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            p=self._particles[pid]\n            if p.status=='completed': raise InvalidActionError('completed')\n            p.status='pruned'\n    def answer(self, rule='best_preview_score'):\n        class Ans:\n            def __init__(self, nfe, rule):\n                self.nfe_used=nfe; self.rule=rule; self.event_log=[]\n        return Ans(self._spent, rule)\n\nfor beta in [0.0,0.25,0.5,0.75,1.0]:\n    env=FakeEnv()\n    ans=OptimalController().solve(env,beta)\n    print(beta, ans.nfe_used)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
