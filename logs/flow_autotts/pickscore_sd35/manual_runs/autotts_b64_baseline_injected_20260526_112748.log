{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' /inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/logs/flow_autotts/pickscore_sd35/history_autotts_b64_baseline_injected_20260526_112748/r0001_20260526_112748_8ce8bc14/flow_autotts/controllers/optimal.py\"","aggregated_output":"\"\"\"Candidate controller for SD3.5 PickScore discovery.\"\"\"\n\nfrom __future__ import annotations\n\nfrom flow_autotts.core.env import FlowTTSEnv\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, PreviewRecord\n\n\nclass OptimalController:\n    \"\"\"Beta-shaped scout/confirm controller with selective backward repair.\"\"\"\n\n    def solve(self, env: FlowTTSEnv, beta: float) -> AnswerRecord:\n        beta = min(max(float(beta), 0.0), 1.0)\n        plan = self._schedule(env, beta)\n        target_nfe = min(int(plan[\"target_nfe\"]), int(env.budget))\n\n        try:\n            root_ids = env.spawn(int(plan[\"root_count\"]))\n            self._scout_roots(env, root_ids, plan, target_nfe)\n            self._confirm_survivors(env, plan, target_nfe)\n            self._refine_from_evidence(env, plan, target_nfe)\n            self._spend_slack(env, plan, target_nfe)\n        except (BudgetExceededError, InvalidActionError):\n            pass\n\n        try:\n            return env.answer(rule=\"best_preview_score\")\n        except (BudgetExceededError, InvalidActionError):\n            return env.answer(rule=\"latest_active\")\n\n    def _schedule(self, env: FlowTTSEnv, beta: float) -> dict[str, float | int | str]:\n        budget = max(0, int(env.budget))\n        steps = max(1, len(env.time_grid) - 1)\n        target_nfe = self._target_nfe(beta, budget)\n\n        if beta <= 0.0:\n            return {\n                \"beta\": beta,\n                \"target_nfe\": target_nfe,\n                \"root_count\": 4,\n                \"scout_step\": 1,\n                \"scout_keep\": 4,\n                \"mid_step\": 2,\n                \"confirm_count\": 2,\n                \"late_step\": steps,\n                \"confirm_margin\": 0.05,\n                \"uncertain_threshold\": 0.85,\n                \"refine_anchor_count\": 0,\n                \"max_children\": 0,\n                \"backtrack_step\": steps,\n                \"noise_policy\": \"inferred_noise\",\n                \"strength\": 0.0,\n                \"prune_margin\": 0.06,\n                \"slack_previews\": 0,\n            }\n\n        if beta <= 0.25:\n            return {\n                \"beta\": beta,\n                \"target_nfe\": target_nfe,\n                \"root_count\": 4,\n                \"scout_step\": 1,\n                \"scout_keep\": 3,\n                \"mid_step\": 3,\n                \"confirm_count\": 2,\n                \"late_step\": steps,\n                \"confirm_margin\": 0.04,\n                \"uncertain_threshold\": 0.78,\n                \"refine_anchor_count\": 0,\n                \"max_children\": 0,\n                \"backtrack_step\": steps - 1,\n                \"noise_policy\": \"inferred_noise\",\n                \"strength\": 0.0,\n                \"prune_margin\": 0.045,\n                \"slack_previews\": 1,\n            }\n\n        if beta <= 0.5:\n            return {\n                \"beta\": beta,\n                \"target_nfe\": target_nfe,\n                \"root_count\": 4,\n                \"scout_step\": 2,\n                \"scout_keep\": 3,\n                \"mid_step\": 5,\n                \"confirm_count\": 3,\n                \"late_step\": steps,\n                \"confirm_margin\": 0.03,\n                \"uncertain_threshold\": 0.55,\n                \"refine_anchor_count\": 2,\n                \"max_children\": 1,\n                \"backtrack_step\": 7 if steps >= 10 else max(steps - 2, 1),\n                \"noise_policy\": \"fresh_noise\",\n                \"strength\": 1.0,\n                \"prune_margin\": 0.03,\n                \"slack_previews\": 2,\n            }\n\n        if beta <= 0.75:\n            return {\n                \"beta\": beta,\n                \"target_nfe\": target_nfe,\n                \"root_count\": 4,\n                \"scout_step\": 2,\n                \"scout_keep\": 3,\n                \"mid_step\": 5,\n                \"confirm_count\": 3,\n                \"late_step\": steps,\n                \"confirm_margin\": 0.025,\n                \"uncertain_threshold\": 0.45,\n                \"refine_anchor_count\": 2,\n                \"max_children\": 2,\n                \"backtrack_step\": 7 if steps >= 10 else max(steps - 2, 1),\n                \"noise_policy\": \"mixed_noise\",\n                \"strength\": 0.45,\n                \"prune_margin\": 0.022,\n                \"slack_previews\": 3,\n            }\n\n        return {\n            \"beta\": beta,\n            \"target_nfe\": target_nfe,\n            \"root_count\": 4,\n            \"scout_step\": 2,\n            \"scout_keep\": 4,\n            \"mid_step\": 6 if steps >= 10 else max(steps - 3, 1),\n            \"confirm_count\": 4,\n            \"late_step\": steps,\n            \"confirm_margin\": 0.02,\n            \"uncertain_threshold\": 0.35,\n            \"refine_anchor_count\": 3,\n            \"max_children\": 2,\n            \"backtrack_step\": 6 if steps >= 10 else max(steps - 4, 1),\n            \"noise_policy\": \"mixed_noise\",\n            \"strength\": 0.35,\n            \"prune_margin\": 0.015,\n            \"slack_previews\": 4,\n        }\n\n    def _target_nfe(self, beta: float, budget: int) -> int:\n        if beta <= 0.0:\n            return min(budget, 10)\n        if beta <= 0.25:\n            return min(budget, 20)\n        if beta <= 0.5:\n            return min(budget, 36)\n        if beta <= 0.75:\n            return min(budget, 48)\n        return min(budget, 64)\n\n    def _scout_roots(\n        self,\n        env: FlowTTSEnv,\n        root_ids: list[int],\n        plan: dict[str, float | int | str],\n        target_nfe: int,\n    ) -> None:\n        scout_time = self._time_at_step(env, int(plan[\"scout_step\"]))\n        previewed: list[int] = []\n        for particle_id in root_ids:\n            if not self._can_afford(env, target_nfe, self._cost_to_reach(env, particle_id, scout_time) + 1):\n                break\n            self._forward_to(env, particle_id, scout_time, solver=\"euler\")\n            env.preview(particle_id, mode=\"clean_anchor\", scorer=\"default\")\n            previewed.append(particle_id)\n\n        if not previewed:\n            return\n\n        ranked = self._rank_particle_ids_by_preview(env, previewed)\n        keep = ranked[: max(1, min(len(ranked), int(plan[\"scout_keep\"])))]\n        losers = [particle_id for particle_id in previewed if particle_id not in keep]\n        if losers:\n            try:\n                env.prune(losers)\n            except InvalidActionError:\n                pass\n\n    def _confirm_survivors(\n        self,\n        env: FlowTTSEnv,\n        plan: dict[str, float | int | str],\n        target_nfe: int,\n    ) -> None:\n        mid_time = self._time_at_step(env, int(plan[\"mid_step\"]))\n        late_time = self._time_at_step(env, int(plan[\"late_step\"]))\n\n        ranked = self._rank_active_by_preview(env)\n        if not ranked:\n            return\n\n        confirm_count = max(1, min(len(ranked), int(plan[\"confirm_count\"])))\n        survivors = ranked[:confirm_count]\n        for particle_id in survivors:\n            if not self._is_active(env, particle_id):\n                continue\n            first_leg = self._cost_to_reach(env, particle_id, mid_time)\n            second_leg = self._cost_from_time(env, mid_time, late_time)\n            if not self._can_afford(env, target_nfe, first_leg + 1):\n                continue\n            self._forward_to(env, particle_id, mid_time, solver=\"euler\")\n            env.preview(particle_id, mode=\"clean_anchor\", scorer=\"default\")\n            if self._should_finish_after_mid(env, particle_id, plan):\n                if self._can_afford(env, target_nfe, second_leg + 1):\n                    self._forward_to(env, particle_id, late_time, solver=\"euler\")\n                    env.preview(particle_id, mode=\"clean_anchor\", scorer=\"default\")\n\n        self._late_prune(env, plan)\n\n    def _refine_from_evidence(\n        self,\n        env: FlowTTSEnv,\n        plan: dict[str, float | int | str],\n        target_nfe: int,\n    ) -> None:\n        max_children = int(plan[\"max_children\"])\n        if max_children <= 0:\n            return\n\n        ranked_previews = self._ranked_previews(env)\n        if not ranked_previews:\n            return\n\n        top_preview = ranked_previews[0]\n        runner_up = ranked_previews[1] if len(ranked_previews) > 1 else None\n        if not self._should_refine(top_preview, runner_up, plan):\n            return\n\n        backtrack_step = int(plan[\"backtrack_step\"])\n        child_time = self._time_at_step(env, backtrack_step)\n        anchor_count = max(1, min(len(ranked_previews), int(plan[\"refine_anchor_count\"])))\n        children_made = 0\n\n        for preview in ranked_previews[:anchor_count]:\n            if children_made >= max_children:\n                break\n            child_cost = self._child_cost(env, child_time, with_mid_preview=bool(float(plan[\"beta\"]) >= 0.75))\n            if not self._can_afford(env, target_nfe, child_cost):\n                break\n            try:\n                child_id = env.backward(\n                    preview.id,\n                    target_time=child_time,\n                    noise_policy=str(plan[\"noise_policy\"]),\n                    num_children=1,\n                    strength=float(plan[\"strength\"]),\n                )[0]\n                if float(plan[\"beta\"]) >= 0.75:\n                    mid_time = self._time_at_step(env, min(len(env.time_grid) - 1, backtrack_step + 2))\n                    if self._can_afford(env, target_nfe, self._cost_to_reach(env, child_id, mid_time) + 1):\n                        self._forward_to(env, child_id, mid_time, solver=\"euler\")\n                        env.preview(child_id, mode=\"clean_anchor\", scorer=\"default\")\n                if self._can_afford(env, target_nfe, self._cost_to_reach(env, child_id, 1.0) + 1):\n                    self._forward_to(env, child_id, 1.0, solver=\"euler\")\n                    env.preview(child_id, mode=\"clean_anchor\", scorer=\"default\")\n                children_made += 1\n            except (BudgetExceededError, InvalidActionError):\n                break\n\n    def _spend_slack(\n        self,\n        env: FlowTTSEnv,\n        plan: dict[str, float | int | str],\n        target_nfe: int,\n    ) -> None:\n        slack_previews = int(plan[\"slack_previews\"])\n        used = 0\n        while used < slack_previews and env.budget_left > 0 and self._spent(env) < target_nfe:\n            ranked = self._rank_active_by_preview(env)\n            progressed = False\n            for particle_id in ranked:\n                if not self._is_active(env, particle_id):\n                    continue\n                next_time = self._next_time(env, particle_id)\n                if next_time is None:\n                    continue\n                if not self._can_afford(env, target_nfe, 2):\n                    return\n                try:\n                    self._forward_to(env, particle_id, next_time, solver=\"euler\")\n                    env.preview(particle_id, mode=\"clean_anchor\", scorer=\"default\")\n                    used += 1\n                    progressed = True\n                    break\n                except (BudgetExceededError, InvalidActionError):\n                    continue\n            if progressed:\n                continue\n\n            confirmations = self._ranked_previews(env)\n            if not confirmations or not self._can_afford(env, target_nfe, 1):\n                return\n            candidate = confirmations[0]\n            particle = env.get_state().particles.get(candidate.particle_id)\n            if particle is None or particle.status == \"pruned\":\n                return\n            try:\n                env.preview(candidate.particle_id, mode=\"clean_anchor\", scorer=\"default\")\n                used += 1\n            except (BudgetExceededError, InvalidActionError):\n                return\n\n    def _late_prune(self, env: FlowTTSEnv, plan: dict[str, float | int | str]) -> None:\n        previews = self._ranked_previews(env)\n        if len(previews) < 2:\n            return\n\n        best_score = float(previews[0].score)\n        margin = float(plan[\"prune_margin\"])\n        to_prune: list[int] = []\n        for preview in previews[1:]:\n            particle = env.get_state().particles.get(preview.particle_id)\n            if particle is None or particle.status != \"active\":\n                continue\n            if preview.score is None:\n                continue\n            if best_score - float(preview.score) >= margin:\n                to_prune.append(preview.particle_id)\n        if to_prune:\n","exit_code":0,"status":"completed"}}
