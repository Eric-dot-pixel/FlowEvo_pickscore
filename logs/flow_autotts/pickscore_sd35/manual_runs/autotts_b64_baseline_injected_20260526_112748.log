{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,320p' flow_autotts/controllers/optimal.py\"","aggregated_output":"\"\"\"Candidate controller for SD3.5 PickScore discovery.\"\"\"\n\nfrom __future__ import annotations\n\nfrom flow_autotts.core.env import FlowTTSEnv\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, PreviewRecord\n\n\nclass OptimalController:\n    \"\"\"Stagewise scout/duel controller with selective local repair.\"\"\"\n\n    def solve(self, env: FlowTTSEnv, beta: float) -> AnswerRecord:\n        beta = min(max(float(beta), 0.0), 1.0)\n        plan = self._schedule(env, beta)\n        target_nfe = min(int(plan[\"target_nfe\"]), int(env.budget))\n\n        try:\n            if str(plan[\"mode\"]) == \"single_track\":\n                self._run_single_track(env, target_nfe, int(plan[\"probe_steps\"]))\n            else:\n                active_ids = list(env.spawn(int(plan[\"root_count\"])))\n                active_ids = self._run_stages(env, active_ids, plan, target_nfe)\n                self._late_policy(env, active_ids, plan, target_nfe)\n        except (BudgetExceededError, InvalidActionError):\n            pass\n\n        try:\n            return env.answer(rule=\"best_preview_score\")\n        except (BudgetExceededError, InvalidActionError):\n            return env.answer(rule=\"latest_active\")\n\n    def _schedule(self, env: FlowTTSEnv, beta: float) -> dict[str, object]:\n        budget = max(0, int(env.budget))\n        steps = max(1, len(env.time_grid) - 1)\n        scout_step = 1 if steps >= 1 else 0\n        mid_step = min(steps, max(3, int(round(0.4 * steps))))\n        late_step = min(steps, max(mid_step + 2, int(round(0.7 * steps))))\n        final_step = steps\n        repair_step = min(steps, max(late_step - 1, mid_step + 1))\n\n        if beta <= 0.0:\n            return {\n                \"mode\": \"single_track\",\n                \"target_nfe\": min(budget, 10),\n                \"probe_steps\": min(5, steps),\n            }\n\n        if beta <= 0.25:\n            return {\n                \"mode\": \"multi_root\",\n                \"target_nfe\": min(budget, 20),\n                \"root_count\": 2,\n                \"stages\": [\n                    {\"step\": scout_step, \"advance\": 2, \"keep\": 2, \"prune_gap\": 0.050},\n                    {\"step\": max(mid_step, scout_step + 2), \"advance\": 2, \"keep\": 1, \"prune_gap\": 0.034},\n                    {\"step\": final_step, \"advance\": 1, \"keep\": 1, \"prune_gap\": 0.000},\n                ],\n                \"min_finalists\": 1,\n                \"late_duel_gap\": 0.018,\n                \"late_uncertainty\": 0.22,\n                \"repair_gap\": 0.0,\n                \"repair_min_time\": self._time_at_step(env, late_step),\n                \"repair_step\": repair_step,\n                \"repair_children\": 0,\n                \"repair_policy\": \"fresh_noise\",\n                \"repair_strength\": 1.0,\n                \"duel_step\": final_step,\n                \"duel_limit\": 0,\n            }\n\n        if beta <= 0.5:\n            return {\n                \"mode\": \"multi_root\",\n                \"target_nfe\": min(budget, 36),\n                \"root_count\": 3,\n                \"stages\": [\n                    {\"step\": scout_step, \"advance\": 3, \"keep\": 3, \"prune_gap\": 0.032},\n                    {\"step\": mid_step, \"advance\": 3, \"keep\": 2, \"prune_gap\": 0.024},\n                    {\"step\": late_step, \"advance\": 2, \"keep\": 2, \"prune_gap\": 0.016},\n                    {\"step\": final_step, \"advance\": 2, \"keep\": 2, \"prune_gap\": 0.000},\n                ],\n                \"min_finalists\": 2,\n                \"late_duel_gap\": 0.016,\n                \"late_uncertainty\": 0.19,\n                \"repair_gap\": 0.010,\n                \"repair_min_time\": self._time_at_step(env, late_step),\n                \"repair_step\": repair_step,\n                \"repair_children\": 0,\n                \"repair_policy\": \"fresh_noise\",\n                \"repair_strength\": 1.0,\n                \"duel_step\": final_step,\n                \"duel_limit\": 2,\n            }\n\n        if beta <= 0.75:\n            return {\n                \"mode\": \"multi_root\",\n                \"target_nfe\": min(budget, 48),\n                \"root_count\": 4,\n                \"stages\": [\n                    {\"step\": scout_step, \"advance\": 4, \"keep\": 4, \"prune_gap\": 0.018},\n                    {\"step\": mid_step, \"advance\": 4, \"keep\": 3, \"prune_gap\": 0.015},\n                    {\"step\": late_step, \"advance\": 3, \"keep\": 2, \"prune_gap\": 0.012},\n                    {\"step\": final_step, \"advance\": 2, \"keep\": 2, \"prune_gap\": 0.000},\n                ],\n                \"min_finalists\": 2,\n                \"late_duel_gap\": 0.013,\n                \"late_uncertainty\": 0.16,\n                \"repair_gap\": 0.014,\n                \"repair_min_time\": self._time_at_step(env, late_step),\n                \"repair_step\": repair_step,\n                \"repair_children\": 1,\n                \"repair_policy\": \"mixed_noise\",\n                \"repair_strength\": 0.45,\n                \"duel_step\": final_step,\n                \"duel_limit\": 2,\n            }\n\n        return {\n            \"mode\": \"multi_root\",\n            \"target_nfe\": min(budget, 64),\n            \"root_count\": 4,\n            \"stages\": [\n                {\"step\": scout_step, \"advance\": 4, \"keep\": 4, \"prune_gap\": 0.000},\n                {\"step\": mid_step, \"advance\": 4, \"keep\": 4, \"prune_gap\": 0.010},\n                {\"step\": late_step, \"advance\": 4, \"keep\": 3, \"prune_gap\": 0.010},\n                {\"step\": final_step, \"advance\": 3, \"keep\": 3, \"prune_gap\": 0.000},\n            ],\n            \"min_finalists\": 3,\n            \"late_duel_gap\": 0.011,\n            \"late_uncertainty\": 0.15,\n            \"repair_gap\": 0.016,\n            \"repair_min_time\": self._time_at_step(env, late_step),\n            \"repair_step\": repair_step,\n            \"repair_children\": 2,\n            \"repair_policy\": \"mixed_noise\",\n            \"repair_strength\": 0.35,\n            \"duel_step\": final_step,\n            \"duel_limit\": 2,\n        }\n\n    def _run_single_track(self, env: FlowTTSEnv, target_nfe: int, probe_steps: int) -> None:\n        particle_id = env.spawn(1)[0]\n        for step_index in range(1, probe_steps + 1):\n            self._advance_and_preview(env, particle_id, step_index, target_nfe)\n\n    def _run_stages(\n        self,\n        env: FlowTTSEnv,\n        active_ids: list[int],\n        plan: dict[str, object],\n        target_nfe: int,\n    ) -> list[int]:\n        for stage in list(plan[\"stages\"]):\n            ranked = self._rank_particle_ids(env, active_ids)\n            selected = ranked[: max(0, min(len(ranked), int(stage[\"advance\"])))]\n            for particle_id in selected:\n                self._advance_and_preview(env, particle_id, int(stage[\"step\"]), target_nfe)\n            active_ids = self._prune_after_stage(\n                env,\n                active_ids,\n                keep_count=int(stage[\"keep\"]),\n                prune_gap=float(stage[\"prune_gap\"]),\n                preserve=int(plan[\"min_finalists\"]),\n            )\n        return active_ids\n\n    def _late_policy(\n        self,\n        env: FlowTTSEnv,\n        active_ids: list[int],\n        plan: dict[str, object],\n        target_nfe: int,\n    ) -> None:\n        duel_ids = self._ensure_late_duel(env, active_ids, plan, target_nfe)\n        if int(plan[\"repair_children\"]) > 0:\n            self._run_local_repair(env, duel_ids, plan, target_nfe)\n        self._final_confirmation(env, duel_ids, plan, target_nfe)\n\n    def _ensure_late_duel(\n        self,\n        env: FlowTTSEnv,\n        active_ids: list[int],\n        plan: dict[str, object],\n        target_nfe: int,\n    ) -> list[int]:\n        limit = int(plan[\"duel_limit\"])\n        if limit <= 0:\n            return self._available_particle_ids(env, active_ids)\n\n        ranked = self._rank_particle_ids(env, active_ids)\n        duel_ids = ranked[: max(0, min(len(ranked), limit))]\n        if not duel_ids:\n            return []\n\n        step_index = int(plan[\"duel_step\"])\n        best, runner = self._best_two_previews(env, duel_ids)\n        must_confirm_runner = self._is_ambiguous(best, runner, plan)\n\n        champion = duel_ids[0]\n        self._advance_and_preview_if_possible(env, champion, step_index, target_nfe)\n\n        if must_confirm_runner and len(duel_ids) > 1:\n            self._advance_and_preview_if_possible(env, duel_ids[1], step_index, target_nfe)\n\n        return self._available_particle_ids(env, duel_ids)\n\n    def _run_local_repair(\n        self,\n        env: FlowTTSEnv,\n        active_ids: list[int],\n        plan: dict[str, object],\n        target_nfe: int,\n    ) -> None:\n        ranked = self._rank_latest_previews(env, active_ids)\n        if not ranked:\n            return\n\n        repair_step = int(plan[\"repair_step\"])\n        child_cost = self._child_finish_preview_cost(env, repair_step)\n        for anchor in self._repair_candidates(ranked, plan)[: int(plan[\"repair_children\"])]:\n            self._require_budget(env, target_nfe, child_cost)\n            child_id = env.backward(\n                anchor.id,\n                target_time=self._time_at_step(env, repair_step),\n                noise_policy=str(plan[\"repair_policy\"]),\n                num_children=1,\n                strength=float(plan[\"repair_strength\"]),\n            )[0]\n            self._advance_and_preview(env, child_id, len(env.time_grid) - 1, target_nfe)\n\n    def _final_confirmation(\n        self,\n        env: FlowTTSEnv,\n        active_ids: list[int],\n        plan: dict[str, object],\n        target_nfe: int,\n    ) -> None:\n        ranked = self._rank_particle_ids(env, active_ids)\n        if not ranked:\n            return\n\n        top_preview = self._latest_preview(env, ranked[0])\n        if top_preview is not None and top_preview.time >= 1.0:\n            return\n\n        self._advance_and_preview_if_possible(env, ranked[0], len(env.time_grid) - 1, target_nfe)\n\n    def _repair_candidates(\n        self,\n        ranked: list[PreviewRecord],\n        plan: dict[str, object],\n    ) -> list[PreviewRecord]:\n        late = [\n            preview\n            for preview in ranked\n            if float(preview.time) >= float(plan[\"repair_min_time\"])\n        ]\n        if not late:\n            return []\n\n        best = late[0]\n        runner = late[1] if len(late) > 1 else None\n        chosen: list[PreviewRecord] = []\n        if runner is None:\n            if float(best.uncertainty or 0.0) >= float(plan[\"late_uncertainty\"]) + 0.03:\n                chosen.append(best)\n            return chosen\n\n        gap = self._score_gap(best, runner)\n        if gap <= float(plan[\"repair_gap\"]):\n            if float(runner.uncertainty or 0.0) >= float(best.uncertainty or 0.0) - 0.01:\n                chosen.extend([runner, best])\n            else:\n                chosen.extend([best, runner])\n        elif float(best.uncertainty or 0.0) >= float(plan[\"late_uncertainty\"]) + 0.04:\n            chosen.append(best)\n\n        for preview in late[2:]:\n            if len(chosen) >= int(plan[\"repair_children\"]):\n                break\n            if float(preview.uncertainty or 0.0) >= float(plan[\"late_uncertainty\"]) + 0.02:\n                chosen.append(preview)\n\n        unique: list[PreviewRecord] = []\n        seen: set[int] = set()\n        for preview in chosen:\n            if preview.id in seen:\n                continue\n            seen.add(preview.id)\n            unique.append(preview)\n        return unique\n\n    def _is_ambiguous(\n        self,\n        best: PreviewRecord | None,\n        runner: PreviewRecord | None,\n        plan: dict[str, object],\n    ) -> bool:\n        if best is None:\n            return False\n        if runner is None:\n            return float(best.uncertainty or 0.0) >= float(plan[\"late_uncertainty\"]) + 0.05\n\n        gap = self._score_gap(best, runner)\n        if gap <= float(plan[\"late_duel_gap\"]):\n            return True\n        return max(float(best.uncertainty or 0.0), float(runner.uncertainty or 0.0)) >= float(plan[\"late_uncertainty\"])\n\n    def _prune_after_stage(\n        self,\n        env: FlowTTSEnv,\n        particle_ids: list[int],\n        keep_count: int,\n        prune_gap: float,\n        preserve: int,\n    ) -> list[int]:\n        state = env.get_state()\n        active = [\n","exit_code":0,"status":"completed"}}
