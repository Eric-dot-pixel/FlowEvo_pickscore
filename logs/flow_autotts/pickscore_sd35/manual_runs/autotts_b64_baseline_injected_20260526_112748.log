{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.env import FlowTTSEnv\n\nclass DummyModel:\n    def velocity(self, z, time, prompt):\n        return [0.1 for _ in z]\n\nclass DummyScorer:\n    def score(self, image, prompt):\n        val = float(sum(image))\n        return val, {\\\"score\\\": val}\n\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FlowTTSEnv(\n        model=DummyModel(),\n        vae=None,\n        scorer=DummyScorer(),\n        prompt=\\\"p\\\",\n        budget=64,\n        time_grid=[i/10 for i in range(11)],\n        seed=0,\n        latent_shape=(4,),\n    )\n    ans = OptimalController().solve(env, beta)\n    print(beta, ans.nfe_used, ans.rule, len(ans.event_log))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
