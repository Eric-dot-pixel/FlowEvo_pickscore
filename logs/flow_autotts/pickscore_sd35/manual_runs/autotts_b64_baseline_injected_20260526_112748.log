{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass, field\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, ParticleSummary, PreviewRecord, EventRecord\n\n@dataclass\nclass _P:\n    id: int\n    time: float = 0.0\n    status: str = 'active'\n    last_preview_id: int | None = None\n\nclass FakeEnv:\n    def __init__(self, budget=64, steps=10):\n        self.time_grid = tuple(i / steps for i in range(steps + 1))\n        self.budget = budget\n        self._nfe = 0\n        self._next_pid = 0\n        self._next_aid = 0\n        self.particles = {}\n        self.previews = {}\n        self.events = []\n        self.answered = False\n    @property\n    def budget_left(self):\n        return self.budget - self._nfe\n    def spawn(self, n):\n        ids = []\n        for _ in range(n):\n            pid = self._next_pid\n            self._next_pid += 1\n            self.particles[pid] = _P(pid)\n            ids.append(pid)\n        return ids\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        if solver not in {'euler', 'sde'}:\n            raise InvalidActionError('bad solver')\n        p = self.particles[particle_id]\n        if p.status \"'!= '\"'active':\n            raise InvalidActionError('not active')\n        target_step = min(range(len(self.time_grid)), key=lambda i: abs(self.time_grid[i] - target_time))\n        current_step = min(range(len(self.time_grid)), key=lambda i: abs(self.time_grid[i] - p.time))\n        if target_step <= current_step:\n            raise InvalidActionError('must advance')\n        cost = target_step - current_step\n        if self._nfe + cost > self.budget:\n            raise BudgetExceededError\n        self._nfe += cost\n        p.time = self.time_grid[target_step]\n        if target_step == len(self.time_grid) - 1:\n            p.status = 'completed'\n        return self.get_state().particles[particle_id]\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p = self.particles[particle_id]\n        if p.status == 'pruned':\n            raise InvalidActionError('pruned')\n        if self._nfe + 1 > self.budget:\n            raise BudgetExceededError\n        self._nfe += 1\n        aid = self._next_aid\n        self._next_aid += 1\n        score = 0.50 + 0.03 * particle_id + 0.02 * p.time\n        uncertainty = max(0.0, 0.25 - 0.02 * p.time)\n        self.previews[aid] = PreviewRecord(id=aid, particle_id=particle_id, time=p.time, score=score, uncertainty=uncertainty)\n        p.last_preview_id = aid\n        return self.previews[aid]\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        if mask is not None:\n            raise InvalidActionError('mask unsupported')\n        parent = self.previews[anchor_id].particle_id\n        ids = []\n        for _ in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            self.particles[pid] = _P(pid, time=target_time, status='active')\n            ids.append(pid)\n        return ids\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            if self.particles[pid].status == 'completed':\n                raise InvalidActionError('cannot prune completed')\n            self.particles[pid].status = 'pruned'\n    def answer(self, rule='best_preview_score'):\n        self.answered = True\n        best = None\n        if self.previews:\n            best = max(self.previews.values(), key=lambda p: p.score)\n        elif self.particles:\n            pid = max(self.particles, key=lambda pid: (self.particles[pid].time, pid))\n            best = PreviewRecord(id=-1, particle_id=pid, time=self.particles[pid].time, score=None)\n        return AnswerRecord(particle_id=None if best is None else best.particle_id, preview_id=None if best is None else best.id, latent=(), reward=None if best is None else best.score, nfe_used=self._nfe, rule=rule, event_log=[])\n    def get_state(self):\n        return ControllerState(prompt='x', budget_left=self.budget_left, active_particle_ids=[pid for pid,p in self.particles.items() if p.status=='active'], completed_particle_ids=[pid for pid,p in self.particles.items() if p.status=='completed'], pruned_particle_ids=[pid for pid,p in self.particles.items() if p.status=='pruned'], particles={pid: ParticleSummary(id=pid, time=p.time, parent_id=None, source_anchor_id=None, nfe_used=0, status=p.status, last_preview_id=p.last_preview_id, num_children=0) for pid,p in self.particles.items()}, previews=dict(self.previews), event_log=[])\n\ncontroller = OptimalController()\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FakeEnv()\n    ans = controller.solve(env, beta)\n    print(beta, env.budget - env.budget_left, ans.rule, ans.preview_id)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
