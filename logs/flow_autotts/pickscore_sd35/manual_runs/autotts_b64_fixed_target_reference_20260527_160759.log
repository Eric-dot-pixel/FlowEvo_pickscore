.particles[particle_id]\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p=self.particles[particle_id]\n        if p.status=='pruned':\n            raise InvalidActionError\n        self._charge(1)\n        aid=self._next_aid; self._next_aid += 1\n        score = 0.4 + 0.5 * p.time + 0.03 * ((particle_id % 3) - 1) - 0.02 * p.num_children\n        uncertainty = max(0.0, 1.0 - p.time)\n        drift = max(0.0, 0.8 - 0.5 * p.time)\n        rec=PreviewRecord(id=aid, particle_id=particle_id, time=p.time, score=score, uncertainty=uncertainty, drift=drift)\n        self.previews[aid]=rec\n        p.last_preview_id = aid\n        p.nfe_used += 1\n        return rec\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        if num_children <= 0:\n            raise InvalidActionError\n        anchor=self.previews[anchor_id]\n        parent=self.particles[anchor.particle_id]\n        ids=[]\n        for _ in range(num_children):\n            pid=self._next_pid; self._next_pid += 1\n            self.particles[pid]=_Particle(id=pid, time=target_time, parent_id=parent.id, source_anchor_id=anchor_id)\n            ids.append(pid)\n        parent.num_children += num_children\n        return ids\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            p=self.particles[pid]\n            if p.status == 'completed':\n                raise InvalidActionError\n            p.status='pruned'\n    def answer(self, rule='best_preview_score'):\n        if rule == 'best_preview_score' and self.previews:\n            best=max(self.previews.values(), key=lambda x: x.score)\n            return AnswerRecord(best.particle_id, best.id, (), best.score, self._used, rule, [])\n        active=[p for p in self.particles.values() if p.status in {'active','completed'}]\n        if not active:\n            return AnswerRecord(None, None, (), None, self._used, rule, [])\n        chosen=max(active, key=lambda p:(p.time,p.id))\n        if chosen.status=='active':\n            self.forward(chosen.id, 1.0)\n            chosen=self.particles[chosen.id]\n        reward=0.4 + 0.5 * chosen.time + 0.03 * ((chosen.id % 3) - 1)\n        return AnswerRecord(chosen.id, chosen.last_preview_id, (), reward, self._used, rule, [])\n    def get_state(self):\n        active=[]; completed=[]; pruned=[]\n        parts={}\n        for pid,p in self.particles.items():\n            if p.status=='active': active.append(pid)\n            elif p.status=='completed': completed.append(pid)\n            else: pruned.append(pid)\n            parts[pid]=ParticleSummary(pid,p.time,p.parent_id,p.source_anchor_id,p.nfe_used,p.status,p.last_preview_id,p.num_children)\n        return ControllerState(prompt='x', budget_left=self.budget_left, active_particle_ids=active, completed_particle_ids=completed, pruned_particle_ids=pruned, particles=parts, previews=dict(self.previews), event_log=[])\n\ncontroller = OptimalController()\nfor beta in (0.0, 0.25, 0.5, 0.75, 1.0):\n    env = FakeEnv(64)\n    ans = controller.solve(env, beta)\n    print(beta, ans.nfe_used, ans.rule, ans.reward, len(env.particles), len(env.previews))\nPY\"","aggregated_output":"0.0 6 best_preview_score 0.62 2 1\n0.25 18 best_preview_score 0.68 4 3\n0.5 36 best_preview_score 0.8300000000000001 5 8\n0.75 48 best_preview_score 0.8300000000000001 6 12\n1.0 64 best_preview_score 0.93 7 18\n","exit_code":0,"status":"completed"}}
