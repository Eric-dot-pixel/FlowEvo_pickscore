: 18.0,\n            \"prune\": 2.0,\n            \"spawn\": 1.0\n          },\n          \"behavior_summary\": \"single-root preview (spawn=1.00, preview=18.00, prune=2.00, nfe=64.00)\",\n          \"beta\": 1.0,\n          \"nfe\": 64,\n          \"reward\": 0.8445690048933029,\n          \"reward_per_nfe\": 0.013196390701457858\n        }\n      ],\n      \"round_id\": 0\n    }\n  ],\n  \"sample_seed\": 42,\n  \"sample_size\": 500,\n  \"shard_index\": null\n}\n```\n\n","exit_code":0,"status":"completed"}}
