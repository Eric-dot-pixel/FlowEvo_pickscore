{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"nl -ba flow_autotts/controllers/optimal.py | sed -n '1,260p'\"","aggregated_output":"     1\t\"\"\"Candidate controller for SD3.5 PickScore discovery.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\tfrom flow_autotts.core.env import FlowTTSEnv\n     6\tfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\n     7\tfrom flow_autotts.core.state import AnswerRecord, PreviewRecord\n     8\t\n     9\t\n    10\tclass OptimalController:\n    11\t    \"\"\"Beta-scheduled staged search with reserved late tie-breaking.\"\"\"\n    12\t\n    13\t    def solve(self, env: FlowTTSEnv, beta: float) -> AnswerRecord:\n    14\t        beta = min(max(float(beta), 0.0), 1.0)\n    15\t        schedule = self._schedule(beta, int(env.budget))\n    16\t        initial_budget = int(env.budget_left)\n    17\t\n    18\t        if bool(schedule[\"single_root\"]):\n    19\t            return self._single_root_preview(env, schedule)\n    20\t\n    21\t        try:\n    22\t            root_ids = env.spawn(int(schedule[\"roots\"]))\n    23\t        except InvalidActionError:\n    24\t            return self._safe_answer(env)\n    25\t\n    26\t        scout_ids: list[int] = []\n    27\t        for index, particle_id in enumerate(root_ids):\n    28\t            scout_cost = self._segment_cost(env, particle_id, float(schedule[\"scout_time\"])) + 1\n    29\t            if not self._can_spend(env, initial_budget, schedule, scout_cost):\n    30\t                break\n    31\t            solver = \"sde\" if index < int(schedule[\"sde_scouts\"]) else \"euler\"\n    32\t            cfg = self._sde_cfg(schedule) if solver == \"sde\" else None\n    33\t            try:\n    34\t                self._forward_to(env, particle_id, float(schedule[\"scout_time\"]), solver=solver, cfg=cfg)\n    35\t                self._preview(env, particle_id)\n    36\t                scout_ids.append(particle_id)\n    37\t            except (BudgetExceededError, InvalidActionError):\n    38\t                break\n    39\t\n    40\t        if not scout_ids:\n    41\t            return self._finish_one(env, root_ids[0] if root_ids else None)\n    42\t\n    43\t        scout_survivors = self._adaptive_keep(\n    44\t            env,\n    45\t            scout_ids,\n    46\t            int(schedule[\"keep_after_scout\"]),\n    47\t            float(schedule[\"scout_margin\"]),\n    48\t        )\n    49\t        self._prune_non_survivors(env, root_ids, scout_survivors)\n    50\t\n    51\t        try:\n    52\t            finalists = self._commit_stage(env, scout_survivors, schedule, initial_budget)\n    53\t            self._rival_stage(env, finalists, schedule, initial_budget)\n    54\t            finalists = self._repair_stage(env, finalists, schedule, initial_budget)\n    55\t            self._tail_stage(env, finalists, schedule, initial_budget)\n    56\t            self._late_confirmation_stage(env, finalists, schedule, initial_budget)\n    57\t            self._fill_target(env, finalists, schedule, initial_budget)\n    58\t        except BudgetExceededError:\n    59\t            return self._safe_answer(env)\n    60\t\n    61\t        return self._safe_answer(env)\n    62\t\n    63\t    def _schedule(self, beta: float, budget: int) -> dict[str, float | int | bool | str]:\n    64\t        target_nfe = self._target_nfe(budget, beta)\n    65\t        if beta <= 0.0:\n    66\t            return {\n    67\t                \"target_nfe\": target_nfe,\n    68\t                \"single_root\": True,\n    69\t                \"preview_goal\": 3,\n    70\t                \"single_root_fill\": False,\n    71\t            }\n    72\t        if beta <= 0.25:\n    73\t            return {\n    74\t                \"target_nfe\": target_nfe,\n    75\t                \"single_root\": True,\n    76\t                \"preview_goal\": 7,\n    77\t                \"single_root_fill\": False,\n    78\t            }\n    79\t        if beta <= 0.5:\n    80\t            return {\n    81\t                \"target_nfe\": target_nfe,\n    82\t                \"single_root\": False,\n    83\t                \"roots\": 4,\n    84\t                \"sde_scouts\": 0,\n    85\t                \"sde_noise_scale\": 0.0,\n    86\t                \"scout_time\": 0.3,\n    87\t                \"commit_time\": 0.7,\n    88\t                \"rival_time\": 0.9,\n    89\t                \"repair_time\": 0.7,\n    90\t                \"repair_eval_time\": 0.9,\n    91\t                \"keep_after_scout\": 2,\n    92\t                \"keep_after_commit\": 2,\n    93\t                \"scout_margin\": 0.036,\n    94\t                \"commit_margin\": 0.030,\n    95\t                \"rival_gap\": 0.024,\n    96\t                \"repair_gap\": 0.010,\n    97\t                \"uncertainty_gate\": 0.18,\n    98\t                \"max_rival_rounds\": 1,\n    99\t                \"max_repair_anchors\": 1,\n   100\t                \"children_per_anchor\": 1,\n   101\t                \"noise_policy\": \"fresh_noise\",\n   102\t                \"strength\": 1.0,\n   103\t                \"tail_top_time\": 1.0,\n   104\t                \"tail_rival_time\": 1.0,\n   105\t                \"tail_rival_gap\": 0.014,\n   106\t                \"late_confirmation_rounds\": 0,\n   107\t                \"late_confirmation_gap\": 0.012,\n   108\t                \"late_confirmation_uncertainty\": 0.14,\n   109\t                \"late_confirmation_margin\": 0.010,\n   110\t                \"fill_confirmation_cap\": 1,\n   111\t                \"fill_gap\": 0.016,\n   112\t                \"fill_uncertainty_gate\": 0.14,\n   113\t                \"late_repair_children\": 0,\n   114\t                \"late_repair_time\": 0.9,\n   115\t                \"late_repair_eval_time\": 1.0,\n   116\t                \"reserve_nfe\": 0,\n   117\t                \"stop_gap\": 0.020,\n   118\t                \"stop_spend_floor\": 35,\n   119\t            }\n   120\t        if beta <= 0.75:\n   121\t            return {\n   122\t                \"target_nfe\": target_nfe,\n   123\t                \"single_root\": False,\n   124\t                \"roots\": 5,\n   125\t                \"sde_scouts\": 1,\n   126\t                \"sde_noise_scale\": 0.010,\n   127\t                \"scout_time\": 0.3,\n   128\t                \"commit_time\": 0.7,\n   129\t                \"rival_time\": 0.9,\n   130\t                \"repair_time\": 0.7,\n   131\t                \"repair_eval_time\": 0.9,\n   132\t                \"keep_after_scout\": 3,\n   133\t                \"keep_after_commit\": 3,\n   134\t                \"scout_margin\": 0.032,\n   135\t                \"commit_margin\": 0.026,\n   136\t                \"rival_gap\": 0.020,\n   137\t                \"repair_gap\": 0.010,\n   138\t                \"uncertainty_gate\": 0.17,\n   139\t                \"max_rival_rounds\": 2,\n   140\t                \"max_repair_anchors\": 1,\n   141\t                \"children_per_anchor\": 1,\n   142\t                \"noise_policy\": \"fresh_noise\",\n   143\t                \"strength\": 0.85,\n   144\t                \"tail_top_time\": 1.0,\n   145\t                \"tail_rival_time\": 1.0,\n   146\t                \"tail_rival_gap\": 0.011,\n   147\t                \"late_confirmation_rounds\": 1,\n   148\t                \"late_confirmation_gap\": 0.015,\n   149\t                \"late_confirmation_uncertainty\": 0.135,\n   150\t                \"late_confirmation_margin\": 0.010,\n   151\t                \"fill_confirmation_cap\": 2,\n   152\t                \"fill_gap\": 0.014,\n   153\t                \"fill_uncertainty_gate\": 0.13,\n   154\t                \"late_repair_children\": 0,\n   155\t                \"late_repair_time\": 0.9,\n   156\t                \"late_repair_eval_time\": 1.0,\n   157\t                \"reserve_nfe\": 4,\n   158\t                \"stop_gap\": 0.017,\n   159\t                \"stop_spend_floor\": 46,\n   160\t            }\n   161\t        return {\n   162\t            \"target_nfe\": min(target_nfe, 64),\n   163\t            \"single_root\": False,\n   164\t            \"roots\": 6,\n   165\t            \"sde_scouts\": 1,\n   166\t            \"sde_noise_scale\": 0.008,\n   167\t            \"scout_time\": 0.3,\n   168\t            \"commit_time\": 0.7,\n   169\t            \"rival_time\": 0.9,\n   170\t            \"repair_time\": 0.7,\n   171\t            \"repair_eval_time\": 0.9,\n   172\t            \"keep_after_scout\": 4,\n   173\t            \"keep_after_commit\": 4,\n   174\t            \"scout_margin\": 0.028,\n   175\t            \"commit_margin\": 0.023,\n   176\t            \"rival_gap\": 0.017,\n   177\t            \"repair_gap\": 0.009,\n   178\t            \"uncertainty_gate\": 0.16,\n   179\t            \"max_rival_rounds\": 2,\n   180\t            \"max_repair_anchors\": 1,\n   181\t            \"children_per_anchor\": 1,\n   182\t            \"noise_policy\": \"mixed_noise\",\n   183\t            \"strength\": 0.72,\n   184\t            \"tail_top_time\": 1.0,\n   185\t            \"tail_rival_time\": 1.0,\n   186\t            \"tail_rival_gap\": 0.010,\n   187\t            \"late_confirmation_rounds\": 2,\n   188\t            \"late_confirmation_gap\": 0.014,\n   189\t            \"late_confirmation_uncertainty\": 0.13,\n   190\t            \"late_confirmation_margin\": 0.010,\n   191\t            \"fill_confirmation_cap\": 2,\n   192\t            \"fill_gap\": 0.013,\n   193\t            \"fill_uncertainty_gate\": 0.125,\n   194\t            \"late_repair_children\": 1,\n   195\t            \"late_repair_time\": 0.9,\n   196\t            \"late_repair_eval_time\": 1.0,\n   197\t            \"reserve_nfe\": 6,\n   198\t            \"stop_gap\": 0.015,\n   199\t            \"stop_spend_floor\": 61,\n   200\t        }\n   201\t\n   202\t    def _target_nfe(self, budget: int, beta: float) -> int:\n   203\t        budget = max(0, int(budget))\n   204\t        if beta <= 0.0:\n   205\t            return min(budget, 10)\n   206\t        if beta <= 0.25:\n   207\t            return min(budget, 20)\n   208\t        if beta <= 0.5:\n   209\t            return min(budget, 36)\n   210\t        if beta <= 0.75:\n   211\t            return min(budget, 48)\n   212\t        return min(budget, 64)\n   213\t\n   214\t    def _single_root_preview(\n   215\t        self,\n   216\t        env: FlowTTSEnv,\n   217\t        schedule: dict[str, float | int | bool | str],\n   218\t    ) -> AnswerRecord:\n   219\t        try:\n   220\t            root_id = env.spawn(1)[0]\n   221\t        except InvalidActionError:\n   222\t            return self._safe_answer(env)\n   223\t\n   224\t        try:\n   225\t            target_nfe = int(schedule[\"target_nfe\"])\n   226\t            preview_goal = max(1, int(schedule[\"preview_goal\"]))\n   227\t            max_steps = max(0, len(env.time_grid) - 1)\n   228\t            forward_steps = min(max_steps, max(1, target_nfe - preview_goal))\n   229\t            preview_count = max(1, target_nfe - forward_steps)\n   230\t            preview_steps = self._spread_preview_steps(forward_steps, preview_count)\n   231\t\n   232\t            for step_index in range(1, forward_steps + 1):\n   233\t                self._forward_to(env, root_id, float(env.time_grid[step_index]), solver=\"euler\")\n   234\t                if step_index in preview_steps:\n   235\t                    self._preview(env, root_id)\n   236\t\n   237\t            while env.nfe_used < target_nfe and env.budget_left > 0 and self._can_repeat_preview(env, root_id):\n   238\t                self._preview(env, root_id)\n   239\t        except (BudgetExceededError, InvalidActionError):\n   240\t            return self._safe_answer(env)\n   241\t\n   242\t        return self._safe_answer(env)\n   243\t\n   244\t    def _spread_preview_steps(self, forward_steps: int, preview_count: int) -> set[int]:\n   245\t        if forward_steps <= 0 or preview_count <= 0:\n   246\t            return set()\n   247\t        return {\n   248\t            max(1, min(forward_steps, int(round(index * forward_steps / preview_count))))\n   249\t            for index in range(1, preview_count + 1)\n   250\t        }\n   251\t\n   252\t    def _commit_stage(\n   253\t        self,\n   254\t        env: FlowTTSEnv,\n   255\t        particle_ids: list[int],\n   256\t        schedule: dict[str, float | int | bool | str],\n   257\t        initial_budget: int,\n   258\t    ) -> list[int]:\n   259\t        ranked = self._rank_particle_ids(env, particle_ids)\n   260\t        committed: list[int] = []\n","exit_code":0,"status":"completed"}}
