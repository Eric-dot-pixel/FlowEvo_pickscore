{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"sed -n '700,714p' flow_autotts/experiments/pickscore_sd35/env.py\"","aggregated_output":"\n    def _sigma(self, step_index: int) -> Any:\n        clamped = min(max(int(step_index), 0), self.config.num_steps)\n        return self.resources.sigmas[clamped].to(device=self.resources.device, dtype=self.resources.torch.float32)\n\n    def _time_to_step(self, target_time: float) -> int:\n        time = min(max(float(target_time), 0.0), 1.0)\n        return min(self.config.num_steps, max(0, math.ceil(time * self.config.num_steps - 1e-9)))\n\n    def _time_to_step_floor(self, target_time: float) -> int:\n        time = min(max(float(target_time), 0.0), 1.0)\n        return min(self.config.num_steps, max(0, math.floor(time * self.config.num_steps + 1e-9)))\n\n    def _step_to_time(self, step_index: int) -> float:\n        return float(step_index) / float(self.config.num_steps)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass\nfrom math import ceil\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\n\n@dataclass\nclass Particle:\n    id:int\n    step:int\n    status:str='active'\n    last_preview_id:int|None=None\n    @property\n    def time(self):\n        return self.step/10\n\n@dataclass\nclass Preview:\n    id:int\n    particle_id:int\n    time:float\n    score:float|None\n    uncertainty:float|None\n\n@dataclass\nclass State:\n    particles:dict\n    previews:dict\n\nclass FakeSDEnv:\n    def __init__(self,budget=64):\n        self.time_grid=tuple(i/10 for i in range(11))\n        self.budget=budget\n        self._nfe=0\n        self._next_pid=0\n        self._next_aid=0\n        self.particles={}\n        self.previews={}\n    @property\n    def budget_left(self):\n        return self.budget-self._nfe\n    def _time_to_step(self,t):\n        return min(10, max(0, ceil(float(t)*10 - 1e-9)))\n    def spawn(self,n):\n        ids=[]\n        for _ in range(n):\n            pid=self._next_pid; self._next_pid+=1\n            self.particles[pid]=Particle(pid,0)\n            ids.append(pid)\n        return ids\n    def forward(self,pid,target_time,solver='euler',cfg=None):\n        p=self.particles[pid]\n        target=self._time_to_step(target_time)\n        if p.status\"'!='\"'active' or target<=p.step: raise InvalidActionError()\n        cost=target-p.step\n        if self._nfe+cost>self.budget: raise BudgetExceededError()\n        self._nfe+=cost\n        p.step=target\n        if p.step>=10: p.status='completed'\n        return p\n    def preview(self,pid,mode='clean_anchor',scorer='default'):\n        p=self.particles[pid]\n        if self._nfe+1>self.budget: raise BudgetExceededError()\n        self._nfe+=1\n        aid=self._next_aid; self._next_aid+=1\n        score=0.72 + 0.015*p.step - 0.005*(pid%2)\n        unc=max(0.0,1.0-p.time)\n        prev=Preview(aid,pid,p.time,score,unc)\n        self.previews[aid]=prev\n        p.last_preview_id=aid\n        return prev\n    def backward(self,anchor_id,target_time,noise_policy='fresh_noise',num_children=1,mask=None,strength=1.0):\n        if anchor_id not in self.previews: raise InvalidActionError()\n        ids=[]\n        target=self._time_to_step(target_time)\n        for _ in range(num_children):\n            pid=self._next_pid; self._next_pid+=1\n            self.particles[pid]=Particle(pid,target)\n            ids.append(pid)\n        return ids\n    def prune(self,particle_ids):\n        for pid in particle_ids:\n            if pid in self.particles:\n                self.particles[pid].status='pruned'\n    def answer(self,rule='best_preview_score'):\n        class Ans:\n            def __init__(self,pid,nfe,rule):\n                self.particle_id=pid\n                self.preview_id=None\n                self.reward=None\n                self.nfe_used=nfe\n                self.rule=rule\n                self.event_log=[]\n                self.score_dict={}\n        if rule=='best_preview_score' and self.previews:\n            best=max(self.previews.values(), key=lambda p:p.score)\n            return Ans(best.particle_id,self._nfe,rule)\n        active=[p for p in self.particles.values() if p.status in {'active','completed'}]\n        pid=max(active,key=lambda p:(p.step,p.id)).id if active else None\n        return Ans(pid,self._nfe,rule)\n    def get_state(self):\n        return State(dict(self.particles), dict(self.previews))\n\nctrl=OptimalController()\nfor beta in [0.0,0.25,0.5,0.75,1.0]:\n    env=FakeSDEnv(64)\n    ans=ctrl.solve(env,beta)\n    print(beta, ans.nfe_used)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
