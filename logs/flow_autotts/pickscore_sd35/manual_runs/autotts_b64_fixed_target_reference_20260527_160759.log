f, particle_id, mode='clean_anchor', scorer='default'):\n        p=self.particles[particle_id]\n        if p.status == 'pruned':\n            raise InvalidActionError\n        self._charge(1)\n        aid=self._next_aid; self._next_aid += 1\n        score = 0.4 + 0.5 * p.time + 0.03 * ((particle_id % 3) - 1) - 0.02 * p.num_children\n        uncertainty = max(0.0, 1.0 - p.time)\n        drift = max(0.0, 0.8 - 0.5 * p.time)\n        rec=PreviewRecord(id=aid, particle_id=particle_id, time=p.time, score=score, uncertainty=uncertainty, drift=drift)\n        self.previews[aid]=rec\n        p.last_preview_id = aid\n        p.nfe_used += 1\n        return rec\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        if num_children <= 0:\n            raise InvalidActionError\n        anchor=self.previews[anchor_id]\n        parent=self.particles[anchor.particle_id]\n        ids=[]\n        for _ in range(num_children):\n            pid=self._next_pid; self._next_pid += 1\n            self.particles[pid]=_Particle(id=pid, time=target_time, parent_id=parent.id, source_anchor_id=anchor_id)\n            ids.append(pid)\n        parent.num_children += num_children\n        return ids\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            p=self.particles[pid]\n            if p.status == 'completed':\n                raise InvalidActionError\n            p.status='pruned'\n    def answer(self, rule='best_preview_score'):\n        if rule == 'best_preview_score' and self.previews:\n            best=max(self.previews.values(), key=lambda x: x.score)\n            return AnswerRecord(best.particle_id, best.id, (), best.score, self._used, rule, [])\n        active=[p for p in self.particles.values() if p.status in {'active','completed'}]\n        if not active:\n            return AnswerRecord(None, None, (), None, self._used, rule, [])\n        chosen=max(active, key=lambda p:(p.time,p.id))\n        if chosen.status=='active':\n            self.forward(chosen.id, 1.0)\n            chosen=self.particles[chosen.id]\n        reward=0.4 + 0.5 * chosen.time + 0.03 * ((chosen.id % 3) - 1)\n        return AnswerRecord(chosen.id, chosen.last_preview_id, (), reward, self._used, rule, [])\n    def get_state(self):\n        active=[]; completed=[]; pruned=[]\n        parts={}\n        for pid,p in self.particles.items():\n            if p.status=='active': active.append(pid)\n            elif p.status=='completed': completed.append(pid)\n            else: pruned.append(pid)\n            parts[pid]=ParticleSummary(pid,p.time,p.parent_id,p.source_anchor_id,p.nfe_used,p.status,p.last_preview_id,p.num_children)\n        return ControllerState(prompt='x', budget_left=self.budget_left, active_particle_ids=active, completed_particle_ids=completed, pruned_particle_ids=pruned, particles=parts, previews=dict(self.previews), event_log=[])\n\ncontroller = OptimalController()\nfor beta in (0.0, 0.25, 0.5, 0.75, 1.0):\n    env = FakeEnv(64)\n    ans = controller.solve(env, beta)\n    print(beta, ans.nfe_used, ans.rule, ans.reward, len(env.particles), len(env.previews))\nPY\"","aggregated_output":"0.0 10 best_preview_score 0.6000000000000001 2 2\n0.25 20 best_preview_score 0.6300000000000001 4 4\n0.5 36 best_preview_score 0.8300000000000001 5 8\n0.75 48 best_preview_score 0.8300000000000001 6 12\n1.0 64 best_preview_score 0.93 7 18\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_41","type":"agent_message","text":"Implemented the controller in [optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/optimal.py) as a beta-scheduled scout-confirm-refine policy. The core change is structural: instead of fully finishing branches before getting evidence, it now does intermediate-time scouts, ranks by preview score plus uncertainty, prunes losers, commits only survivors, and uses backward refinement only on anchors that are either close to the top score or still uncertain.\n\n**What I inspected**\n- `flow_tts_controller_implementation_spec.md`\n- `context_pack.md`\n- current [optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/optimal.py) and [baselines.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/baselines.py)\n- targeted public API files: [state.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/core/state.py), [errors.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/core/errors.py), [env.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/experiments/pickscore_sd35/env.py)\n\nThe context pack had no prior rounds, no frontier table, and no prior controller snapshots for this run, so there was no latest discovered controller to compare numerically. The only compact numeric references available were the injected ODE baseline rows:\n- `beta=0.00`: reward `0.676462`, mean NFE `8`, with this run’s locked target set to `10`\n- `beta=0.25`: reward `0.802083`, mean NFE `20`\n- `beta=0.50`: reward `0.836650`, mean NFE `36`\n- `beta=0.75`: reward `0.843990`, mean NFE `48`\n- `beta=1.00`: reward `0.847290`, mean NFE `64`\n\n**Schedule**\n- `beta=0.00`, target NFE `10`: `roots=2`, scout at `t=0.4`, keep `1`, commit to `t=1.0`, no backward, no confirmations. Underuse looked unjustified at first, so I adjusted scout depth from `0.5` to `0.4`; the dry-run now lands at `10`.\n- `beta=0.25`, target NFE `20`: `roots=4`, scout at `t=0.4`, keep `2`, then finish the best survivor, no backward, no confirmations. Underuse also looked unjustified, so I made the same scout-depth adjustment; the dry-run lands at `20`.\n- `beta=0.50`, target NFE `36`: `roots=5`, scout at `t=0.4`, keep `3`, commit survivors to `t=0.8`, keep `2`, allow `1` refined anchor with `1` child at `t=0.6`, plus `1` late confirm and `1` opportunistic confirm. This is meant to spend near `36` without blind full completions.\n- `beta=0.75`, target NFE `48`: `roots=6`, `sde` scouts at `t=0.4`, keep `3`, commit to `t=0.8`, keep `2`, up to `2` refined anchors with `mixed_noise` at `t=0.5`, `2` late confirms, `2` opportunistic confirms, diversity floor `2`. This is explicitly adjusted against underuse by spending extra budget on evidence and selective local exploration.\n- `beta=1.00`, target NFE `64`: `roots=7`, `sde` scouts at `t=0.4`, keep `4`, commit to `t=0.7`, keep `3`, up to `2` refined anchors with `2` children each, `3` late confirms, `2` opportunistic confirms, diversity floor `2`. It stays under `64` because every action is gated by both `env.budget_left` and remaining target NFE, and once any preview exists it answers with `best_preview_score`, avoiding `latest_active`’s implicit final-forward cost.\n\nBudget use is monotonic because target NFE rises `10 -> 20 -> 36 -> 48 -> 64`, and the width, survivor count, refinement capacity, confirmation count, and diversity floor are all nondecreasing with beta.\n\n**What is new**\n- Preview-before-commit allocation instead of the old complete-then-preview loop.\n- Score-gap and uncertainty based confirmation before more expensive branching.\n- Selective backward refinement from promising or uncertain anchors, rather than uniform late children.\n- Bounded `sde` scouts only at high beta.\n- Explicit target-NFE gating so low and mid beta do not accidentally underuse compute.\n\nCompared with the seed/template controller, this is a real behavioral change, not a threshold tweak.\n\n**Checks**\n- `python -m py_compile flow_autotts/controllers/optimal.py`\n- Lightweight fake-env dry-run across betas. Realized NFE in that dry-run was `10, 20, 36, 48, 64`.\n\n**Risks and intended gains**\n- Main target is the weak low/mid-budget allocation problem in the template: it was spending on full completions before evidence and could underuse the locked low-beta targets.\n- Expected improvement region is mainly `beta=0.25` and `beta=0.50`, with `beta=0.75` and `beta=1.00` protected by more conservative pruning and bounded refinement.\n- Main risk is preview noise: if early PickScore anchors are less rank-stable than expected, the scout prune can overcommit too soon. The late-confirm mechanism is there to reduce that risk."}}
