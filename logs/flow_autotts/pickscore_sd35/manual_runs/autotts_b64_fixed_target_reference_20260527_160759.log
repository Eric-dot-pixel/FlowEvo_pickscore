{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass, field\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, EventRecord, ParticleSummary, PreviewRecord\n\n@dataclass\nclass _Particle:\n    id: int\n    time: float = 0.0\n    status: str = 'active'\n    last_preview_id: int | None = None\n    nfe_used: int = 0\n    num_children: int = 0\n    parent_id: int | None = None\n    source_anchor_id: int | None = None\n\nclass FakeEnv:\n    def __init__(self, budget=64):\n        self.time_grid = tuple(i / 10 for i in range(11))\n        self.budget = budget\n        self._nfe = 0\n        self._next_pid = 0\n        self._next_aid = 0\n        self._particles = {}\n        self._previews = {}\n        self._events = []\n    @property\n    def budget_left(self):\n        return self.budget - self._nfe\n    def spawn(self, n):\n        if n <= 0:\n            raise InvalidActionError('bad spawn')\n        ids = []\n        for _ in range(n):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = _Particle(id=pid)\n            ids.append(pid)\n        return ids\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        p = self._particles[particle_id]\n        if p.status \"'!= '\"'active':\n            raise InvalidActionError('inactive')\n        if target_time <= p.time:\n            raise InvalidActionError('non-advancing')\n        steps = sum(1 for t in self.time_grid if p.time < t <= target_time + 1e-9)\n        if self._nfe + steps > self.budget:\n            raise BudgetExceededError()\n        self._nfe += steps\n        p.nfe_used += steps\n        p.time = min(1.0, target_time)\n        if p.time >= 1.0 - 1e-9:\n            p.status = 'completed'\n        return self.get_state().particles[particle_id]\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p = self._particles[particle_id]\n        if p.status == 'pruned':\n            raise InvalidActionError('pruned')\n        if self._nfe + 1 > self.budget:\n            raise BudgetExceededError()\n        self._nfe += 1\n        p.nfe_used += 1\n        aid = self._next_aid\n        self._next_aid += 1\n        score = 0.4 + 0.2 * p.time - 0.02 * particle_id + 0.01 * (aid % 3)\n        uncertainty = max(0.0, 0.25 - 0.18 * p.time)\n        preview = PreviewRecord(\n            id=aid,\n            particle_id=particle_id,\n            time=p.time,\n            score=score,\n            uncertainty=uncertainty,\n            drift=max(0.0, 1.0 - p.time),\n        )\n        self._previews[aid] = preview\n        p.last_preview_id = aid\n        return preview\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        if num_children <= 0:\n            raise InvalidActionError('bad children')\n        anchor = self._previews[anchor_id]\n        ids = []\n        for _ in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = _Particle(\n                id=pid,\n                time=target_time,\n                status='completed' if target_time >= 1.0 else 'active',\n                parent_id=anchor.particle_id,\n                source_anchor_id=anchor_id,\n            )\n            ids.append(pid)\n        return ids\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            p = self._particles[pid]\n            if p.status == 'completed':\n                raise InvalidActionError('cannot prune completed')\n            p.status = 'pruned'\n    def answer(self, rule='best_preview_score'):\n        if rule == 'best_preview_score' and self._previews:\n            preview = max(self._previews.values(), key=lambda x: x.score)\n            return AnswerRecord(preview.particle_id, preview.id, (), preview.score, self._nfe, rule, list(self._events), {'pickscore': preview.score})\n        active = [p for p in self._particles.values() if p.status in {'active', 'completed'}]\n        pid = max(active, key=lambda x: (x.time, x.id)).id if active else None\n        return AnswerRecord(pid, None, (), None, self._nfe, rule, list(self._events), {})\n    def get_state(self):\n        active = [pid for pid, p in self._particles.items() if p.status == 'active']\n        completed = [pid for pid, p in self._particles.items() if p.status == 'completed']\n        pruned = [pid for pid, p in self._particles.items() if p.status == 'pruned']\n        return ControllerState(\n            prompt='x',\n            budget_left=self.budget_left,\n            active_particle_ids=active,\n            completed_particle_ids=completed,\n            pruned_particle_ids=pruned,\n            particles={pid: ParticleSummary(pid, p.time, p.parent_id, p.source_anchor_id, p.nfe_used, p.status, p.last_preview_id, p.num_children) for pid, p in self._particles.items()},\n            previews=dict(self._previews),\n            event_log=list(self._events),\n        )\n\ncontroller = OptimalController()\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FakeEnv(64)\n    answer = controller.solve(env, beta)\n    print(beta, env.budget - env.budget_left, answer.rule, answer.preview_id)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass, field\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, EventRecord, ParticleSummary, PreviewRecord\n\n@dataclass\nclass _Particle:\n    id: int\n    time: float = 0.0\n    status: str = 'active'\n    last_preview_id: int | None = None\n    nfe_used: int = 0\n    num_children: int = 0\n    parent_id: int | None = None\n    source_anchor_id: int | None = None\n\nclass FakeEnv:\n    def __init__(self, budget=64):\n        self.time_grid = tuple(i / 10 for i in range(11))\n        self.budget = budget\n        self._nfe = 0\n        self._next_pid = 0\n        self._next_aid = 0\n        self._particles = {}\n        self._previews = {}\n        self._events = []\n    @property\n    def budget_left(self):\n        return self.budget - self._nfe\n    def spawn(self, n):\n        if n <= 0:\n            raise InvalidActionError('bad spawn')\n        ids = []\n        for _ in range(n):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = _Particle(id=pid)\n            ids.append(pid)\n        return ids\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        p = self._particles[particle_id]\n        if p.status \"'!= '\"'active':\n            raise InvalidActionError('inactive')\n        if target_time <= p.time:\n            raise InvalidActionError('non-advancing')\n        steps = sum(1 for t in self.time_grid if p.time < t <= target_time + 1e-9)\n        if self._nfe + steps > self.budget:\n            raise BudgetExceededError()\n        self._nfe += steps\n        p.nfe_used += steps\n        p.time = min(1.0, target_time)\n        if p.time >= 1.0 - 1e-9:\n            p.status = 'completed'\n        return self.get_state().particles[particle_id]\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p = self._particles[particle_id]\n        if p.status == 'pruned':\n            raise InvalidActionError('pruned')\n        if self._nfe + 1 > self.budget:\n            raise BudgetExceededError()\n        self._nfe += 1\n        p.nfe_used += 1\n        aid = self._next_aid\n        self._next_aid += 1\n        score = 0.4 + 0.2 * p.time - 0.02 * particle_id + 0.01 * (aid % 3)\n        uncertainty = max(0.0, 0.25 - 0.18 * p.time)\n        preview = PreviewRecord(\n            id=aid,\n            particle_id=particle_id,\n            time=p.time,\n            score=score,\n            uncertainty=uncertainty,\n            drift=max(0.0, 1.0 - p.time),\n        )\n        self._previews[aid] = preview\n        p.last_preview_id = aid\n        return preview\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        if num_children <= 0:\n            raise InvalidActionError('bad children')\n        anchor = self._previews[anchor_id]\n        ids = []\n        for _ in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = _Particle(\n                id=pid,\n                time=target_time,\n                status='completed' if target_time >= 1.0 else 'active',\n                parent_id=anchor.particle_id,\n                source_anchor_id=anchor_id,\n            )\n            ids.append(pid)\n        return ids\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            p = self._particles[pid]\n            if p.status == 'completed':\n                raise InvalidActionError('cannot prune completed')\n            p.status = 'pruned'\n    def answer(self, rule='best_preview_score'):\n        if rule == 'best_preview_score' and self._previews:\n            preview = max(self._previews.values(), key=lambda x: x.score)\n            return AnswerRecord(preview.particle_id, preview.id, (), preview.score, self._nfe, rule, list(self._events), {'pickscore': preview.score})\n        active = [p for p in self._particles.values() if p.status in {'active', 'completed'}]\n        pid = max(active, key=lambda x: (x.time, x.id)).id if active else None\n        return AnswerRecord(pid, None, (), None, self._nfe, rule, list(self._events), {})\n    def get_state(self):\n        active = [pid for pid, p in self._particles.items() if p.status == 'active']\n        completed = [pid for pid, p in self._particles.items() if p.status == 'completed']\n        pruned = [pid for pid, p in self._particles.items() if p.status == 'pruned']\n        return ControllerState(\n            prompt='x',\n            budget_left=self.budget_left,\n            active_particle_ids=active,\n            completed_particle_ids=completed,\n            pruned_particle_ids=pruned,\n            particles={pid: ParticleSummary(pid, p.time, p.parent_id, p.source_anchor_id, p.nfe_used, p.status, p.last_preview_id, p.num_children) for pid, p in self._particles.items()},\n            previews=dict(self._previews),\n            event_log=list(self._events),\n        )\n\ncontroller = OptimalController()\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FakeEnv(64)\n    answer = controller.solve(env, beta)\n    print(beta, env.budget - env.budget_left, answer.rule, answer.preview_id)\nPY\"","aggregated_output":"0.0 10 best_preview_score 2\n0.25 20 best_preview_score 5\n0.5 34 best_preview_score 7\n0.75 45 best_preview_score 8\n1.0 55 best_preview_score 11\n","exit_code":0,"status":"completed"}}
