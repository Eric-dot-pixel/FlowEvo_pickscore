  runner_up = previews[1]\n   302\t            gap = float(best.score or 0.0) - float(runner_up.score or 0.0)\n   303\t            uncertainty = max(float(best.uncertainty or 0.0), float(runner_up.uncertainty or 0.0))\n   304\t            if gap > float(schedule[\"rival_gap\"]) and uncertainty < float(schedule[\"uncertainty_gate\"]):\n   305\t                return\n   306\t\n   307\t            progressed = False\n   308\t            for preview in previews[:2]:\n   309\t                state = env.get_state()\n   310\t                particle = state.particles.get(preview.particle_id)\n   311\t                if particle is None or particle.status != \"active\":\n   312\t                    continue\n   313\t                if particle.time + 1e-9 >= float(schedule[\"rival_time\"]):\n   314\t                    continue\n   315\t                cost = self._segment_cost(env, preview.particle_id, float(schedule[\"rival_time\"])) + 1\n   316\t                if not self._can_spend(env, initial_budget, schedule, cost):\n   317\t                    continue\n   318\t                try:\n   319\t                    self._forward_to(env, preview.particle_id, float(schedule[\"rival_time\"]), solver=\"euler\")\n   320\t                    self._preview(env, preview.particle_id)\n   321\t                    progressed = True\n   322\t                except (BudgetExceededError, InvalidActionError):\n   323\t                    continue\n   324\t            if not progressed:\n   325\t                return\n   326\t            rounds += 1\n   327\t\n   328\t    def _repair_stage(\n   329\t        self,\n   330\t        env: FlowTTSEnv,\n   331\t        particle_ids: list[int],\n   332\t        schedule: dict[str, float | int | bool | str],\n   333\t        initial_budget: int,\n   334\t    ) -> list[int]:\n   335\t        previews = self._rank_previews(env, particle_ids)\n   336\t        if len(previews) < 2 or int(schedule[\"max_repair_anchors\"]) <= 0:\n   337\t            return particle_ids\n   338\t\n   339\t        best = previews[0]\n   340\t        runner_up = previews[1]\n   341\t        gap = float(best.score or 0.0) - float(runner_up.score or 0.0)\n   342\t        uncertainty = max(float(best.uncertainty or 0.0), float(runner_up.uncertainty or 0.0))\n   343\t        if gap > float(schedule[\"repair_gap\"]) and uncertainty < float(schedule[\"uncertainty_gate\"]):\n   344\t            return particle_ids\n   345\t\n   346\t        anchor_candidates = [runner_up, best]\n   347\t        child_cost = self._child_eval_cost(\n   348\t            env,\n   349\t            float(schedule[\"repair_time\"]),\n   350\t            float(schedule[\"repair_eval_time\"]),\n   351\t        )\n   352\t        new_ids: list[int] = []\n   353\t\n   354\t        for anchor in anchor_candidates[: int(schedule[\"max_repair_anchors\"])]:\n   355\t            projected_cost = int(schedule[\"children_per_anchor\"]) * child_cost\n   356\t            if not self._can_spend(env, initial_budget, schedule, projected_cost):\n   357\t                break\n   358\t            try:\n   359\t                child_ids = env.backward(\n   360\t                    anchor.id,\n   361\t                    target_time=float(schedule[\"repair_time\"]),\n   362\t                    noise_policy=str(schedule[\"noise_policy\"]),\n   363\t                    num_children=int(schedule[\"children_per_anchor\"]),\n   364\t                    strength=float(schedule[\"strength\"]),\n   365\t                )\n   366\t            except (BudgetExceededError, InvalidActionError):\n   367\t                continue\n   368\t\n   369\t            for child_id in child_ids:\n   370\t                try:\n   371\t                    self._forward_to(env, child_id, float(schedule[\"repair_eval_time\"]), solver=\"euler\")\n   372\t                    self._preview(env, child_id)\n   373\t                    new_ids.append(child_id)\n   374\t                except (BudgetExceededError, InvalidActionError):\n   375\t                    break\n   376\t\n   377\t        merged = particle_ids + new_ids\n   378\t        if not new_ids:\n   379\t            return merged\n   380\t\n   381\t        survivors = self._adaptive_keep(\n   382\t            env,\n   383\t            merged,\n   384\t            int(schedule[\"keep_after_commit\"]),\n   385\t            float(schedule[\"commit_margin\"]),\n   386\t        )\n   387\t        self._prune_non_survivors(env, merged, survivors)\n   388\t        return survivors\n   389\t\n   390\t    def _tail_stage(\n   391\t        self,\n   392\t        env: FlowTTSEnv,\n   393\t        particle_ids: list[int],\n   394\t        schedule: dict[str, float | int | bool | str],\n   395\t        initial_budget: int,\n   396\t    ) -> None:\n   397\t        ranked = self._rank_particle_ids(env, particle_ids)\n   398\t        if not ranked:\n   399\t            return\n   400\t\n   401\t        top_id = ranked[0]\n   402\t        top_cost = self._segment_cost(env, top_id, float(schedule[\"tail_top_time\"])) + 1\n   403\t        if self._can_spend(env, initial_budget, schedule, top_cost):\n   404\t            try:\n   405\t                self._forward_to(env, top_id, float(schedule[\"tail_top_time\"]), solver=\"euler\")\n   406\t                self._preview(env, top_id)\n   407\t            except (BudgetExceededError, InvalidActionError):\n   408\t                return\n   409\t\n   410\t        if len(ranked) < 2:\n   411\t            return\n   412\t\n   413\t        updated = self._rank_previews(env, particle_ids)\n   414\t        if len(updated) < 2:\n   415\t            return\n   416\t        best = updated[0]\n   417\t        runner_up = updated[1]\n   418\t        gap = float(best.score or 0.0) - float(runner_up.score or 0.0)\n   419\t        uncertainty = max(float(best.uncertainty or 0.0), float(runner_up.uncertainty or 0.0))\n   420\t        if gap > float(schedule[\"tail_rival_gap\"]) and uncertainty < float(schedule[\"uncertainty_gate\"]):\n   421\t            return\n   422\t\n   423\t        rival_id = runner_up.particle_id\n   424\t        rival_cost = self._segment_cost(env, rival_id, float(schedule[\"tail_rival_time\"])) + 1\n   425\t        if not self._can_spend(env, initial_budget, schedule, rival_cost):\n   426\t            return\n   427\t        try:\n   428\t            self._forward_to(env, rival_id, float(schedule[\"tail_rival_time\"]), solver=\"euler\")\n   429\t            self._preview(env, rival_id)\n   430\t        except (BudgetExceededError, InvalidActionError):\n   431\t            return\n   432\t\n   433\t    def _late_confirmation_stage(\n   434\t        self,\n   435\t        env: FlowTTSEnv,\n   436\t        particle_ids: list[int],\n   437\t        schedule: dict[str, float | int | bool | str],\n   438\t        initial_budget: int,\n   439\t    ) -> None:\n   440\t        rounds = int(schedule[\"late_confirmation_rounds\"])\n   441\t        if rounds <= 0:\n   442\t            return\n   443\t\n   444\t        for _ in range(rounds):\n   445\t            previews = self._rank_previews(env, particle_ids)\n   446\t            if len(previews) < 2:\n   447\t                return\n   448\t            best = previews[0]\n   449\t            runner_up = previews[1]\n   450\t            gap = float(best.score or 0.0) - float(runner_up.score or 0.0)\n   451\t            uncertainty = max(float(best.uncertainty or 0.0), float(runner_up.uncertainty or 0.0))\n   452\t            if gap > float(schedule[\"late_confirmation_gap\"]) and uncertainty < float(\n   453\t                schedule[\"late_confirmation_uncertainty\"]\n   454\t            ):\n   455\t                return\n   456\t\n   457\t            candidate_ids = self._close_rivals(\n   458\t                env,\n   459\t                particle_ids,\n   460\t                margin=float(schedule[\"late_confirmation_margin\"]),\n   461\t            )\n   462\t            progressed = False\n   463\t            for particle_id in candidate_ids[:2]:\n   464\t                next_time = self._next_time_for_particle(env, particle_id)\n   465\t                if next_time is None:\n   466\t                    continue\n   467\t                cost = self._segment_cost(env, particle_id, next_time) + 1\n   468\t                if not self._can_spend(env, initial_budget, schedule, cost, allow_reserve=True):\n   469\t                    continue\n   470\t                try:\n   471\t                    self._forward_to(env, particle_id, next_time, solver=\"euler\")\n   472\t                    self._preview(env, particle_id)\n   473\t                    progressed = True\n   474\t                except (BudgetExceededError, InvalidActionError):\n   475\t                    continue\n   476\t            if not progressed:\n   477\t                return\n   478\t\n   479\t    def _fill_target(\n   480\t        self,\n   481\t        env: FlowTTSEnv,\n   482\t        particle_ids: list[int],\n   483\t        schedule: dict[str, float | int | bool | str],\n   484\t        initial_budget: int,\n   485\t    ) -> None:\n   486\t        while True:\n   487\t            previews = self._rank_previews(env, particle_ids)\n   488\t            if len(previews) >= 2:\n   489\t                gap = float(previews[0].score or 0.0) - float(previews[1].score or 0.0)\n   490\t                uncertainty = max(\n   491\t                    float(previews[0].uncertainty or 0.0),\n   492\t                    float(previews[1].uncertainty or 0.0),\n   493\t                )\n   494\t                spent = self._spent(env, initial_budget)\n   495\t                if (\n   496\t                    spent >= int(schedule[\"stop_spend_floor\"])\n   497\t                    and gap > float(schedule[\"stop_gap\"])\n   498\t                    and uncertainty < float(schedule[\"fill_uncertainty_gate\"])\n   499\t                ):\n   500\t                    return\n   501\t\n   502\t                if gap <= float(schedule[\"fill_gap\"]) or uncertainty >= float(schedule[\"fill_uncertainty_gate\"]):\n   503\t                    progressed = False\n   504\t                    for particle_id in self._close_rivals(\n   505\t                        env,\n   506\t                        particle_ids,\n   507\t                        margin=float(schedule[\"late_confirmation_margin\"]),\n   508\t                    )[: int(schedule[\"fill_confirmation_cap\"])]:\n   509\t                        next_time = self._next_time_for_particle(env, particle_id)\n   510\t                        if next_time is None:\n   511\t                            continue\n   512\t                        cost = self._segment_cost(env, particle_id, next_time) + 1\n   513\t                        if not self._can_spend(env, initial_budget, schedule, cost, allow_reserve=True):\n   514\t                            continue\n   515\t                        try:\n   516\t                            self._forward_to(env, particle_id, next_time, solver=\"euler\")\n   517\t                            self._preview(env, particle_id)\n   518\t                            progressed = True\n   519\t                        except (BudgetExceededError, InvalidActionError):\n   520\t                            continue\n   521\t                    if progressed:\n   522\t                        continue\n   523\t\n   524\t            candidate_id, next_time = self._best_next_step(env, particle_ids)\n   525\t            if candidate_id is None or next_time is None:\n   526\t                self._late_repair_fill(env, particle_ids, schedule, initial_budget)\n   527\t                return\n   528\t            cost = self._segment_cost(env, candidate_id, next_time) + 1\n   529\t            if not self._can_spend(env, initial_budget, schedule, cost, allow_reserve=True):\n   530\t                return\n   531\t            try:\n   532\t                self._forward_to(env, candidate_id, next_time, solver=\"euler\")\n   533\t                self._preview(env, candidate_id)\n   534\t            except (BudgetExceededError, InvalidActionError):\n   535\t                return\n   536\t\n   537\t    def _late_repair_fill(\n   538\t        self,\n   539\t        env: FlowTTSEnv,\n   540\t        particle_ids: list[int],\n   541\t        schedule: dict[str, float | int | bool | str],\n   542\t        initial_budget: int,\n   543\t    ) -> None:\n   544\t        if int(schedule.get(\"late_repair_children\", 0)) <= 0:\n   545\t            return\n   546\t\n   547\t        previews = self._rank_previews(env, particle_ids)\n   548\t        if not previews:\n   549\t            return\n   550\t        if len(previews) >= 2:\n   551\t            gap = float(previews[0].score or 0.0) - float(previews[1].score or 0.0)\n   552\t            uncertainty = max(\n   553\t                float(previews[0].uncertainty or 0.0),\n   554\t                float(previews[1].uncertainty or 0.0),\n   555\t            )\n   556\t            if gap > float(schedule[\"fill_gap\"]) and uncertainty < float(schedule[\"fill_uncertainty_gate\"]):\n   557\t                return\n   558\t\n   559\t        anchor = previews[1] if len(previews) >= 2 else previews[0]\n   560\t        cost = int(schedule[\"late_repair_children\"]) * self._child_eval_cost(\n   561\t            env,\n   562\t            float(schedule[\"late_repair_time\"]),\n   563\t            float(schedule[\"late_repair_eval_time\"]),\n   564\t        )\n   565\t        if not self._can_spend(env, initial_budget, schedule, cost, allow_reserve=True):\n   566\t            return\n   567\t\n   568\t        try:\n   569\t            child_ids = env.backward(\n   570\t                anchor.id,\n   571\t                target_time=float(schedule[\"late_repair_time\"]),\n   572\t                noise_policy=str(schedule[\"noise_policy\"]),\n   573\t                num_children=int(schedule[\"late_repair_children\"]),\n   574\t                strength=float(schedule[\"strength\"]),\n   575\t            )\n   576\t        except (BudgetExceededError, InvalidActionError):\n   577\t            return\n   578\t\n   579\t        for child_id in child_ids:\n   580\t            try:\n   581\t                self._forward_to(env, child_id, float(schedule[\"late_repair_eval_time\"]), solver=\"euler\")\n   582\t                self._preview(env, child_id)\n   583\t            except (BudgetExceededError, InvalidActionError):\n   584\t                return\n   585\t\n   586\t    def _adaptive_keep(\n   587\t        self,\n   588\t        env: FlowTTSEnv,\n   589\t        particle_ids: list[int],\n   590\t        base_keep: int,\n   591\t        margin: float,\n   592\t    ) -> list[int]:\n   593\t        ranked_previews = self._rank_previews(env, particle_ids)\n   594\t        if not ranked_previews:\n   595\t            return particle_ids[: max(1, base_keep)]\n   596\t\n   597\t        keep = max(1, min(base_keep, len(ranked_previews)))\n   598\t        cutoff = float(ranked_previews[keep - 1].score or 0.0)\n   599\t        survivors: list[int] = []\n   600\t        for preview in ranked_previews:\n   601\t            score = float(preview.score or 0.0)\n   602\t            if len(survivors) < keep or score >= cutoff - margin:\n   603\t                survivors.append(preview.particle_id)\n   604\t        return survivors\n   605\t\n   606\t    def _rank_particle_ids(self, env: FlowTTSEnv, particle_ids: list[int]) -> list[int]:\n   607\t        previews = self._rank_previews(env, particle_ids)\n   608\t        ranked = [preview.particle_id for preview in previews]\n   609\t        seen = set(ranked)\n   610\t        state = env.get_state()\n   611\t        fallback = [\n   612\t            particle_id\n   613\t            for particle_id in particle_ids\n   614\t            if particle_id in state.particles\n   615\t            and state.particles[particle_id].status == \"active\"\n   616\t            and particle_id not in seen\n   617\t        ]\n   618\t        fallback.sort(\n   619\t            key=lambda particle_id: (\n   620\t                float(state.particles[particle_id].time),\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_48","type":"agent_message","text":"Implemented a new staged controller in [optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/optimal.py#L10). The policy keeps the strong low-beta single-root preview regime, then switches to scout -> commit -> rival continuation -> selective repair -> late confirmation -> target fill. The new mechanism is a beta-scaled late-evidence reserve plus a stepwise tie-break loop: at high beta it withholds a small NFE reserve for late close-rival confirmations and, if all live branches are exhausted while evidence is still ambiguous, it can spend that reserve on one final local backward repair from a late anchor instead of silently underusing compute ([optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/optimal.py#L433), [optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/optimal.py#L537), [optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/optimal.py#L679)).\n\nI inspected the injected best-of-4 ODE baseline table and target curve in the context pack, the latest frontier rows for `r0004`, `r0003`, `r0002`, `r0000`, the regression ledger, the rejected-round notes for `r0005` and `r0001`, and the recent controller snapshots `r0003`, `r0004`, `r0005`. The main weakness was still `beta=0.75` and `beta=1.0`: latest `r0004` was `47.43 / 0.840149` vs target `48 / 0.843990` at `0.75`, and `63.554 / 0.843016` vs target `64 / 0.847290` at `1.0`. `beta=0,0.25,0.5` were already at or above the beta-matched baseline, so I kept those regimes comparatively conservative.\n\nExact beta schedule is in [_schedule`](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/optimal.py#L63):\n- `beta=0.0`: target `10`, single root, `3` previews, no branching.\n- `beta=0.25`: target `20`, single root, `7` previews, no branching.\n- `beta=0.5`: target `36`, `4` roots, no SDE scouts, `keep 2`, one repair anchor, no reserved tail budget.\n- `beta=0.75`: target `48`, `5` roots, `1` SDE scout, `keep 3`, one repair anchor, `1` late confirmation round, `reserve_nfe=4`.\n- `beta=1.0`: target `64`, `6` roots, `1` SDE scout, `keep 4`, one repair anchor with `mixed_noise`, `2` late confirmation rounds, `reserve_nfe=6`, and optional final late repair fill.\nBudget willingness is monotonic because width, survivor count, late-confirmation depth, reserve, and late repair permissiveness all increase or stay flat with beta, while `_target_nfe` is fixed at `10/20/36/48/64` ([optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/optimal.py#L202)).\n\nBehaviorally new vs the recent best `r0004`:\n- It does not just do staged forward/preview and a single repair. It explicitly reserves late NFE for evidence gathering, then releases that reserve only in late confirmation or final fill.\n- Fill no longer burns budget only by generic best-next-step continuation. When the top previews are close or uncertain, it advances close rivals stepwise before answering.\n- At `beta=1.0`, if all active branches are done but ambiguity remains, it can spend the saved reserve on one final local child from a late anchor instead of stopping short.\n\nChecks run:\n- `python -m py_compile flow_autotts/controllers/optimal.py`\n- A tiny fake-env dry run across all betas to verify public-API contract usage, termination, and approximate target discipline. That fake env hit `10/20/36/47/62` NFE, which is only a structural sanity check, not a quality claim.\n\nTarget-NFE reflection:\n- `beta=0.0`, target `10`: underuse is not justified here, so I adjusted the single-root logic to actually schedule `10` total NFE via forward-plus-preview placement rather than capping previews too early.\n- `beta=0.25`, target `20`: same repair as above; expected to stay close by using one trajectory with dense previews and no wasted branching.\n- `beta=0.5`, target `36`: underuse did not look like the problem. I kept this near the accepted regime and avoided extra backward/preview churn because prior history suggested that hurt.\n- `beta=0.75`, target `48`: this is one intended improvement zone. I added a small reserved tail and one late confirmation round so the controller is less likely to stop at `47.x` when the top rivals are still close.\n- `beta=1.0`, target `64`: this is the main intended improvement zone. I added a larger reserve, two late confirmation rounds, and a last-chance late repair fill so the controller can spend closer to `64` when evidence is still unresolved. It still cannot exceed `64` because every spend path goes through `_can_spend`, which clamps to `min(target_nfe, env.budget)`, and for `beta=1.0` that target is `64` exactly ([optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/optimal.py#L161), [optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/optimal.py#L679)).\n\nExpected risks:\n- The high-beta late reserve may still occasionally finish slightly under target if the env’s discrete step structure leaves no valid continuation and the late repair anchor is already decisive.\n- `mixed_noise` at `beta=1.0` could still be neutral or mildly harmful if local refinement around late anchors is weaker than extra deterministic rival continuation.\n- `beta=0.5` is being protected rather than aggressively optimized, so gains are mainly aimed at `48` and `64` NFE regimes."}}
