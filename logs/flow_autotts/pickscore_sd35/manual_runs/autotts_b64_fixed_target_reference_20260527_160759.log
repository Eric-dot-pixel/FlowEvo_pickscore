0.6 + 0.24*p.time + 0.01*(particle_id % 5) - 0.005*(particle_id // 5)\n        unc=max(0.0,1.0-p.time)\n        preview=PreviewRecord(id=aid,particle_id=particle_id,time=p.time,score=score,uncertainty=unc,score_dict={})\n        self._previews[aid]=preview\n        p.last_preview_id=aid\n        return preview\n    def backward(self,anchor_id,target_time,noise_policy='fresh_noise',num_children=1,mask=None,strength=1.0):\n        if anchor_id not in self._previews: raise InvalidActionError('anchor')\n        ids=[]\n        time=max(t for t in self.time_grid if t<=target_time+1e-9)\n        for _ in range(num_children):\n            pid=self._next_pid; self._next_pid+=1\n            self._particles[pid]=P(pid,time=time)\n            ids.append(pid)\n        return ids\n    def prune(self,particle_ids):\n        for pid in particle_ids:\n            p=self._particles[pid]\n            if p.status=='completed': raise InvalidActionError('completed')\n            p.status='pruned'\n    def answer(self,rule='best_preview_score'):\n        if rule=='best_preview_score' and self._previews:\n            best=max(self._previews.values(), key=lambda x:x.score)\n            return AnswerRecord(best.particle_id,best.id,(),best.score,self._nfe,rule,[],{})\n        live=[p for p in self._particles.values() if p.status in ('active','completed')]\n        pid=max(live,key=lambda p:(p.time,p.id)).id if live else None\n        return AnswerRecord(pid,None,(),None,self._nfe,rule,[],{})\n    def get_state(self):\n        return ControllerState(\n            prompt='x', budget_left=self.budget_left,\n            active_particle_ids=[p.id for p in self._particles.values() if p.status=='active'],\n            completed_particle_ids=[p.id for p in self._particles.values() if p.status=='completed'],\n            pruned_particle_ids=[p.id for p in self._particles.values() if p.status=='pruned'],\n            particles={pid: ParticleSummary(id=pid,time=p.time,parent_id=None,source_anchor_id=None,nfe_used=0,status=p.status,last_preview_id=p.last_preview_id,num_children=0) for pid,p in self._particles.items()},\n            previews=dict(self._previews), event_log=[])\n\ncontroller=OptimalController()\nfor beta in [0.0,0.25,0.5,0.75,1.0]:\n    env=FakeEnv(64)\n    ans=controller.solve(env,beta)\n    print(beta, ans.nfe_used)\nPY\"","aggregated_output":"0.0 10\n0.25 20\n0.5 36\n0.75 47\n1.0 63\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_51","type":"agent_message","text":"Implemented a self-contained replacement in [optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/optimal.py): a beta-scheduled rival-preserving controller that does `scout -> commit -> ambiguity-triggered confirmation -> single selective backward repair -> late rival/top continuation -> budget fill`, always terminating with `env.answer(rule=\"best_preview_score\")`. The new mechanism is not “more branching”; it preserves one extra late rival at high beta and spends the last compute only when preview evidence is still ambiguous.\n\nI inspected the injected baseline/target table in the context pack, the latest compact results for `r0002`, the prior stronger `r0000`, and the controller snapshots for both. Latest frontier status from the pack was:\n- `beta=0.00`: `10 NFE`, reward `0.787971`, above baseline.\n- `beta=0.25`: `20 NFE`, reward `0.801358`, just below baseline `0.802083`.\n- `beta=0.50`: `36 NFE`, reward `0.836899`, above baseline `0.836650`.\n- `beta=0.75`: `47 NFE`, reward `0.834103`, weak and below baseline `0.843990`.\n- `beta=1.00`: `63.994 NFE`, reward `0.843780`, slightly below baseline `0.847290`.\nThe last two snapshots were behaviorally different, not cosmetic: `r0000` was essentially single-root preview continuation, while `r0002` switched to multi-scout/commit/refine with backward children. The history notes also showed that extra backward-heavy high-beta allocation had recently hurt tradeoff, so this round targets the weakest region, `beta=0.75` first and `1.0` second, with better late evidence allocation rather than more child spam.\n\nExact beta schedule:\n- `beta=0.00`: target `10`, roots `2`, scout `0.2`, commit keep `1`, no backward repair, one confirmation max.\n- `beta=0.25`: target `20`, roots `4`, scout `0.2`, commit keep `1`, no backward repair, two confirmations max.\n- `beta=0.50`: target `36`, roots `5`, scout `0.3`, commit `0.7`, keep `2`, one repair child from `t=0.6` evaluated at `0.9`, rival tail to `1.0/0.9`.\n- `beta=0.75`: target `48`, roots `5`, one SDE scout, commit keep `3`, one repair child, top and rival both can reach `1.0`, stop floor `44`.\n- `beta=1.00`: target `64`, roots `6`, one SDE scout, commit keep `4`, one repair child, top and rival both can reach `1.0`, stop floor `62`.\nBudget use is monotonic because target NFE, root count, survivor count, repair availability, and late continuation willingness all increase with beta. `beta=1` cannot exceed `64` because every spend is gated by `_can_spend`, which caps total spend at `min(schedule[\"target_nfe\"], env.budget)` and `target_nfe=64`.\n\nWhat is behaviorally new versus the recent best controller:\n- High beta now preserves more committed rivals instead of collapsing early.\n- Late previews are score-gap/uncertainty triggered and continue both leader and rival when the contest is unresolved.\n- `backward` is reduced to a single selective repair child under ambiguity, which directly avoids repeating the recent losing “more backward/more branching” pattern.\n\nChecks run:\n- `python -m py_compile flow_autotts/controllers/optimal.py`\n- tiny fake-env dry run of `solve()` across betas; realized toy NFE was `10, 20, 36, 47, 63`, matching the intended ceilings closely without overshoot.\n\nTarget-NFE reflection:\n- `beta=0.00`, target `10`: underuse is not allowed here; schedule is pinned to spend the full 10. Adjusted to stay exact.\n- `beta=0.25`, target `20`: mild conservatism would risk trailing baseline, so schedule is set to use the full 20 through width plus one completed candidate. Adjusted to stay near exact.\n- `beta=0.50`, target `36`: current regime was already healthy; underuse would usually be unjustified, so schedule still fills toward 36 with limited repair and rival continuation.\n- `beta=0.75`, target `48`: prior controller underused and misallocated. I adjusted by keeping 3 post-commit rivals and allowing both top and rival to reach `t=1.0`; expected to land very close to 48.\n- `beta=1.00`, target `64`: prior controller was slightly under target and still weak. I adjusted by keeping 4 post-commit rivals and raising the late stop floor to `62`; expected to finish around the low 60s and never exceed `64`.\n\nExpected gain/risk:\n- Intended improvement is mainly `beta=0.75`, with a smaller upside at `beta=1.0`, while protecting the already-good `0.0` and `0.5` regions.\n- Main risk is that preserving extra rivals at high beta could slightly dilute the best branch on some prompts, especially if preview ranking is already very stable by `t=0.7`."}}
