fe+1>self.budget: raise BudgetExceededError()\n        self._nfe+=1\n        aid=self._next_aid; self._next_aid+=1\n        base=0.68 + 0.02*p.step\n        pid_term=-0.01*(pid%3)\n        unc=max(0.0,1.0-p.time)\n        score=base + pid_term - 0.015*unc\n        prev=Preview(aid,pid,p.time,score,unc)\n        self.previews[aid]=prev\n        p.last_preview_id=aid\n        return prev\n    def backward(self,anchor_id,target_time,noise_policy='fresh_noise',num_children=1,mask=None,strength=1.0):\n        if anchor_id not in self.previews: raise InvalidActionError()\n        ids=[]\n        target=self._time_to_step(target_time)\n        for _ in range(num_children):\n            pid=self._next_pid; self._next_pid+=1\n            self.particles[pid]=Particle(pid,target)\n            ids.append(pid)\n        return ids\n    def prune(self,particle_ids):\n        for pid in particle_ids:\n            if pid in self.particles and self.particles[pid].status=='active':\n                self.particles[pid].status='pruned'\n    def answer(self,rule='best_preview_score'):\n        class Ans:\n            def __init__(self,pid,nfe,rule):\n                self.particle_id=pid\n                self.preview_id=None\n                self.reward=None\n                self.nfe_used=nfe\n                self.rule=rule\n                self.event_log=[]\n                self.score_dict={}\n        if rule=='best_preview_score' and self.previews:\n            best=max(self.previews.values(), key=lambda p:p.score)\n            return Ans(best.particle_id,self._nfe,rule)\n        active=[p for p in self.particles.values() if p.status in {'active','completed'}]\n        pid=max(active,key=lambda p:(p.step,p.id)).id if active else None\n        return Ans(pid,self._nfe,rule)\n    def get_state(self):\n        return State(dict(self.particles), dict(self.previews))\n\nctrl=OptimalController()\nfor beta in [0.0,0.25,0.5,0.75,1.0]:\n    env=FakeSDEnv(64)\n    ans=ctrl.solve(env,beta)\n    print(beta, ans.nfe_used, len(env.particles), len(env.previews))\nPY\"","aggregated_output":"0.0 10 2 3\n0.25 20 4 7\n0.5 36 5 9\n0.75 47 7 12\n1.0 63 7 18\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_58","type":"agent_message","text":"Implemented a new controller in [optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/optimal.py). The policy stays in the strong `r0004` multi-root family, but adds one real mechanism: a high-beta late ambiguity repair stage that spends leftover compute on one bounded late `backward` child from the more uncertain top anchor when the top-2 previews are still close late in the episode. That is meant to repair the current `beta=0.75` and `beta=1.0` weakness without disturbing the already-good low and mid beta regimes.\n\n**What I inspected**\n- Spec: `flow_tts_controller_implementation_spec.md`\n- Context pack: `r0007 ... /context_pack.md`\n- Current files: `flow_autotts/controllers/optimal.py`, `flow_autotts/controllers/baselines.py`\n- Targeted snapshots: `r0004`, `r0003`, and `r0000` controller snapshots plus the compact frontier tables named in the context pack.\n- The key rows I used were:\n  - Latest `r0004`: `beta=0.0/0.25/0.5/0.75/1.0` with `(reward, mean_nfe)` = `(0.787971,10)`, `(0.817857,20)`, `(0.837384,36)`, `(0.840149,47.43)`, `(0.843016,63.554)`\n  - Beta-matched ODE baselines: `(0.676462,10)`, `(0.802083,20)`, `(0.836650,36)`, `(0.843990,48)`, `(0.847290,64)`\n  - Historical near-target bests showing current weak spots were still `0.75` and `1.0`, while `0.0`, `0.25`, and `0.5` were already competitive or ahead.\n\n**Why this change**\n- The last two proposal snapshots were real behavioral changes, but both still lived in the same pattern: scout, commit, rival continuation, optional repair, fill.\n- The context pack’s strongest evidence was:\n  - low and mid beta should be protected;\n  - `0.75` and `1.0` are still below their beta-matched baselines;\n  - rejected rounds that merely traded forward for more preview or shaved NFE were not helpful;\n  - more indiscriminate backward was usually harmful.\n- So the targeted repair is not “more backward everywhere”. It is one late, ambiguity-gated, high-beta-only local repair, using `mixed_noise`, after the normal rival/repair stages have already run.\n\n**Exact beta schedule**\n- `beta=0.00`\n  - `target_nfe=10`, `roots=2`, `scout_time=0.2`, `commit_time=0.5`, `rival_time=0.7`\n  - no repair, no late repair\n- `beta=0.25`\n  - `target_nfe=20`, `roots=4`, `scout_time=0.2`, `commit_time=0.5`, `rival_time=0.7`\n  - no repair, no late repair\n- `beta=0.50`\n  - `target_nfe=36`, `roots=5`, `scout_time=0.3`, `commit_time=0.7`, `rival_time=0.9`\n  - standard repair only: `repair_time=0.7`, `repair_eval_time=0.9`, `max_repair_children=1`\n- `beta=0.75`\n  - `target_nfe=48`, `roots=5`, `sde_scouts=1`, `scout_time=0.3`, `commit_time=0.7`, `rival_time=0.9`\n  - standard repair as before, plus new late repair:\n  - `late_repair_time=0.8`, `late_repair_eval_time=1.0`, `max_late_repairs=1`, `late_noise_policy=\"mixed_noise\"`, `late_strength=0.45`\n- `beta=1.00`\n  - `target_nfe=64`, `roots=6`, `sde_scouts=1`, `scout_time=0.3`, `commit_time=0.7`, `rival_time=0.9`\n  - standard repair plus late repair:\n  - `late_repair_time=0.8`, `late_repair_eval_time=1.0`, `max_late_repairs=1`, `late_noise_policy=\"mixed_noise\"`, `late_strength=0.35`\n\nBudget use is monotonic because higher beta only increases or preserves willingness to spend through one or more of: more roots, enabling SDE scouts, looser rival gaps, enabling repair, enabling late repair, and later stop floors. The target cap is always enforced by `_can_spend(...)`, which clamps spend to `min(schedule[\"target_nfe\"], env.budget)`.\n\n**What is behaviorally new**\n- New mechanism vs `r0004`: `_late_repair_stage(...)`\n- It activates only for high beta, only after normal rival and repair stages, only when:\n  - top-2 previews remain close,\n  - uncertainty is still nontrivial,\n  - at least one top preview is already late,\n  - spend is already near the intended regime,\n  - and there is enough remaining budget for a full evaluate-after-backward cycle.\n- It chooses the more uncertain of the top anchors and uses one bounded late `mixed_noise` child, then immediately evaluates it.\n- This is materially different from the prior controller, which had only one earlier repair stage and then filled by forward+preview continuation.\n\n**Checks**\n- `python -m py_compile flow_autotts/controllers/optimal.py`\n- Tiny fake-env dry run mirroring SD-style step-cost semantics. Observed NFE:\n  - `beta=0.0 -> 10`\n  - `beta=0.25 -> 20`\n  - `beta=0.5 -> 36`\n  - `beta=0.75 -> 47`\n  - `beta=1.0 -> 63`\n\n**Target-NFE reflection**\n- `beta=0.00`, target `10`\n  - underuse not justified; I kept the proven schedule aligned to exactly `10`.\n- `beta=0.25`, target `20`\n  - underuse not justified; I kept the proven schedule aligned to exactly `20`.\n- `beta=0.50`, target `36`\n  - underuse not justified; I kept the proven schedule aligned to exactly `36`.\n- `beta=0.75`, target `48`\n  - prior underuse looked unjustified relative to the target curve; I adjusted policy with late repair and `min_stop_spend=47` to push utilization closer to `48` without meaningless probes.\n- `beta=1.00`, target `64`\n  - prior underuse looked unjustified relative to the target curve; I adjusted policy with late repair and `min_stop_spend=63` to stay close to `64` while still allowing justified early stop if evidence is decisive.\n\n**Expected impact and risks**\n- Targeted improvement: `beta=0.75` and `beta=1.0`, where the incumbent still trailed the beta-matched ODE baseline and slightly underused compute.\n- Protection goal: `beta=0.0`, `0.25`, `0.5`, which already beat or matched their beta-matched baselines.\n- Main risk: even bounded late repair could still be slightly net-negative if late `mixed_noise` diversification is too destructive on this SD3.5/PickScore setup.\n- Secondary risk: `0.75` may still land around `47.x` rather than exactly `48`, depending on when ambiguity resolves. That is intentional if the stop condition becomes clearly justified.\n\nFor `beta=1.0`, the controller avoids exceeding `64` because every spend path goes through `_can_spend(...)`, and the schedule sets `target_nfe=64`; no action is taken if `spent + extra_cost > 64`."}}
