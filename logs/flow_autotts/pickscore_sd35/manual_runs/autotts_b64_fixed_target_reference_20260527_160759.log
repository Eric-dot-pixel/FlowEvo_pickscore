{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass\nfrom typing import Any\n\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, EventRecord, ParticleSummary, PreviewRecord\n\n\n@dataclass\nclass _Particle:\n    id: int\n    time: float = 0.0\n    status: str = \\\"active\\\"\n    last_preview_id: int | None = None\n    num_children: int = 0\n\n\nclass FakeEnv:\n    def __init__(self, budget: int = 64):\n        self.time_grid = tuple(i / 10 for i in range(11))\n        self.budget = budget\n        self._budget_left = budget\n        self._particles = {}\n        self._previews = {}\n        self._events = []\n        self._next_pid = 0\n        self._next_aid = 0\n        self._answered = False\n\n    @property\n    def budget_left(self):\n        return self._budget_left\n\n    def _charge(self, n: int):\n        if n > self._budget_left:\n            raise BudgetExceededError()\n        self._budget_left -= n\n\n    def spawn(self, n):\n        if n <= 0:\n            raise InvalidActionError()\n        ids = []\n        for _ in range(n):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = _Particle(id=pid)\n            ids.append(pid)\n        return ids\n\n    def forward(self, particle_id, target_time, solver=\\\"euler\\\", cfg=None):\n        if solver not in {\\\"euler\\\", \\\"sde\\\"}:\n            raise InvalidActionError()\n        p = self._particles[particle_id]\n        if p.status \"'!= \"active\":\n            raise InvalidActionError()\n        if target_time <= p.time:\n            raise InvalidActionError()\n        steps = sum(1 for t in self.time_grid if p.time < t <= target_time)\n        self._charge(steps)\n        p.time = target_time\n        if p.time >= 1.0:\n            p.status = \"completed\"\n        return self.get_state().particles[particle_id]\n\n    def preview(self, particle_id, mode=\"clean_anchor\", scorer=\"default\"):\n        if mode != \"clean_anchor\":\n            raise InvalidActionError()\n        p = self._particles[particle_id]\n        if p.status == \"pruned\":\n            raise InvalidActionError()\n        self._charge(1)\n        aid = self._next_aid\n        self._next_aid += 1\n        score = 0.55 + 0.07 * p.time + 0.015 * ((particle_id % 5) - 2) - 0.005 * (aid % 3)\n        uncertainty = max(0.0, 1.0 - p.time)\n        drift = max(0.0, 0.8 - 0.5 * p.time)\n        rec = PreviewRecord(\n            id=aid,\n            particle_id=particle_id,\n            time=p.time,\n            score=score,\n            score_dict={\"score\": score},\n            uncertainty=uncertainty,\n            drift=drift,\n            embedding_ref=None,\n        )\n        self._previews[aid] = rec\n        p.last_preview_id = aid\n        return rec\n\n    def backward(self, anchor_id, target_time, noise_policy=\"fresh_noise\", num_children=1, mask=None, strength=1.0):\n        if num_children <= 0:\n            raise InvalidActionError()\n        parent_preview = self._previews[anchor_id]\n        parent = self._particles[parent_preview.particle_id]\n        ids = []\n        for _ in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = _Particle(id=pid, time=target_time, status=\"active\")\n            ids.append(pid)\n        parent.num_children += num_children\n        return ids\n\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            p = self._particles[pid]\n            if p.status == \"completed\":\n                raise InvalidActionError()\n            p.status = \"pruned\"\n\n    def answer(self, rule=\"best_preview_score\"):\n        self._answered = True\n        if rule == \"best_preview_score\" and self._previews:\n            best = max(self._previews.values(), key=lambda x: x.score)\n            return AnswerRecord(best.particle_id, best.id, (), best.score, self.budget - self._budget_left, rule, [])\n        if rule == \"latest_active\":\n            live = [p for p in self._particles.values() if p.status in {\"active\", \"completed\"}]\n            if not live:\n                return AnswerRecord(None, None, (), None, self.budget - self._budget_left, rule, [])\n            chosen = max(live, key=lambda p: (p.time, p.id))\n            if chosen.status == \"active\":\n                self.forward(chosen.id, 1.0, solver=\"euler\")\n            score = None\n            if chosen.last_preview_id is not None:\n                score = self._previews[chosen.last_preview_id].score\n            return AnswerRecord(chosen.id, chosen.last_preview_id, (), score, self.budget - self._budget_left, rule, [])\n        raise InvalidActionError()\n\n    def get_state(self):\n        active = [pid for pid, p in self._particles.items() if p.status == \"active\"]\n        completed = [pid for pid, p in self._particles.items() if p.status == \"completed\"]\n        pruned = [pid for pid, p in self._particles.items() if p.status == \"pruned\"]\n        particles = {\n            pid: ParticleSummary(\n                id=pid,\n                time=p.time,\n                parent_id=None,\n                source_anchor_id=None,\n                nfe_used=0,\n                status=p.status,\n                last_preview_id=p.last_preview_id,\n                num_children=p.num_children,\n            )\n            for pid, p in self._particles.items()\n        }\n        return ControllerState(\n            prompt=\"fake\",\n            budget_left=self._budget_left,\n            active_particle_ids=active,\n            completed_particle_ids=completed,\n            pruned_particle_ids=pruned,\n            particles=particles,\n            previews=dict(self._previews),\n            event_log=[],\n        )\n\n\ncontroller = OptimalController()\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FakeEnv(64)\n    answer = controller.solve(env, beta)\n    print(beta, answer.nfe_used, env.budget_left, answer.rule, answer.reward)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
