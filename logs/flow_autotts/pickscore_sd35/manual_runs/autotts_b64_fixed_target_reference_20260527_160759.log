{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\n\n@dataclass\nclass Particle:\n    id:int\n    time:float\n    status:str='active'\n    last_preview_id:int|None=None\n\n@dataclass\nclass Preview:\n    id:int\n    particle_id:int\n    time:float\n    score:float|None\n    uncertainty:float|None\n\n@dataclass\nclass State:\n    particles:dict\n    previews:dict\n\nclass FakeEnv:\n    def __init__(self, budget=64):\n        self.time_grid=tuple(i/10 for i in range(11))\n        self.budget=budget\n        self._nfe=0\n        self._next_pid=0\n        self._next_aid=0\n        self.particles={}\n        self.previews={}\n        self.answered=None\n    @property\n    def budget_left(self):\n        return self.budget-self._nfe\n    def spawn(self,n):\n        if n<=0: raise InvalidActionError()\n        ids=[]\n        for _ in range(n):\n            pid=self._next_pid; self._next_pid+=1\n            self.particles[pid]=Particle(pid,0.0)\n            ids.append(pid)\n        return ids\n    def forward(self,pid,target_time,solver='euler',cfg=None):\n        p=self.particles[pid]\n        if p.status\"'!='\"'active' or target_time<=p.time: raise InvalidActionError()\n        if self._nfe+1>self.budget: raise BudgetExceededError()\n        self._nfe+=1\n        p.time=round(float(target_time),10)\n        if p.time>=1.0: p.status='completed'\n        return p\n    def preview(self,pid,mode='clean_anchor',scorer='default'):\n        p=self.particles[pid]\n        if p.status=='pruned': raise InvalidActionError()\n        if self._nfe+1>self.budget: raise BudgetExceededError()\n        self._nfe+=1\n        aid=self._next_aid; self._next_aid+=1\n        score=0.7 + 0.08*p.time - 0.01*(pid%3)\n        unc=max(0.0,1.0-p.time)\n        prev=Preview(aid,pid,p.time,score,unc)\n        self.previews[aid]=prev\n        p.last_preview_id=aid\n        return prev\n    def backward(self,anchor_id,target_time,noise_policy='fresh_noise',num_children=1,mask=None,strength=1.0):\n        if anchor_id not in self.previews: raise InvalidActionError()\n        ids=[]\n        parent_pid=self.previews[anchor_id].particle_id\n        for _ in range(num_children):\n            pid=self._next_pid; self._next_pid+=1\n            self.particles[pid]=Particle(pid,float(target_time),'active')\n            ids.append(pid)\n        return ids\n    def prune(self,particle_ids):\n        for pid in particle_ids:\n            if pid in self.particles:\n                self.particles[pid].status='pruned'\n    def answer(self,rule='best_preview_score'):\n        self.answered=(rule,self._nfe)\n        class Ans:\n            def __init__(self,pid,nfe,rule):\n                self.particle_id=pid\n                self.preview_id=None\n                self.reward=None\n                self.nfe_used=nfe\n                self.rule=rule\n                self.event_log=[]\n                self.score_dict={}\n        if rule=='best_preview_score' and self.previews:\n            best=max(self.previews.values(), key=lambda p:p.score)\n            return Ans(best.particle_id,self._nfe,rule)\n        active=[p for p in self.particles.values() if p.status in {'active','completed'}]\n        pid=max(active,key=lambda p:(p.time,p.id)).id if active else None\n        return Ans(pid,self._nfe,rule)\n    def get_state(self):\n        return State(dict(self.particles), dict(self.previews))\n\nctrl=OptimalController()\nfor beta in [0.0,0.25,0.5,0.75,1.0]:\n    env=FakeEnv(64)\n    ans=ctrl.solve(env,beta)\n    print(beta, ans.nfe_used, ans.rule)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
