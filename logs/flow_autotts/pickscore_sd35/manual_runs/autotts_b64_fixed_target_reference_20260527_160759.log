{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass, field\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, EventRecord, ParticleSummary, PreviewRecord\n\n@dataclass\nclass P:\n    id:int\n    time:float=0.0\n    status:str='active'\n    last_preview_id:int|None=None\n\nclass FakeEnv:\n    def __init__(self,budget=64):\n        self.time_grid=tuple(i/10 for i in range(11))\n        self.budget=budget\n        self._nfe=0\n        self._next_pid=0\n        self._next_aid=0\n        self._particles={}\n        self._previews={}\n        self._events=[]\n    @property\n    def budget_left(self):\n        return self.budget-self._nfe\n    def spawn(self,n):\n        ids=[]\n        for _ in range(n):\n            pid=self._next_pid; self._next_pid+=1\n            self._particles[pid]=P(pid)\n            ids.append(pid)\n        return ids\n    def forward(self,particle_id,target_time,solver='euler',cfg=None):\n        p=self._particles[particle_id]\n        if p.status\"'!='\"'active':\n            raise InvalidActionError('inactive')\n        if target_time<=p.time:\n            raise InvalidActionError('non-advance')\n        steps=sum(1 for t in self.time_grid if p.time < t <= target_time+1e-9)\n        if self._nfe+steps>self.budget:\n            raise BudgetExceededError()\n        self._nfe+=steps\n        p.time=max([t for t in self.time_grid if t<=target_time+1e-9])\n        if p.time>=1.0:\n            p.status='completed'\n        self._events.append(('forward',particle_id,target_time,solver,cfg,steps))\n        return self.get_state().particles[particle_id]\n    def preview(self,particle_id,mode='clean_anchor',scorer='default'):\n        p=self._particles[particle_id]\n        if p.status=='pruned':\n            raise InvalidActionError('pruned')\n        if self._nfe+1>self.budget:\n            raise BudgetExceededError()\n        self._nfe+=1\n        aid=self._next_aid; self._next_aid+=1\n        base=0.6 + 0.25*p.time + 0.01*particle_id\n        penalty=0.02*max(0, p.time-0.9)\n        score=base-penalty\n        unc=max(0.0,1.0-p.time)\n        preview=PreviewRecord(id=aid,particle_id=particle_id,time=p.time,score=score,uncertainty=unc,score_dict={})\n        self._previews[aid]=preview\n        p.last_preview_id=aid\n        self._events.append(('preview',particle_id,p.time,score))\n        return preview\n    def backward(self,anchor_id,target_time,noise_policy='fresh_noise',num_children=1,mask=None,strength=1.0):\n        if mask is not None:\n            raise InvalidActionError('mask')\n        if num_children<=0:\n            raise InvalidActionError('children')\n        if anchor_id not in self._previews:\n            raise InvalidActionError('anchor')\n        parent=self._previews[anchor_id].particle_id\n        ids=[]\n        for _ in range(num_children):\n            pid=self._next_pid; self._next_pid+=1\n            self._particles[pid]=P(pid,time=max(t for t in self.time_grid if t<=target_time+1e-9))\n            ids.append(pid)\n        self._events.append(('backward',parent,target_time,num_children,noise_policy,strength))\n        return ids\n    def prune(self,particle_ids):\n        for pid in particle_ids:\n            p=self._particles[pid]\n            if p.status=='completed':\n                raise InvalidActionError('completed')\n            p.status='pruned'\n        self._events.append(('prune',tuple(particle_ids)))\n    def answer(self,rule='best_preview_score'):\n        if rule=='best_preview_score' and self._previews:\n            best=max(self._previews.values(), key=lambda x:x.score)\n            return AnswerRecord(best.particle_id,best.id,(),best.score,self._nfe,rule,[],{})\n        active=[p for p in self._particles.values() if p.status in ('active','completed')]\n        pid=max(active,key=lambda p:(p.time,p.id)).id if active else None\n        return AnswerRecord(pid,None,(),None,self._nfe,rule,[],{})\n    def get_state(self):\n        return ControllerState(\n            prompt='x', budget_left=self.budget_left,\n            active_particle_ids=[p.id for p in self._particles.values() if p.status=='active'],\n            completed_particle_ids=[p.id for p in self._particles.values() if p.status=='completed'],\n            pruned_particle_ids=[p.id for p in self._particles.values() if p.status=='pruned'],\n            particles={pid: ParticleSummary(id=pid,time=p.time,parent_id=None,source_anchor_id=None,nfe_used=0,status=p.status,last_preview_id=p.last_preview_id,num_children=0) for pid,p in self._particles.items()},\n            previews=dict(self._previews), event_log=[])\n\ncontroller=OptimalController()\nfor beta in [0.0,0.25,0.5,0.75,1.0]:\n    env=FakeEnv(64)\n    ans=controller.solve(env,beta)\n    print(beta, ans.nfe_used, ans.rule, ans.preview_id is not None)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
