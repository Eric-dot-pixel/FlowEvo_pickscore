{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass, field\nfrom typing import Any\n\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, EventRecord, ParticleSummary, PreviewRecord\n\n\n@dataclass\nclass _P:\n    id: int\n    time: float = 0.0\n    status: str = 'active'\n    last_preview_id: int | None = None\n    num_children: int = 0\n    parent_id: int | None = None\n    source_anchor_id: int | None = None\n    nfe_used: int = 0\n    quality: float = 0.0\n\n\nclass FakeEnv:\n    def __init__(self, budget=64, steps=10):\n        self.time_grid = tuple(i / steps for i in range(steps + 1))\n        self.budget = budget\n        self._nfe = 0\n        self._particles = {}\n        self._previews = {}\n        self._events = []\n        self._next_pid = 0\n        self._next_aid = 0\n        self._answered = False\n\n    @property\n    def budget_left(self):\n        return self.budget - self._nfe\n\n    @property\n    def nfe_used(self):\n        return self._nfe\n\n    def _charge(self, cost):\n        if self._nfe + cost > self.budget:\n            raise BudgetExceededError()\n        self._nfe += cost\n\n    def spawn(self, n):\n        if n <= 0:\n            raise InvalidActionError()\n        ids = []\n        for _ in range(n):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = _P(id=pid, quality=0.55 + 0.02 * pid)\n            ids.append(pid)\n        return ids\n\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        p = self._particles[particle_id]\n        if p.status \"'!= '\"'active':\n            raise InvalidActionError()\n        if target_time <= p.time:\n            raise InvalidActionError()\n        steps = sum(1 for t in self.time_grid if p.time < t <= target_time + 1e-9)\n        self._charge(steps)\n        p.nfe_used += steps\n        p.time = float(target_time)\n        if p.time >= 1.0 - 1e-9:\n            p.time = 1.0\n            p.status = 'completed'\n        if solver == 'sde':\n            p.quality -= 0.003\n        else:\n            p.quality += 0.004 * steps\n        return self.get_state().particles[particle_id]\n\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p = self._particles[particle_id]\n        if p.status == 'pruned':\n            raise InvalidActionError()\n        self._charge(1)\n        aid = self._next_aid\n        self._next_aid += 1\n        score = p.quality + 0.02 * p.time - 0.01 * p.num_children\n        uncertainty = max(0.0, 0.25 - 0.18 * p.time)\n        rec = PreviewRecord(\n            id=aid,\n            particle_id=particle_id,\n            time=p.time,\n            score=score,\n            score_dict={'score': score},\n            uncertainty=uncertainty,\n            drift=max(0.0, 1.0 - p.time),\n            embedding_ref=None,\n        )\n        self._previews[aid] = rec\n        p.last_preview_id = aid\n        p.nfe_used += 1\n        return rec\n\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        if mask is not None:\n            raise InvalidActionError()\n        parent_preview = self._previews[anchor_id]\n        parent = self._particles[parent_preview.particle_id]\n        ids = []\n        for idx in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            q = (parent_preview.score or 0.0) - 0.004 * idx\n            if noise_policy == 'mixed_noise':\n                q += 0.003\n            elif noise_policy == 'fresh_noise':\n                q -= 0.002\n            child = _P(\n                id=pid,\n                time=float(target_time),\n                status='completed' if target_time >= 1.0 else 'active',\n                parent_id=parent.id,\n                source_anchor_id=anchor_id,\n                quality=q,\n            )\n            self._particles[pid] = child\n            ids.append(pid)\n        parent.num_children += num_children\n        return ids\n\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            p = self._particles[pid]\n            if p.status == 'completed':\n                raise InvalidActionError()\n            p.status = 'pruned'\n\n    def answer(self, rule='best_preview_score'):\n        self._answered = True\n        preview_id = None\n        particle_id = None\n        reward = None\n        if rule == 'best_preview_score' and self._previews:\n            best = max(self._previews.values(), key=lambda r: (r.score if r.score is not None else -1e9, r.time, -r.id))\n            preview_id = best.id\n            particle_id = best.particle_id\n            reward = best.score\n        elif rule == 'latest_active':\n            active = [p for p in self._particles.values() if p.status \"'!= '\"'pruned']\n            if active:\n                bestp = max(active, key=lambda p: (p.time, p.id))\n                particle_id = bestp.id\n        else:\n            raise InvalidActionError()\n        return AnswerRecord(\n            particle_id=particle_id,\n            preview_id=preview_id,\n            latent=(),\n            reward=reward,\n            nfe_used=self._nfe,\n            rule=rule,\n            event_log=[],\n            score_dict={},\n        )\n\n    def get_state(self):\n        particles = {\n            pid: ParticleSummary(\n                id=p.id,\n                time=p.time,\n                parent_id=p.parent_id,\n                source_anchor_id=p.source_anchor_id,\n                nfe_used=p.nfe_used,\n                status=p.status,\n                last_preview_id=p.last_preview_id,\n                num_children=p.num_children,\n            )\n            for pid, p in self._particles.items()\n        }\n        previews = dict(self._previews)\n        active = [pid for pid, p in self._particles.items() if p.status == 'active']\n        completed = [pid for pid, p in self._particles.items() if p.status == 'completed']\n        pruned = [pid for pid, p in self._particles.items() if p.status == 'pruned']\n        return ControllerState(\n            prompt='fake',\n            budget_left=self.budget_left,\n            active_particle_ids=active,\n            completed_particle_ids=completed,\n            pruned_particle_ids=pruned,\n            particles=particles,\n            previews=previews,\n            event_log=[],\n        )\n\n\ncontroller = OptimalController()\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FakeEnv()\n    answer = controller.solve(env, beta)\n    print({'beta': beta, 'nfe': answer.nfe_used, 'rule': answer.rule, 'preview': answer.preview_id, 'budget_left': env.budget_left})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass, field\nfrom typing import Any\n\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, EventRecord, ParticleSummary, PreviewRecord\n\n\n@dataclass\nclass _P:\n    id: int\n    time: float = 0.0\n    status: str = 'active'\n    last_preview_id: int | None = None\n    num_children: int = 0\n    parent_id: int | None = None\n    source_anchor_id: int | None = None\n    nfe_used: int = 0\n    quality: float = 0.0\n\n\nclass FakeEnv:\n    def __init__(self, budget=64, steps=10):\n        self.time_grid = tuple(i / steps for i in range(steps + 1))\n        self.budget = budget\n        self._nfe = 0\n        self._particles = {}\n        self._previews = {}\n        self._events = []\n        self._next_pid = 0\n        self._next_aid = 0\n        self._answered = False\n\n    @property\n    def budget_left(self):\n        return self.budget - self._nfe\n\n    @property\n    def nfe_used(self):\n        return self._nfe\n\n    def _charge(self, cost):\n        if self._nfe + cost > self.budget:\n            raise BudgetExceededError()\n        self._nfe += cost\n\n    def spawn(self, n):\n        if n <= 0:\n            raise InvalidActionError()\n        ids = []\n        for _ in range(n):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = _P(id=pid, quality=0.55 + 0.02 * pid)\n            ids.append(pid)\n        return ids\n\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        p = self._particles[particle_id]\n        if p.status \"'!= '\"'active':\n            raise InvalidActionError()\n        if target_time <= p.time:\n            raise InvalidActionError()\n        steps = sum(