{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.env import FlowTTSEnv\n\nclass ToyModel:\n    def velocity(self, z, t, condition=None):\n        return tuple(-0.25 * x + 0.15 * (i + 1) for i, x in enumerate(z))\n\nclass ToyScorer:\n    def score(self, z1_hat, condition=None):\n        target = (0.8, -0.2, 0.5, 0.1)\n        err = sum((a - b) ** 2 for a, b in zip(z1_hat, target))\n        score = 1.0 / (1.0 + err)\n        return score, {\\\"toy\\\": score}\n\ncontroller = OptimalController()\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FlowTTSEnv(\n        model=ToyModel(),\n        vae=None,\n        scorer=ToyScorer(),\n        prompt=\\\"p\\\",\n        budget=64,\n        time_grid=[i / 10 for i in range(11)],\n        seed=7,\n        latent_shape=(4,),\n    )\n    answer = controller.solve(env, beta)\n    print(beta, answer.nfe_used, answer.rule, len(env.get_state().previews), len(env.get_state().particles))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
