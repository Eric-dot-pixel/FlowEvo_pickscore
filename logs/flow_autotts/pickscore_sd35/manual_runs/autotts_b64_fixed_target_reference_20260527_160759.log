{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, ParticleSummary, PreviewRecord\n\nclass P:\n    def __init__(self, pid, time=0.0, status='active', parent_id=None, source_anchor_id=None):\n        self.id = pid\n        self.time = time\n        self.status = status\n        self.parent_id = parent_id\n        self.source_anchor_id = source_anchor_id\n        self.last_preview_id = None\n        self.nfe_used = 0\n        self.num_children = 0\n\nclass FakeEnv:\n    def __init__(self, budget=64):\n        self.time_grid = tuple(i / 10 for i in range(11))\n        self.budget = budget\n        self._nfe = 0\n        self._next_pid = 0\n        self._next_aid = 0\n        self._particles = {}\n        self._previews = {}\n    @property\n    def budget_left(self):\n        return self.budget - self._nfe\n    def spawn(self, n):\n        if n <= 0:\n            raise InvalidActionError('spawn')\n        out = []\n        for _ in range(n):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = P(pid)\n            out.append(pid)\n        return out\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        p = self._particles[particle_id]\n        if p.status \"'!= '\"'active':\n            raise InvalidActionError('inactive')\n        if target_time <= p.time:\n            raise InvalidActionError('non-advancing')\n        cost = sum(1 for t in self.time_grid if p.time < t <= target_time + 1e-9)\n        if self._nfe + cost > self.budget:\n            raise BudgetExceededError()\n        self._nfe += cost\n        p.nfe_used += cost\n        p.time = target_time\n        if p.time >= 1.0 - 1e-9:\n            p.status = 'completed'\n        return self.get_state().particles[particle_id]\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p = self._particles[particle_id]\n        if p.status == 'pruned':\n            raise InvalidActionError('pruned')\n        if self._nfe + 1 > self.budget:\n            raise BudgetExceededError()\n        self._nfe += 1\n        p.nfe_used += 1\n        aid = self._next_aid\n        self._next_aid += 1\n        score = 0.5 + 0.25 * p.time - 0.015 * particle_id + (0.005 if particle_id % 2 == 0 else -0.003)\n        uncertainty = max(0.0, 0.24 - 0.16 * p.time + (0.02 if particle_id % 3 == 1 else 0.0))\n        preview = PreviewRecord(\n            id=aid,\n            particle_id=particle_id,\n            time=p.time,\n            score=score,\n            uncertainty=uncertainty,\n            drift=max(0.0, 1.0 - p.time),\n        )\n        self._previews[aid] = preview\n        p.last_preview_id = aid\n        return preview\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        if num_children <= 0:\n            raise InvalidActionError('children')\n        anchor = self._previews[anchor_id]\n        out = []\n        for _ in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = P(pid, time=target_time, status='completed' if target_time >= 1.0 else 'active', parent_id=anchor.particle_id, source_anchor_id=anchor_id)\n            out.append(pid)\n        return out\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            p = self._particles[pid]\n            if p.status == 'completed':\n                raise InvalidActionError('completed')\n            p.status = 'pruned'\n    def answer(self, rule='best_preview_score'):\n        if rule == 'best_preview_score' and self._previews:\n            best = max(self._previews.values(), key=lambda x: x.score)\n            return AnswerRecord(best.particle_id, best.id, (), best.score, self._nfe, rule, [], {'pickscore': best.score})\n        live = [p for p in self._particles.values() if p.status in {'active', 'completed'}]\n        pid = max(live, key=lambda x: (x.time, x.id)).id if live else None\n        return AnswerRecord(pid, None, (), None, self._nfe, rule, [], {})\n    def get_state(self):\n        active = [pid for pid, p in self._particles.items() if p.status == 'active']\n        completed = [pid for pid, p in self._particles.items() if p.status == 'completed']\n        pruned = [pid for pid, p in self._particles.items() if p.status == 'pruned']\n        return ControllerState(\n            prompt='x',\n            budget_left=self.budget_left,\n            active_particle_ids=active,\n            completed_particle_ids=completed,\n            pruned_particle_ids=pruned,\n            particles={pid: ParticleSummary(pid, p.time, p.parent_id, p.source_anchor_id, p.nfe_used, p.status, p.last_preview_id, p.num_children) for pid, p in self._particles.items()},\n            previews=dict(self._previews),\n            event_log=[],\n        )\n\ncontroller = OptimalController()\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FakeEnv(64)\n    answer = controller.solve(env, beta)\n    print({'beta': beta, 'nfe': env.budget - env.budget_left, 'rule': answer.rule, 'preview_id': answer.preview_id})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, ParticleSummary, PreviewRecord\n\nclass P:\n    def __init__(self, pid, time=0.0, status='active', parent_id=None, source_anchor_id=None):\n        self.id = pid\n        self.time = time\n        self.status = status\n        self.parent_id = parent_id\n        self.source_anchor_id = source_anchor_id\n        self.last_preview_id = None\n        self.nfe_used = 0\n        self.num_children = 0\n\nclass FakeEnv:\n    def __init__(self, budget=64):\n        self.time_grid = tuple(i / 10 for i in range(11))\n        self.budget = budget\n        self._nfe = 0\n        self._next_pid = 0\n        self._next_aid = 0\n        self._particles = {}\n        self._previews = {}\n    @property\n    def budget_left(self):\n        return self.budget - self._nfe\n    def spawn(self, n):\n        if n <= 0:\n            raise InvalidActionError('spawn')\n        out = []\n        for _ in range(n):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = P(pid)\n            out.append(pid)\n        return out\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        p = self._particles[particle_id]\n        if p.status \"'!= '\"'active':\n            raise InvalidActionError('inactive')\n        if target_time <= p.time:\n            raise InvalidActionError('non-advancing')\n        cost = sum(1 for t in self.time_grid if p.time < t <= target_time + 1e-9)\n        if self._nfe + cost > self.budget:\n            raise BudgetExceededError()\n        self._nfe += cost\n        p.nfe_used += cost\n        p.time = target_time\n        if p.time >= 1.0 - 1e-9:\n            p.status = 'completed'\n        return self.get_state().particles[particle_id]\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p = self._particles[particle_id]\n        if p.status == 'pruned':\n            raise InvalidActionError('pruned')\n        if self._nfe + 1 > self.budget:\n            raise BudgetExceededError()\n        self._nfe += 1\n        p.nfe_used += 1\n        aid = self._next_aid\n        self._next_aid += 1\n        score = 0.5 + 0.25 * p.time - 0.015 * particle_id + (0.005 if particle_id % 2 == 0 else -0.003)\n        uncertainty = max(0.0, 0.24 - 0.16 * p.time + (0.02 if particle_id % 3 == 1 else 0.0))\n        preview = PreviewRecord(\n            id=aid,\n            particle_id=particle_id,\n            time=p.time,\n            score=score,\n            uncertainty=uncertainty,\n            drift=max(0.0, 1.0 - p.time),\n        )\n        self._previews[aid] = preview\n        p.last_preview_id = aid\n        return preview\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        if num_children <= 0:\n            raise InvalidActionError('children')\n        anchor = self._previews[anchor_id]\n        out = []\n        for _ in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = P(pid, time=target_time, status='completed' if target_time >= 1.0 else 'active', parent_id=anchor.particle_id, source_anchor_id=anchor_id)\n            out.append(pid)\n        return out\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            p = self._particles[pid]\n            if p.status == 'completed':\n                raise InvalidActionError('completed')\n            p.status = 'pruned'\n    def answer(self, rule='best_preview_score'):\n        if rule == 'best_preview_score' and self._previews:\n            best = max(self._previews.values(), key=lambda x: x.score)\n            return AnswerRecord(best.particle_id, best.id, (), best.score, self._nfe, rule, [], {'pickscore': best.score})\n        live = [p for p in self._particles.values() if p.status in {'active', 'completed'}]\n        pid = max(live, key=lambda x: (x.time, x.id)).id if live else None\n        return AnswerRecord(pid, None, (), None, self._nfe, rule, [], {})\n    def get_state(self):\n        active = [pid for pid, p in self._particles.items() if p.status == 'active']\n        completed = [pid for pid, p in self._particles.items() if p.status == 'completed']\n        pruned = [pid for pid, p in self._particles.items() if p.status == 'pruned']\n        return ControllerState(\n            prompt='x',\n            budget_left=self.budget_left,\n            active_particle_ids=active,\n            completed_particle_ids=completed,\n            pruned_particle_ids=pruned,\n            particles={pid: ParticleSummary(pid, p.time, p.parent_id, p.source_anchor_id, p.nfe_used, p.status, p.last_preview_id, p.num_children) for pid, p in self._particles.items()},\n            previews=dict(self._previews),\n            event_log=[],\n        )\n\ncontroller = OptimalController()\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FakeEnv(64)\n    answer = controller.solve(env, beta)\n    print({'beta': beta, 'nfe': env.budget - env.budget_left, 'rule': answer.rule, 'preview_id': answer.preview_id})\nPY\"","aggregated_output":"{'beta': 0.0, 'nfe': 10, 'rule': 'best_preview_score', 'preview_id': 2}\n{'beta': 0.25, 'nfe': 20, 'rule': 'best_preview_score', 'preview_id': 6}\n{'beta': 0.5, 'nfe': 36, 'rule': 'best_preview_score', 'preview_id': 7}\n{'beta': 0.75, 'nfe': 47, 'rule': 'best_preview_score', 'preview_id': 8}\n{'beta': 1.0, 'nfe': 64, 'rule': 'best_preview_score', 'preview_id': 10}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_32","type":"agent_message","text":"Implemented the controller in [optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/optimal.py). The policy is a beta-scheduled `scout -> commit -> rival continuation -> optional backward repair -> late fill` controller. The main new mechanism is ambiguity-aware rival continuation: when the top two previews are close or uncertain, it spends extra budget pushing both rivals later before using `backward`, instead of collapsing early onto one trunk. That directly targets the current weak `beta=0.5` regime and secondarily repairs slight underuse at `0.75` and `1.0`.\n\nI inspected the injected baseline target table in the context pack, the latest frontier rows for `r0003`, the comparison rows for `r0002`, the regression ledger, beta opportunities, rejected `r0001` notes, and the named snapshots for `r0003` and `r0002`. The latest compact numbers I used were:\n- `beta=0.00`: `r0003` reward `0.787971`, NFE `10.0`, above baseline `0.676462`\n- `beta=0.25`: `r0003` reward `0.817857`, NFE `20.0`, above baseline `0.802083`\n- `beta=0.50`: `r0003` reward `0.832135`, NFE `36.0`, below baseline `0.836650`, weaker than prior `r0000=0.839043`\n- `beta=0.75`: `r0003` reward `0.840608`, NFE `46.64`, below baseline `0.843990`\n- `beta=1.00`: `r0003` reward `0.843447`, NFE `63.0`, below baseline `0.847290`\n\nThe exact beta schedule is monotone in willingness to spend:\n- `beta=0.00`: target `10`, roots `2`, keep `1`, no repair, stop floor `10`\n- `beta=0.25`: target `20`, roots `4`, keep `2->1`, no repair, up to `2` rival rounds, stop floor `18`\n- `beta=0.50`: target `36`, roots `5`, keep `3->2`, `1` repair child, rival time `0.9`, stop floor `35`\n- `beta=0.75`: target `48`, roots `5`, `1` SDE scout, keep `3->3`, `1` repair child, stop floor `47`\n- `beta=1.00`: target `64`, roots `6`, `1` SDE scout, keep `4->4`, `3` rival rounds, `1` repair child, stop floor `63`\nMonotonicity comes from nondecreasing target NFE, wider scouting, less aggressive pruning, more rival continuation, and later stopping as beta rises. `beta=1.0` cannot exceed `64` because `_target_nfe` caps at `64` and every spend goes through `_can_spend`, which enforces `spent + extra_cost <= target_nfe <= env.budget`.\n\nWhat is behaviorally new relative to the recent best controller:\n- It does not go straight from scout/commit into a mostly single-trunk tail.\n- It explicitly preserves and deepens the top two rivals when preview evidence is ambiguous.\n- `backward` is delayed until after rival confirmation, so refinement is used as local repair rather than primary allocation.\n- The late fill step prefers the runner-up first when score gap is tiny or uncertainty is still elevated.\n\nChecks run:\n- `python -m py_compile flow_autotts/controllers/optimal.py`\n- A small fake-env dry run over `beta in {0, 0.25, 0.5, 0.75, 1.0}` to verify contract compliance and capped spending.\nObserved fake-env NFEs were `10, 20, 36, 47, 64`.\n\nTarget-NFE reflection:\n- `beta=0.00`, target `10`: underuse not acceptable here because this run locks beta 0 to `10`; schedule is set to hit `10`.\n- `beta=0.25`, target `20`: prior controller already matched target and beat baseline; I kept this near-identical regime, with rival confirmation only if evidence is weak.\n- `beta=0.50`, target `36`: this was the main weak beta. Prior issue looked like poor allocation, not underuse. I adjusted policy to spend the full regime on two-rival evidence before repair; fake-env hit `36`.\n- `beta=0.75`, target `48`: prior issue included mild underuse. I raised the stop floor and kept three survivors longer; expected to land near `48` rather than stopping around `46-47`.\n- `beta=1.00`, target `64`: prior issue included underuse and slight regression. I increased survivor count after commit and raised the stop floor so the controller keeps spending when ambiguity remains; fake-env reached `64`, and the hard cap is enforced by `_can_spend`.\n\nExpected risks:\n- `beta=0.50` could still lose if rival continuation just burns budget on two mediocre branches; that is the main tradeoff for the intended repair.\n- `beta=0.75/1.0` may still trail baseline if PickScore previews are already reliable enough that extra rival confirmation is redundant.\n- SDE scouting remains tightly bounded to high beta only, to avoid repeating the rejected “more preview/backward without better ranking” pattern.\n\nThe proposal is mainly meant to improve `beta=0.50` first, and then `0.75/1.0`, while protecting the already-strong `0.00` and `0.25` regimes."}}
