ew(self, particle_id, mode='clean_anchor', scorer='default'):\n        p = self._particles[particle_id]\n        if p.status == 'pruned':\n            raise InvalidActionError()\n        self._charge(1)\n        aid = self._next_aid\n        self._next_aid += 1\n        score = 0.55 + 0.15 * p.time + 0.01 * ((particle_id % 5) - 2) - 0.002 * aid\n        uncertainty = max(0.0, 1.0 - p.time)\n        rec = PreviewRecord(id=aid, particle_id=particle_id, time=p.time, score=score, uncertainty=uncertainty)\n        self._previews[aid] = rec\n        p.last_preview_id = aid\n        p.nfe_used += 1\n        return rec\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        if num_children <= 0:\n            raise InvalidActionError()\n        parent = self._previews[anchor_id].particle_id\n        out = []\n        for _ in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = P(pid, target_time, parent_id=parent, source_anchor_id=anchor_id)\n            out.append(pid)\n        self._particles[parent].num_children += num_children\n        return out\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            p = self._particles[pid]\n            if p.status == 'completed':\n                raise InvalidActionError()\n            p.status = 'pruned'\n    def get_state(self):\n        active = [pid for pid, p in self._particles.items() if p.status == 'active']\n        completed = [pid for pid, p in self._particles.items() if p.status == 'completed']\n        pruned = [pid for pid, p in self._particles.items() if p.status == 'pruned']\n        return ControllerState(\n            prompt='x',\n            budget_left=self.budget_left,\n            active_particle_ids=active,\n            completed_particle_ids=completed,\n            pruned_particle_ids=pruned,\n            particles={pid: ParticleSummary(id=p.id, time=p.time, parent_id=p.parent_id, source_anchor_id=p.source_anchor_id, nfe_used=p.nfe_used, status=p.status, last_preview_id=p.last_preview_id, num_children=p.num_children) for pid, p in self._particles.items()},\n            previews=dict(self._previews),\n            event_log=[],\n        )\n    def answer(self, rule='best_preview_score'):\n        if rule == 'best_preview_score' and self._previews:\n            best = max(self._previews.values(), key=lambda x: x.score)\n            return AnswerRecord(particle_id=best.particle_id, preview_id=best.id, latent=(), reward=best.score, nfe_used=self._nfe, rule=rule, event_log=[], score_dict={})\n        live = [p for p in self._particles.values() if p.status in {'active', 'completed'}]\n        if not live:\n            return AnswerRecord(particle_id=None, preview_id=None, latent=(), reward=None, nfe_used=self._nfe, rule=rule, event_log=[], score_dict={})\n        best = max(live, key=lambda p: (p.time, -p.id))\n        if best.status == 'active':\n            self.forward(best.id, 1.0)\n            best = self._particles[best.id]\n        return AnswerRecord(particle_id=best.id, preview_id=best.last_preview_id, latent=(), reward=0.0, nfe_used=self._nfe, rule=rule, event_log=[], score_dict={})\n\ncontroller = OptimalController()\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FakeEnv(64)\n    ans = controller.solve(env, beta)\n    print(beta, ans.nfe_used)\nPY\"","aggregated_output":"0.0 10\n0.25 20\n0.5 36\n0.75 48\n1.0 64\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_34","type":"agent_message","text":"Implemented a new staged controller in [optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/optimal.py). The idea is: spend each beta’s budget in three phases, `warm preview search -> adaptive survivor selection/pruning -> selective backward refinement + late confirmation`, with all spending bounded by a beta-matched target NFE.\n\n**What I inspected**\n\n- `flow_tts_controller_implementation_spec.md`\n- the round-0 context pack at `.../context_pack.md`\n- [optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/optimal.py) and [baselines.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/baselines.py)\n- `flow_autotts/core/errors.py`, `flow_autotts/core/state.py`, and the targeted public-action parts of `flow_autotts/experiments/pickscore_sd35/env.py`\n\nThere was no prior round history in this workflow. The only compact reward/NFE rows available were the injected ODE baseline targets:\n- `beta=0.00`: reward `0.676462`, target NFE `10`\n- `beta=0.25`: reward `0.802083`, target NFE `20`\n- `beta=0.50`: reward `0.836650`, target NFE `36`\n- `beta=0.75`: reward `0.843990`, target NFE `48`\n- `beta=1.00`: reward `0.847290`, target NFE `64`\n\n**Behaviorally new vs the template controller**\n\nThe old template was basically `finish one root -> maybe add more completed roots -> late backward from best preview`. This proposal adds two nontrivial mechanisms:\n\n- Adaptive survivor selection from preview evidence: early warm previews decide how many roots survive based on score gap and uncertainty, not a fixed keep count.\n- Selective refinement allocation: backward children are allocated only to anchors still close to the leader, with a switch between `mixed_noise` local repair and one `fresh_noise` explore child when top anchors are tightly tied.\n\nThat changes where compute goes: less blind full completion, more preview-guided allocation.\n\n**Exact beta schedule**\n\nTarget NFE is interpolated through the fixed curve `{0.0:10, 0.25:20, 0.5:36, 0.75:48, 1.0:64}` and capped by `env.budget`. Higher beta monotonically increases willingness to spend because target NFE, roots, confirmations, kept diversity, and child budget all increase or stay flat.\n\nCritical schedule:\n- `beta <= 0.0`: deterministic one-root finish to `t=1`, no preview/refinement, intended 10 NFE exactly.\n- `roots`: `<0.18 -> 1`, `<0.56 -> 2`, `<0.9 -> 3`, otherwise `4`\n- `warm_time`: `<0.2 -> 0.6`, `<0.6 -> 0.5`, otherwise `0.4`\n- `refine_time`: `<0.35 -> 0.84`, `<0.75 -> 0.72`, otherwise `0.6`\n- `base_keep`: `<0.5 -> 1`, otherwise `2`\n- `max_keep`: `<0.45 -> 1`, `<0.9 -> 2`, otherwise `3`\n- `confirm_slots`: `0` at `beta=0`, then `1`, `2`, `3` as beta rises\n- `max_children`: `<0.28 -> 0`, `<0.45 -> 1`, `<0.7 -> 2`, `<0.9 -> 3`, otherwise `4`\n- `children_per_anchor`: `<0.7 -> 1`, otherwise `2`\n\nWhy monotonic:\n- higher beta gets more width;\n- earlier warm/refine times make continuation from children more expensive and more exploratory;\n- confirmations never decrease;\n- refinement children never decrease;\n- every action is gated by `_reserve(...)`, so spending rises with beta but does not overshoot the target cap.\n\n**Target-NFE reflection**\n\nI did revise the first draft after a dry run because it was underusing at `beta=0`, `0.5`, `0.75`, and `1.0`. The final fake-env dry run hit the intended schedule exactly: `10 / 20 / 36 / 48 / 64`.\n\nPer beta:\n- `beta=0.00`, target `10`: initial underuse was not justified; I added an explicit deterministic branch so it now uses the locked 10-NFE regime directly.\n- `beta=0.25`, target `20`: underuse did not appear after the staged search; one warm preview pass plus one full completion and light confirmation is expected to stay close.\n- `beta=0.50`, target `36`: initial underuse came from too few refinement children; I increased child budget so mid-beta can spend on selective local repair rather than stopping early.\n- `beta=0.75`, target `48`: initial underuse was also conservative child allocation; I raised refinement capacity and kept late confirmations so it can spend near target while preserving diversity.\n- `beta=1.00`, target `64`: I increased roots/confirmations/refinement capacity, but every action checks `_reserve(...)` against `min(env.budget, target_nfe)`, so it should stay at or below 64. There is no path that intentionally calls `answer(rule=\"latest_active\")` from the normal branch, which avoids implicit completion overspend.\n\n**Checks run**\n\n- `python -m py_compile flow_autotts/controllers/optimal.py`\n- a tiny fake-env dry run over `beta in [0.0, 0.25, 0.5, 0.75, 1.0]`\n\nThe fake-env run produced NFE `10, 20, 36, 48, 64`.\n\n**Risks and intended improvement region**\n\nMain target is the weak mid-budget regime that the template would likely waste by fully finishing weak roots before gathering evidence. This proposal is meant to improve `beta=0.5` and `beta=0.75` most, while protecting `beta=0` with disciplined deterministic behavior and keeping `beta=1` safely under the hard 64 cap.\n\nMain risk is that early warm previews at `t=0.4/0.5/0.6` may still be noisy for some prompts, so adaptive pruning could occasionally prune a branch too early. I mitigated that by keeping extra survivors when the top gap is small or uncertainty is high, and by using broader `fresh_noise` exploration only in tie-like high-beta cases."}}
