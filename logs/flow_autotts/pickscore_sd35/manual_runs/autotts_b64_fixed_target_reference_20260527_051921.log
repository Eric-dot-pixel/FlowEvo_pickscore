{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' flow_autotts/core/state.py\"","aggregated_output":"\"\"\"Public state records exposed to controllers and evaluators.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom typing import Any, Literal\n\n\nParticleStatus = Literal[\"active\", \"completed\", \"pruned\"]\n\n\n@dataclass(frozen=True)\nclass ParticleSummary:\n    id: int\n    time: float\n    parent_id: int | None\n    source_anchor_id: int | None\n    nfe_used: int\n    status: ParticleStatus\n    last_preview_id: int | None\n    num_children: int\n\n\n@dataclass(frozen=True)\nclass PreviewRecord:\n    id: int\n    particle_id: int\n    time: float\n    score: float | None\n    score_dict: dict[str, float] = field(default_factory=dict)\n    uncertainty: float | None = None\n    drift: float | None = None\n    embedding_ref: str | None = None\n\n\n@dataclass(frozen=True)\nclass EventRecord:\n    step_id: int\n    action: str\n    particle_ids: list[int]\n    input_time: float | None\n    output_time: float | None\n    nfe_cost: int\n    budget_left: int\n    details: dict[str, Any] = field(default_factory=dict)\n\n\n@dataclass(frozen=True)\nclass ControllerState:\n    prompt: str\n    budget_left: int\n    active_particle_ids: list[int]\n    completed_particle_ids: list[int]\n    pruned_particle_ids: list[int]\n    particles: dict[int, ParticleSummary]\n    previews: dict[int, PreviewRecord]\n    event_log: list[EventRecord]\n\n\n@dataclass(frozen=True)\nclass AnswerRecord:\n    particle_id: int | None\n    preview_id: int | None\n    latent: tuple[float, ...]\n    reward: float | None\n    nfe_used: int\n    rule: str\n    event_log: list[EventRecord]\n    score_dict: dict[str, float] = field(default_factory=dict)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '261,520p' flow_autotts/controllers/optimal.py\"","aggregated_output":"            for child_id in child_ids:\n                preview = self._advance_and_preview(env, child_id, target_time=1.0, solver=\"euler\")\n                if preview is None:\n                    return\n                children_made += 1\n                if children_made >= max_children:\n                    break\n\n            self._prune_weak_active(env, schedule)\n\n    def _late_fill(\n        self,\n        env: FlowTTSEnv,\n        target_nfe: int,\n        schedule: dict[str, float | int],\n    ) -> None:\n        late_previews = 0\n        limit = int(schedule[\"late_preview_limit\"])\n        while late_previews < limit and self._reserve(env, target_nfe, needed=1):\n            ranked = self._ranked_previews(env)\n            if not ranked:\n                return\n            particle_id = self._late_fill_candidate(env, ranked)\n            if particle_id is None:\n                return\n            try:\n                env.preview(particle_id, mode=\"clean_anchor\", scorer=\"default\")\n            except (BudgetExceededError, InvalidActionError):\n                return\n            late_previews += 1\n\n    def _late_fill_candidate(\n        self,\n        env: FlowTTSEnv,\n        ranked: list[PreviewRecord],\n    ) -> int | None:\n        state = env.get_state()\n        for preview in ranked[:3]:\n            particle = state.particles.get(preview.particle_id)\n            if particle is None or particle.status == \"pruned\":\n                continue\n            if preview.time >= 0.99:\n                return preview.particle_id\n        for particle_id in state.active_particle_ids:\n            return particle_id\n        return None\n\n    def _eligible_refine_anchors(\n        self,\n        ranked: list[PreviewRecord],\n        schedule: dict[str, float | int],\n    ) -> list[PreviewRecord]:\n        if not ranked:\n            return []\n        best = float(ranked[0].score or 0.0)\n        limit = max(1, int(schedule[\"max_keep\"]))\n        anchors: list[PreviewRecord] = []\n        for preview in ranked[:limit]:\n            gap = best - float(preview.score or 0.0)\n            if gap <= float(schedule[\"prune_gap\"]) or preview is ranked[0]:\n                anchors.append(preview)\n        return anchors\n\n    def _prune_weak_active(\n        self,\n        env: FlowTTSEnv,\n        schedule: dict[str, float | int],\n    ) -> None:\n        ranked = self._ranked_previews(env)\n        if len(ranked) < 2:\n            return\n\n        best = float(ranked[0].score or 0.0)\n        survivors = {\n            preview.particle_id\n            for preview in ranked\n            if best - float(preview.score or 0.0) <= float(schedule[\"prune_gap\"])\n        }\n        if len(survivors) < int(schedule[\"base_keep\"]):\n            survivors.update(preview.particle_id for preview in ranked[: int(schedule[\"base_keep\"])])\n\n        state = env.get_state()\n        prune_ids: list[int] = []\n        for particle_id in state.active_particle_ids:\n            if particle_id not in survivors:\n                prune_ids.append(particle_id)\n        if prune_ids:\n            try:\n                env.prune(prune_ids)\n            except InvalidActionError:\n                pass\n\n    def _ranked_previews(\n        self,\n        env: FlowTTSEnv,\n        particle_ids: list[int] | None = None,\n    ) -> list[PreviewRecord]:\n        state = env.get_state()\n        allowed = None if particle_ids is None else set(particle_ids)\n        previews = [\n            preview\n            for preview in state.previews.values()\n            if preview.score is not None\n            and preview.particle_id in state.particles\n            and state.particles[preview.particle_id].status != \"pruned\"\n            and (allowed is None or preview.particle_id in allowed)\n        ]\n        return sorted(\n            previews,\n            key=lambda preview: (\n                float(preview.score),\n                -float(preview.uncertainty or 0.0),\n                float(preview.time),\n                -int(preview.id),\n            ),\n            reverse=True,\n        )\n\n    def _child_bundle_cost(self, env: FlowTTSEnv, target_time: float, num_children: int) -> int:\n        per_child = self._move_cost(env, target_time, 1.0) + 1\n        return max(1, num_children * per_child)\n\n    def _move_cost(self, env: FlowTTSEnv, start_time: float, target_time: float) -> int:\n        start = self._time_to_step(env, start_time)\n        end = self._time_to_step(env, target_time)\n        return max(0, end - start)\n\n    def _time_to_step(self, env: FlowTTSEnv, time_value: float) -> int:\n        if not env.time_grid:\n            return 0\n        time_value = min(max(float(time_value), 0.0), 1.0)\n        best_index = 0\n        for index, point in enumerate(env.time_grid):\n            if float(point) + 1e-9 >= time_value:\n                best_index = index\n                break\n            best_index = index\n        return best_index\n\n    def _reserve(self, env: FlowTTSEnv, target_nfe: int, needed: int) -> bool:\n        if needed <= 0:\n            return True\n        spent = int(env.budget) - int(env.budget_left)\n        return spent + int(needed) <= min(int(env.budget), int(target_nfe))\n\n    def _top_gap(self, ranked: list[PreviewRecord]) -> float:\n        if len(ranked) < 2:\n            return 1.0\n        return float(ranked[0].score or 0.0) - float(ranked[1].score or 0.0)\n\n    def _safe_answer(self, env: FlowTTSEnv) -> AnswerRecord:\n        try:\n            return env.answer(rule=\"best_preview_score\")\n        except (BudgetExceededError, InvalidActionError):\n            return env.answer(rule=\"latest_active\")\n\n    def _clamp_beta(self, beta: float) -> float:\n        return min(max(float(beta), 0.0), 1.0)\n\n    def _interpolate(self, beta: float, curve: dict[float, int]) -> float:\n        keys = sorted(curve)\n        if beta <= keys[0]:\n            return float(curve[keys[0]])\n        if beta >= keys[-1]:\n            return float(curve[keys[-1]])\n        for left, right in zip(keys, keys[1:]):\n            if left <= beta <= right:\n                width = right - left\n                if width <= 0:\n                    return float(curve[right])\n                alpha = (beta - left) / width\n                return float(curve[left]) + alpha * float(curve[right] - curve[left])\n        return float(curve[keys[-1]])\n","exit_code":0,"status":"completed"}}
