{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, ParticleSummary, PreviewRecord\n\n@dataclass\nclass P:\n    id: int\n    step: int\n    status: str = 'active'\n    parent_id: int | None = None\n    source_anchor_id: int | None = None\n    last_preview_id: int | None = None\n    num_children: int = 0\n    nfe_used: int = 0\n\n@dataclass\nclass A:\n    id: int\n    particle_id: int\n    step: int\n    score: float\n    uncertainty: float\n    drift: float\n\nclass StepEnv:\n    def __init__(self, budget=64, steps=10):\n        self.budget = budget\n        self._nfe = 0\n        self.time_grid = tuple(i / steps for i in range(steps + 1))\n        self._steps = steps\n        self._next_pid = 0\n        self._next_aid = 0\n        self._particles = {}\n        self._anchors = {}\n        self.log = []\n    @property\n    def budget_left(self):\n        return self.budget - self._nfe\n    def _charge(self, c):\n        if self._nfe + c > self.budget:\n            raise BudgetExceededError\n        self._nfe += c\n    def spawn(self, n):\n        ids = []\n        for _ in range(n):\n            pid = self._next_pid; self._next_pid += 1\n            self._particles[pid] = P(id=pid, step=0)\n            ids.append(pid)\n        self.log.append(('spawn', ids, self._nfe))\n        return ids\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        p = self._particles[particle_id]\n        target_step = min(self._steps, max(0, int(round(target_time * self._steps))))\n        if p.status \"'!= '\"'active' or target_step <= p.step: raise InvalidActionError\n        cost = target_step - p.step\n        self._charge(cost)\n        self.log.append(('forward', particle_id, p.step, target_step, self._nfe))\n        p.step = target_step\n        p.nfe_used += cost\n        if p.step >= self._steps: p.status = 'completed'\n        return self.get_state().particles[particle_id]\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p = self._particles[particle_id]\n        self._charge(1)\n        score = 0.6 + 0.02 * p.step - 0.03 * (p.id % 4) + 0.005 * ((p.id // 2) % 3)\n        uncertainty = max(0.0, 1.0 - p.step / self._steps)\n        drift = max(0.0, 0.9 - 0.08 * p.step + 0.03 * (p.id % 2))\n        aid = self._next_aid; self._next_aid += 1\n        self._anchors[aid] = A(aid, particle_id, p.step, score, uncertainty, drift)\n        p.last_preview_id = aid\n        self.log.append(('preview', particle_id, p.step, round(score,3), self._nfe))\n        return self.get_state().previews[aid]\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        a = self._anchors[anchor_id]\n        target_step = min(self._steps, max(0, int(round(target_time * self._steps))))\n        ids = []\n        for _ in range(num_children):\n            pid = self._next_pid; self._next_pid += 1\n            status = 'completed' if target_step >= self._steps else 'active'\n            self._particles[pid] = P(id=pid, step=target_step, status=status, parent_id=a.particle_id, source_anchor_id=a.id)\n            ids.append(pid)\n        self._particles[a.particle_id].num_children += num_children\n        self.log.append(('backward', anchor_id, ids, target_step, noise_policy, self._nfe))\n        return ids\n    def prune(self, particle_ids):\n        for pid in particle_ids: self._particles[pid].status='pruned'\n        self.log.append(('prune', particle_ids, self._nfe))\n    def answer(self, rule='best_preview_score'):\n        self.log.append(('answer', rule, self._nfe))\n        if rule == 'best_preview_score' and self._anchors:\n            best = max(self._anchors.values(), key=lambda a: a.score)\n            return AnswerRecord(best.particle_id, best.id, (), best.score, self._nfe, rule, [], {'score': best.score})\n        candidates = [p for p in self._particles.values() if p.status in {'active','completed'}]\n        chosen = max(candidates, key=lambda p: (p.step,p.id))\n        if chosen.status == 'active': self.forward(chosen.id, 1.0)\n        reward = 0.6 + 0.02 * self._particles[chosen.id].step - 0.03 * (chosen.id % 4) + 0.005 * ((chosen.id // 2) % 3)\n        return AnswerRecord(chosen.id, chosen.last_preview_id, (), reward, self._nfe, rule, [], {'score': reward})\n    def get_state(self):\n        particles={pid: ParticleSummary(id=p.id,time=p.step/self._steps,parent_id=p.parent_id,source_anchor_id=p.source_anchor_id,nfe_used=p.nfe_used,status=p.status,last_preview_id=p.last_preview_id,num_children=p.num_children) for pid,p in self._particles.items()}\n        previews={aid: PreviewRecord(id=a.id,particle_id=a.particle_id,time=a.step/self._steps,score=a.score,score_dict={'score':a.score},uncertainty=a.uncertainty,drift=a.drift,embedding_ref=None) for aid,a in self._anchors.items()}\n        active=[pid for pid,p in self._particles.items() if p.status=='active']\n        comp=[pid for pid,p in self._particles.items() if p.status=='completed']\n        pruned=[pid for pid,p in self._particles.items() if p.status=='pruned']\n        return ControllerState(prompt='mock',budget_left=self.budget_left,active_particle_ids=active,completed_particle_ids=comp,pruned_particle_ids=pruned,particles=particles,previews=previews,event_log=[])\n\nfor beta in [0.25,0.5,0.75,1.0]:\n    env=StepEnv()\n    ans=OptimalController().solve(env,beta)\n    print('\\\\nBETA',beta,'NFE',ans.nfe_used,'RULE',ans.rule,'REWARD',ans.reward)\n    for item in env.log:\n        print(item)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
