age1_survivors(ranked_stage1, schedule)\n        if not survivors:\n            survivors = [ranked_stage1[0].particle_id]\n        self._prune_particles(env, [pid for pid in root_ids if pid not in set(survivors)])\n\n        ranked_after_stage1 = self._ranked_latest_previews(env)\n        if ranked_after_stage1:\n            self._confirm_if_ambiguous(env, ranked_after_stage1, target_nfe, schedule, phase=\"early\")\n            ranked_after_stage1 = self._ranked_latest_previews(env)\n\n        stage2_ids: list[int] = []\n        for particle_id in survivors:\n            particle = self._particle(env, particle_id)\n            if particle is None or particle.status == \"pruned\":\n                continue\n            needed = self._move_cost(env, particle.time, 1.0)\n            if particle.time < 1.0:\n                needed += 1\n            elif self._needs_latest_preview(env, particle_id):\n                needed += 1\n            if not self._reserve(env, target_nfe, needed):\n                break\n            preview = self._advance_and_preview(\n                env,\n                particle_id,\n                target_time=1.0,\n                solver=\"euler\",\n            )\n            if preview is not None:\n                stage2_ids.append(particle_id)\n\n        ranked_final = self._ranked_latest_previews(env)\n        if not ranked_final:\n            return self._safe_answer(env)\n\n        self._confirm_if_ambiguous(env, ranked_final, target_nfe, schedule, phase=\"late\")\n        ranked_final = self._ranked_latest_previews(env)\n        self._refine_from_ranked(env, ranked_final, target_nfe, schedule)\n        ranked_final = self._ranked_latest_previews(env)\n        self._spend_tail(env, ranked_final, target_nfe, schedule)\n        return self._safe_answer(env)\n\n    def _schedule(self, env: FlowTTSEnv, beta: float) -> dict[str, float | int]:\n        target_curve = {\n            0.0: 10,\n            0.25: 20,\n            0.5: 36,\n            0.75: 48,\n            1.0: 64,\n        }\n        target_nfe = min(int(env.budget), max(1, int(round(self._interpolate(beta, target_curve)))))\n        roots = 1 if beta < 0.18 else 2 if beta < 0.42 else 3 if beta < 0.82 else 4\n        stage1_time = 0.0 if beta < 0.18 else 0.3 if beta < 0.42 else 0.4 if beta < 0.82 else 0.5\n        stage1_steps = self._move_cost(env, 0.0, stage1_time)\n        stage1_cost = stage1_steps + 1\n        stage2_keep = 1 if beta < 0.42 else 2 if beta < 0.82 else 3\n        refine_time = 0.9 if beta < 0.45 else 0.8 if beta < 0.7 else 0.7 if beta < 0.9 else 0.6\n\n        return {\n            \"target_nfe\": target_nfe,\n            \"deterministic_only\": 1 if beta <= 0.0 else 0,\n            \"roots\": min(roots, max(1, target_nfe // max(2, stage1_cost))),\n            \"stage1_time\": stage1_time,\n            \"stage1_cost\": stage1_cost,\n            \"stage1_solver_sde\": 1 if 0.45 <= beta < 0.9 else 0,\n            \"stage1_noise\": 0.02 if beta < 0.7 else 0.015,\n            \"stage2_keep\": stage2_keep,\n            \"stage2_keep_cap\": min(roots, stage2_keep + (1 if beta >= 0.75 else 0)),\n            \"close_gap\": 0.01 if beta < 0.45 else 0.015 if beta < 0.82 else 0.02,\n            \"wide_gap\": 0.04 if beta < 0.45 else 0.05 if beta < 0.82 else 0.06,\n            \"uncertain_threshold\": 0.5 if beta < 0.45 else 0.55 if beta < 0.82 else 0.6,\n            \"early_confirm_slots\": 0 if beta < 0.25 else 1 if beta < 0.75 else 2,\n            \"late_confirm_slots\": 1 if beta < 0.45 else 2 if beta < 0.82 else 3,\n            \"confirm_gap\": 0.012 if beta < 0.45 else 0.018 if beta < 0.82 else 0.024,\n            \"confirm_drift\": 0.42 if beta < 0.45 else 0.35 if beta < 0.82 else 0.28,\n            \"refine_time\": refine_time,\n            \"refine_children\": 0 if beta < 0.45 else 1 if beta < 0.7 else 2 if beta < 0.9 else 3,\n            \"refine_anchor_cap\": 1 if beta < 0.7 else 2,\n            \"refine_gap\": 0.025 if beta < 0.7 else 0.035 if beta < 0.9 else 0.045,\n            \"mixed_strength\": 0.35 if beta < 0.82 else 0.3,\n            \"fresh_child_if_close\": 1 if beta >= 0.75 else 0,\n            \"tail_previews\": 2 if beta < 0.45 else 3 if beta < 0.82 else 5,\n        }\n\n    def _deterministic_finish(self, env: FlowTTSEnv) -> AnswerRecord:\n        try:\n            particle_id = env.spawn(1)[0]\n            particle = self._particle(env, particle_id)\n            if particle is not None and particle.time < 1.0:\n                env.forward(particle_id, target_time=1.0, solver=\"euler\")\n            return env.answer(rule=\"latest_active\")\n        except (BudgetExceededError, InvalidActionError):\n            return env.answer(rule=\"latest_active\")\n\n    def _advance_and_preview(\n        self,\n        env: FlowTTSEnv,\n        particle_id: int,\n        target_time: float,\n        solver: str,\n        cfg: dict[str, float | str] | None = None,\n    ) -> PreviewRecord | None:\n        particle = self._particle(env, particle_id)\n        if particle is None or particle.status == \"pruned\":\n            return None\n        try:\n            if target_time > particle.time:\n                env.forward(particle_id, target_time=target_time, solver=solver, cfg=cfg)\n            elif not self._needs_latest_preview(env, particle_id):\n                return self._latest_preview(env, particle_id)\n            return env.preview(particle_id, mode=\"clean_anchor\", scorer=\"default\")\n        except (BudgetExceededError, InvalidActionError):\n            return None\n\n    def _stage1_solver(self, schedule: dict[str, float | int], particle_id: int) -> str:\n        del particle_id\n        if int(schedule[\"stage1_solver_sde\"]) > 0:\n            return \"sde\"\n        return \"euler\"\n\n    def _stage1_cfg(self, schedule: dict[str, float | int]) -> dict[str, float | str] | None:\n        if int(schedule[\"stage1_solver_sde\"]) <= 0:\n            return None\n        return {\"noise_scale\": float(schedule[\"stage1_noise\"]), \"sde_type\": \"sde\"}\n\n    def _select_stage1_survivors(\n        self,\n        ranked: list[PreviewRecord],\n        schedule: dict[str, float | int],\n    ) -> list[int]:\n        if not ranked:\n            return []\n\n        keep = min(len(ranked), int(schedule[\"stage2_keep\"]))\n        keep_cap = min(len(ranked), int(schedule[\"stage2_keep_cap\"]))\n        top_score = float(ranked[0].score or 0.0)\n        top_uncertainty = float(ranked[0].uncertainty or 0.0)\n\n        for preview in ranked[keep:]:\n            gap = top_score - float(preview.score or 0.0)\n            if gap <= float(schedule[\"close_gap\"]) and keep < keep_cap:\n                keep += 1\n                continue\n            if top_uncertainty >= float(schedule[\"uncertain_threshold\"]) and keep < keep_cap:\n                keep += 1\n                break\n            if gap >= float(schedule[\"wide_gap\"]):\n                break\n\n        return [preview.particle_id for preview in ranked[:keep]]\n\n    def _confirm_if_ambiguous(\n        self,\n        env: FlowTTSEnv,\n        ranked: list[PreviewRecord],\n        target_nfe: int,\n        schedule: dict[str, float | int],\n        phase: str,\n    ) -> None:\n        slots_key = \"early_confirm_slots\" if phase == \"early\" else \"late_confirm_slots\"\n        max_slots = min(len(ranked), int(schedule[slots_key]))\n        if max_slots <= 0:\n            return\n        if len(ranked) == 1 and float(ranked[0].drift or 0.0) < float(schedule[\"confirm_drift\"]):\n            return\n\n        gap = self._top_gap(ranked)\n        top = ranked[0]\n        needs_confirmation = (\n            gap <= float(schedule[\"confirm_gap\"])\n            or float(top.uncertainty or 0.0) >= float(schedule[\"uncertain_threshold\"])\n            or float(top.drift or 0.0) >= float(schedule[\"confirm_drift\"])\n        )\n        if not needs_confirmation:\n            return\n\n        for preview in ranked[:max_slots]:\n            if not self._reserve(env, target_nfe, 1):\n                return\n            particle = self._particle(env, preview.particle_id)\n            if particle is None or particle.status == \"pruned\":\n                continue\n            if particle.time >= 1.0 and not self._needs_latest_preview(env, preview.particle_id):\n                continue\n            try:\n                env.preview(preview.particle_id, mode=\"clean_anchor\", scorer=\"default\")\n            except (BudgetExceededError, InvalidActionError):\n                return\n\n    def _refine_from_ranked(\n        self,\n        env: FlowTTSEnv,\n        ranked: list[PreviewRecord],\n        target_nfe: int,\n        schedule: dict[str, float | int],\n    ) -> None:\n        planned_children = int(schedule[\"refine_children\"])\n        if planned_children <= 0 or not ranked:\n            return\n\n        anchors = self._refine_anchors(ranked, schedule)\n        if not anchors:\n            return\n\n        children_done = 0\n        while children_done < planned_children:\n            ranked = self._ranked_latest_previews(env)\n            if not ranked:\n                return\n            anchors = self._refine_anchors(ranked, schedule)\n            if not anchors:\n                return\n\n            anchor = anchors[children_done % len(anchors)]\n            noise_policy = \"mixed_noise\"\n            strength = float(schedule[\"mixed_strength\"])\n            if (\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_26","type":"agent_message","text":"I’ve isolated the weak spots from the compact history. The accepted controller beats baseline at `beta=0/0.25`, trails at `0.5/0.75/1.0`, and the rejected variants mostly lost by either underspending target NFE or converting budget into extra previews without better selection.\n\nPlan:\n- Keep `beta=0` deterministic and leave low beta nearly unchanged.\n- Replace the current “warm preview, prune, finish, confirm, refine, late fill” with a margin-aware tournament:\n  - warm-preview several roots,\n  - finish top survivors,\n  - finish one challenger reserve only when the warm evidence is close or uncertain,\n  - run backward only after completed previews exist and only when the score gap says local refinement is justified.\n- Add a budget-fill rule that prefers useful tail spend in order: challenger completion, confirm close finalists, then one local child, rather than generic repeated previews.\n- Keep a monotone beta schedule so higher beta means more roots, looser pruning, more challenger/confirmation slots, and more child/refinement willingness, while still reserving against the fixed target NFE ceilings."}}
