{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '260,520p' logs/flow_autotts/pickscore_sd35/history_autotts_b64_fixed_target_reference_20260527_051921/r0001_20260527_051921_793d5c44/flow_autotts/controllers/optimal.py\"","aggregated_output":"            if (\n                int(schedule[\"fresh_child_if_close\"]) > 0\n                and len(anchors) > 1\n                and self._top_gap(ranked) <= float(schedule[\"close_gap\"])\n                and children_done == 0\n            ):\n                noise_policy = \"fresh_noise\"\n                strength = 1.0\n\n            child_cost = self._child_bundle_cost(env, float(schedule[\"refine_time\"]), 1)\n            if not self._reserve(env, target_nfe, child_cost):\n                return\n            try:\n                child_id = env.backward(\n                    anchor.id,\n                    target_time=float(schedule[\"refine_time\"]),\n                    noise_policy=noise_policy,\n                    num_children=1,\n                    strength=strength,\n                )[0]\n            except (BudgetExceededError, InvalidActionError):\n                return\n\n            preview = self._advance_and_preview(env, child_id, target_time=1.0, solver=\"euler\")\n            if preview is None:\n                return\n            children_done += 1\n            self._prune_after_refine(env, ranked, schedule)\n\n    def _spend_tail(\n        self,\n        env: FlowTTSEnv,\n        ranked: list[PreviewRecord],\n        target_nfe: int,\n        schedule: dict[str, float | int],\n    ) -> None:\n        if not ranked:\n            return\n        limit = int(schedule[\"tail_previews\"])\n        used = 0\n        while used < limit and self._reserve(env, target_nfe, 1):\n            ranked = self._ranked_latest_previews(env)\n            if not ranked:\n                return\n            particle_id = self._tail_candidate(env, ranked)\n            if particle_id is None:\n                return\n            try:\n                env.preview(particle_id, mode=\"clean_anchor\", scorer=\"default\")\n            except (BudgetExceededError, InvalidActionError):\n                return\n            used += 1\n\n    def _tail_candidate(self, env: FlowTTSEnv, ranked: list[PreviewRecord]) -> int | None:\n        state = env.get_state()\n        for preview in ranked[:3]:\n            particle = state.particles.get(preview.particle_id)\n            if particle is None or particle.status == \"pruned\":\n                continue\n            if particle.time >= 1.0:\n                return particle.id\n        for particle_id in state.active_particle_ids:\n            return particle_id\n        return None\n\n    def _refine_anchors(\n        self,\n        ranked: list[PreviewRecord],\n        schedule: dict[str, float | int],\n    ) -> list[PreviewRecord]:\n        if not ranked:\n            return []\n        best = float(ranked[0].score or 0.0)\n        cap = min(len(ranked), int(schedule[\"refine_anchor_cap\"]))\n        anchors: list[PreviewRecord] = []\n        for preview in ranked[:cap]:\n            gap = best - float(preview.score or 0.0)\n            if gap <= float(schedule[\"refine_gap\"]) or preview.id == ranked[0].id:\n                anchors.append(preview)\n        return anchors\n\n    def _prune_after_refine(\n        self,\n        env: FlowTTSEnv,\n        ranked_before: list[PreviewRecord],\n        schedule: dict[str, float | int],\n    ) -> None:\n        if len(ranked_before) < 3:\n            return\n        ranked = self._ranked_latest_previews(env)\n        if len(ranked) < 3:\n            return\n        best = float(ranked[0].score or 0.0)\n        keep_floor = max(1, min(len(ranked), int(schedule[\"stage2_keep\"])))\n        survivors = {\n            preview.particle_id\n            for preview in ranked\n            if best - float(preview.score or 0.0) <= float(schedule[\"wide_gap\"])\n        }\n        if len(survivors) < keep_floor:\n            survivors.update(preview.particle_id for preview in ranked[:keep_floor])\n        state = env.get_state()\n        prune_ids = [\n            particle_id\n            for particle_id in state.active_particle_ids\n            if particle_id not in survivors and state.particles[particle_id].time < 1.0\n        ]\n        self._prune_particles(env, prune_ids)\n\n    def _prune_particles(self, env: FlowTTSEnv, particle_ids: list[int]) -> None:\n        if not particle_ids:\n            return\n        try:\n            env.prune(particle_ids)\n        except InvalidActionError:\n            return\n\n    def _ranked_latest_previews(\n        self,\n        env: FlowTTSEnv,\n        particle_ids: list[int] | None = None,\n    ) -> list[PreviewRecord]:\n        state = env.get_state()\n        allowed = None if particle_ids is None else set(particle_ids)\n        latest: list[PreviewRecord] = []\n        for particle in state.particles.values():\n            if particle.status == \"pruned\":\n                continue\n            if allowed is not None and particle.id not in allowed:\n                continue\n            preview_id = particle.last_preview_id\n            if preview_id is None:\n                continue\n            preview = state.previews.get(preview_id)\n            if preview is None or preview.score is None:\n                continue\n            latest.append(preview)\n        return sorted(\n            latest,\n            key=lambda preview: (\n                float(preview.score),\n                -float(preview.uncertainty or 0.0),\n                -float(preview.drift or 0.0),\n                float(preview.time),\n                -int(preview.id),\n            ),\n            reverse=True,\n        )\n\n    def _needs_latest_preview(self, env: FlowTTSEnv, particle_id: int) -> bool:\n        particle = self._particle(env, particle_id)\n        if particle is None or particle.last_preview_id is None:\n            return True\n        preview = env.get_state().previews.get(particle.last_preview_id)\n        if preview is None:\n            return True\n        return float(preview.time) + 1e-9 < float(particle.time)\n\n    def _latest_preview(self, env: FlowTTSEnv, particle_id: int) -> PreviewRecord | None:\n        particle = self._particle(env, particle_id)\n        if particle is None or particle.last_preview_id is None:\n            return None\n        return env.get_state().previews.get(particle.last_preview_id)\n\n    def _child_bundle_cost(self, env: FlowTTSEnv, target_time: float, num_children: int) -> int:\n        per_child = self._move_cost(env, target_time, 1.0) + 1\n        return max(1, int(num_children) * per_child)\n\n    def _move_cost(self, env: FlowTTSEnv, start_time: float, target_time: float) -> int:\n        start = self._time_to_step(env, start_time)\n        end = self._time_to_step(env, target_time)\n        return max(0, end - start)\n\n    def _time_to_step(self, env: FlowTTSEnv, time_value: float) -> int:\n        if not env.time_grid:\n            return 0\n        time_value = min(max(float(time_value), 0.0), 1.0)\n        for index, point in enumerate(env.time_grid):\n            if float(point) + 1e-9 >= time_value:\n                return index\n        return len(env.time_grid) - 1\n\n    def _reserve(self, env: FlowTTSEnv, target_nfe: int, needed: int) -> bool:\n        if needed <= 0:\n            return True\n        spent = int(env.budget) - int(env.budget_left)\n        ceiling = min(int(env.budget), int(target_nfe))\n        return spent + int(needed) <= ceiling\n\n    def _top_gap(self, ranked: list[PreviewRecord]) -> float:\n        if len(ranked) < 2:\n            return 1.0\n        return float(ranked[0].score or 0.0) - float(ranked[1].score or 0.0)\n\n    def _particle(self, env: FlowTTSEnv, particle_id: int) -> ParticleSummary | None:\n        return env.get_state().particles.get(particle_id)\n\n    def _safe_answer(self, env: FlowTTSEnv) -> AnswerRecord:\n        try:\n            return env.answer(rule=\"best_preview_score\")\n        except (BudgetExceededError, InvalidActionError):\n            return env.answer(rule=\"latest_active\")\n\n    def _clamp_beta(self, beta: float) -> float:\n        return min(max(float(beta), 0.0), 1.0)\n\n    def _interpolate(self, beta: float, curve: dict[float, int]) -> float:\n        keys = sorted(curve)\n        if beta <= keys[0]:\n            return float(curve[keys[0]])\n        if beta >= keys[-1]:\n            return float(curve[keys[-1]])\n        for left, right in zip(keys, keys[1:]):\n            if left <= beta <= right:\n                width = right - left\n                if width <= 0:\n                    return float(curve[right])\n                alpha = (beta - left) / width\n                return float(curve[left]) + alpha * float(curve[right] - curve[left])\n        return float(curve[keys[-1]])\n","exit_code":0,"status":"completed"}}
