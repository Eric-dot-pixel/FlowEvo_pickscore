{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass, field\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, EventRecord, ParticleSummary, PreviewRecord\n\n@dataclass\nclass Particle:\n    id: int\n    time: float = 0.0\n    status: str = 'active'\n    last_preview_id: int | None = None\n    num_children: int = 0\n    source_anchor_id: int | None = None\n    parent_id: int | None = None\n    nfe_used: int = 0\n\nclass FakeEnv:\n    def __init__(self, budget=64, steps=10):\n        self.budget = budget\n        self._nfe = 0\n        self.time_grid = tuple(i / steps for i in range(steps + 1))\n        self._particles = {}\n        self._previews = {}\n        self._events = []\n        self._next_pid = 0\n        self._next_aid = 0\n    @property\n    def budget_left(self):\n        return self.budget - self._nfe\n    def spawn(self, n):\n        if n <= 0:\n            raise InvalidActionError('bad spawn')\n        ids = []\n        for _ in range(n):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = Particle(id=pid)\n            ids.append(pid)\n        return ids\n    def _time_to_step(self, t):\n        for i, x in enumerate(self.time_grid):\n            if x + 1e-9 >= t:\n                return i\n        return len(self.time_grid) - 1\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        p = self._particles[particle_id]\n        if p.status \"'!= '\"'active':\n            raise InvalidActionError('inactive')\n        step0 = self._time_to_step(p.time)\n        step1 = self._time_to_step(target_time)\n        cost = max(0, step1 - step0)\n        if self._nfe + cost > self.budget:\n            raise BudgetExceededError()\n        self._nfe += cost\n        p.nfe_used += cost\n        p.time = self.time_grid[step1]\n        if p.time >= 1.0:\n            p.status = 'completed'\n        return self.get_state().particles[particle_id]\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p = self._particles[particle_id]\n        if p.status == 'pruned':\n            raise InvalidActionError('pruned')\n        if self._nfe + 1 > self.budget:\n            raise BudgetExceededError()\n        self._nfe += 1\n        p.nfe_used += 1\n        aid = self._next_aid\n        self._next_aid += 1\n        score = 0.7 + 0.02 * p.time - 0.01 * (particle_id % 3) + 0.001 * aid\n        preview = PreviewRecord(\n            id=aid,\n            particle_id=particle_id,\n            time=p.time,\n            score=score,\n            score_dict={'score': score},\n            uncertainty=max(0.0, 1.0 - p.time),\n            drift=max(0.0, 0.5 - 0.3 * p.time),\n            embedding_ref=None,\n        )\n        self._previews[aid] = preview\n        p.last_preview_id = aid\n        return preview\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        if mask is not None:\n            raise InvalidActionError('mask unsupported')\n        parent_preview = self._previews[anchor_id]\n        parent = self._particles[parent_preview.particle_id]\n        out = []\n        for _ in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = Particle(\n                id=pid,\n                time=max(0.0, target_time),\n                status='completed' if target_time >= 1.0 else 'active',\n                parent_id=parent.id,\n                source_anchor_id=anchor_id,\n            )\n            out.append(pid)\n        parent.num_children += num_children\n        return out\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            p = self._particles[pid]\n            if p.status == 'completed':\n                raise InvalidActionError('cannot prune completed')\n            p.status = 'pruned'\n    def answer(self, rule='best_preview_score'):\n        if rule == 'best_preview_score' and self._previews:\n            best = max(self._previews.values(), key=lambda p: p.score)\n            return AnswerRecord(best.particle_id, best.id, (), best.score, self._nfe, rule, [])\n        live = [p for p in self._particles.values() if p.status in ('active', 'completed')]\n        pid = max(live, key=lambda p: (p.time, p.id)).id if live else None\n        return AnswerRecord(pid, self._particles[pid].last_preview_id if pid is not None else None, (), None, self._nfe, rule, [])\n    def get_state(self):\n        active = [pid for pid, p in self._particles.items() if p.status == 'active']\n        completed = [pid for pid, p in self._particles.items() if p.status == 'completed']\n        pruned = [pid for pid, p in self._particles.items() if p.status == 'pruned']\n        return ControllerState(\n            prompt='x',\n            budget_left=self.budget_left,\n            active_particle_ids=active,\n            completed_particle_ids=completed,\n            pruned_particle_ids=pruned,\n            particles={pid: ParticleSummary(pid, p.time, p.parent_id, p.source_anchor_id, p.nfe_used, p.status, p.last_preview_id, p.num_children) for pid, p in self._particles.items()},\n            previews=dict(self._previews),\n            event_log=[],\n        )\n\ncontroller = OptimalController()\nfor beta, budget in [(0.0, 64), (0.25, 64), (0.5, 64), (0.75, 64), (1.0, 64)]:\n    env = FakeEnv(budget=budget, steps=10)\n    ans = controller.solve(env, beta)\n    print(beta, ans.nfe_used, ans.rule, ans.preview_id)\n    assert ans.nfe_used <= 64\nprint('ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
