{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' flow_autotts/controllers/optimal.py\"","aggregated_output":"\"\"\"Candidate controller for SD3.5 PickScore discovery.\"\"\"\n\nfrom __future__ import annotations\n\nfrom flow_autotts.core.env import FlowTTSEnv\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, PreviewRecord\n\n\nclass OptimalController:\n    \"\"\"Beta-scheduled preview search with adaptive pruning and selective refinement.\"\"\"\n\n    def solve(self, env: FlowTTSEnv, beta: float) -> AnswerRecord:\n        beta = self._clamp_beta(beta)\n        schedule = self._schedule(env, beta)\n\n        if int(schedule[\"target_nfe\"]) <= int(schedule[\"steps\"]):\n            return self._deterministic_finish(env)\n\n        try:\n            root_ids = env.spawn(schedule[\"roots\"])\n        except (BudgetExceededError, InvalidActionError):\n            return env.answer(rule=\"latest_active\")\n\n        target_nfe = min(int(env.budget), int(schedule[\"target_nfe\"]))\n        warm_previews: list[PreviewRecord] = []\n        for particle_id in root_ids:\n            if not self._reserve(env, target_nfe, needed=schedule[\"warm_cost_per_root\"]):\n                break\n            preview = self._advance_and_preview(\n                env,\n                particle_id,\n                target_time=float(schedule[\"warm_time\"]),\n                solver=\"euler\",\n            )\n            if preview is not None:\n                warm_previews.append(preview)\n\n        if not warm_previews:\n            return self._safe_answer(env)\n\n        ranked = self._ranked_previews(env, particle_ids=root_ids)\n        survivors = self._choose_survivors(ranked, schedule)\n        self._prune_roots(env, root_ids, survivors)\n\n        for particle_id in survivors:\n            if not self._reserve(env, target_nfe, needed=schedule[\"finish_cost_per_root\"]):\n                break\n            preview = self._advance_and_preview(\n                env,\n                particle_id,\n                target_time=1.0,\n                solver=\"euler\",\n            )\n\n        ranked_final = self._ranked_previews(env)\n        if not ranked_final:\n            return self._safe_answer(env)\n\n        self._confirm_top_candidates(env, ranked_final, target_nfe, schedule)\n        self._refine_top_candidates(env, target_nfe, schedule)\n        self._late_fill(env, target_nfe, schedule)\n        return self._safe_answer(env)\n\n    def _schedule(self, env: FlowTTSEnv, beta: float) -> dict[str, float | int]:\n        steps = max(1, len(env.time_grid) - 1)\n        target_curve = {\n            0.0: 10,\n            0.25: 20,\n            0.5: 36,\n            0.75: 48,\n            1.0: 64,\n        }\n        target_nfe = self._interpolate(beta, target_curve)\n        target_nfe = min(int(env.budget), max(1, int(round(target_nfe))))\n        beta_level = int(round(beta * 4.0))\n        roots = 1 if beta < 0.18 else 2 if beta < 0.56 else 3 if beta < 0.9 else 4\n        warm_time = 0.6 if beta < 0.2 else 0.5 if beta < 0.6 else 0.4\n        refine_time = 0.84 if beta < 0.35 else 0.72 if beta < 0.75 else 0.6\n        roots = min(roots, max(1, target_nfe // 4))\n\n        return {\n            \"target_nfe\": target_nfe,\n            \"roots\": roots,\n            \"warm_time\": warm_time,\n            \"refine_time\": refine_time,\n            \"base_keep\": 1 if beta < 0.5 else 2,\n            \"max_keep\": min(roots, 1 if beta < 0.45 else 2 if beta < 0.9 else 3),\n            \"gap_close\": 0.012 if beta < 0.35 else 0.016 if beta < 0.75 else 0.02,\n            \"gap_wide\": 0.045 if beta < 0.5 else 0.055 if beta < 0.9 else 0.065,\n            \"uncertain_threshold\": 0.5 if beta < 0.5 else 0.62,\n            \"confirm_slots\": 0 if beta <= 0.0 else 1 if beta < 0.45 else 2 if beta < 0.9 else 3,\n            \"late_preview_limit\": 1 if beta < 0.35 else 2 if beta < 0.9 else 3,\n            \"max_children\": 0 if beta < 0.28 else 1 if beta < 0.45 else 2 if beta < 0.7 else 3 if beta < 0.9 else 4,\n            \"children_per_anchor\": 1 if beta < 0.7 else 2,\n            \"prune_gap\": 0.03 if beta < 0.5 else 0.05 if beta < 0.85 else 0.07,\n            \"mixed_strength\": 0.38 if beta < 0.75 else 0.3,\n            \"allow_explore_child\": 1 if beta >= 0.7 else 0,\n            \"warm_cost_per_root\": self._move_cost(env, 0.0, warm_time) + 1,\n            \"finish_cost_per_root\": self._move_cost(env, warm_time, 1.0) + 1,\n            \"confirm_cost\": 1,\n            \"steps\": steps,\n        }\n\n    def _deterministic_finish(self, env: FlowTTSEnv) -> AnswerRecord:\n        try:\n            particle_id = env.spawn(1)[0]\n            particle = env.get_state().particles[particle_id]\n            if particle.time < 1.0:\n                env.forward(particle_id, target_time=1.0, solver=\"euler\")\n            return env.answer(rule=\"latest_active\")\n        except (BudgetExceededError, InvalidActionError):\n            return env.answer(rule=\"latest_active\")\n\n    def _advance_and_preview(\n        self,\n        env: FlowTTSEnv,\n        particle_id: int,\n        target_time: float,\n        solver: str,\n    ) -> PreviewRecord | None:\n        try:\n            particle = env.get_state().particles[particle_id]\n        except KeyError:\n            return None\n        if particle.status == \"pruned\":\n            return None\n        try:\n            if target_time > particle.time:\n                env.forward(particle_id, target_time=target_time, solver=solver)\n            return env.preview(particle_id, mode=\"clean_anchor\", scorer=\"default\")\n        except (BudgetExceededError, InvalidActionError):\n            return None\n\n    def _choose_survivors(\n        self,\n        ranked: list[PreviewRecord],\n        schedule: dict[str, float | int],\n    ) -> list[int]:\n        if not ranked:\n            return []\n\n        keep = min(int(schedule[\"base_keep\"]), len(ranked))\n        max_keep = min(int(schedule[\"max_keep\"]), len(ranked))\n        top_score = float(ranked[0].score or 0.0)\n\n        for index in range(1, len(ranked)):\n            preview = ranked[index]\n            gap = top_score - float(preview.score or 0.0)\n            if gap <= float(schedule[\"gap_close\"]) and keep < max_keep:\n                keep += 1\n                continue\n            if (\n                index == 1\n                and keep < max_keep\n                and float(ranked[0].uncertainty or 0.0) >= float(schedule[\"uncertain_threshold\"])\n            ):\n                keep += 1\n                continue\n            if gap >= float(schedule[\"gap_wide\"]):\n                break\n\n        return [preview.particle_id for preview in ranked[:keep]]\n\n    def _prune_roots(\n        self,\n        env: FlowTTSEnv,\n        root_ids: list[int],\n        survivors: list[int],\n    ) -> None:\n        prune_ids: list[int] = []\n        survivor_set = set(survivors)\n        state = env.get_state()\n        for particle_id in root_ids:\n            particle = state.particles.get(particle_id)\n            if particle is None or particle.status != \"active\":\n                continue\n            if particle_id not in survivor_set:\n                prune_ids.append(particle_id)\n        if prune_ids:\n            try:\n                env.prune(prune_ids)\n            except InvalidActionError:\n                pass\n\n    def _confirm_top_candidates(\n        self,\n        env: FlowTTSEnv,\n        ranked_final: list[PreviewRecord],\n        target_nfe: int,\n        schedule: dict[str, float | int],\n    ) -> None:\n        confirmations = min(int(schedule[\"confirm_slots\"]), len(ranked_final))\n        if confirmations <= 0:\n            return\n\n        confirmed = 0\n        for preview in ranked_final[:confirmations]:\n            if not self._reserve(env, target_nfe, needed=int(schedule[\"confirm_cost\"])):\n                break\n            particle = env.get_state().particles.get(preview.particle_id)\n            if particle is None or particle.status == \"pruned\":\n                continue\n            try:\n                env.preview(preview.particle_id, mode=\"clean_anchor\", scorer=\"default\")\n                confirmed += 1\n            except (BudgetExceededError, InvalidActionError):\n                break\n\n        if confirmed <= 0:\n            return\n\n    def _refine_top_candidates(\n        self,\n        env: FlowTTSEnv,\n        target_nfe: int,\n        schedule: dict[str, float | int],\n    ) -> None:\n        max_children = int(schedule[\"max_children\"])\n        if max_children <= 0:\n            return\n\n        children_made = 0\n        while children_made < max_children:\n            ranked = self._ranked_previews(env)\n            if not ranked:\n                return\n            anchors = self._eligible_refine_anchors(ranked, schedule)\n            if not anchors:\n                return\n\n            anchor = anchors[min(children_made, len(anchors) - 1)]\n            remaining = max_children - children_made\n            num_children = min(int(schedule[\"children_per_anchor\"]), remaining)\n            child_cost = self._child_bundle_cost(env, float(schedule[\"refine_time\"]), num_children)\n            if not self._reserve(env, target_nfe, needed=child_cost):\n                return\n\n            noise_policy = \"mixed_noise\"\n            strength = float(schedule[\"mixed_strength\"])\n            if (\n                int(schedule[\"allow_explore_child\"]) > 0\n                and children_made == 0\n                and len(anchors) > 1\n                and self._top_gap(ranked) <= float(schedule[\"gap_close\"])\n            ):\n                noise_policy = \"fresh_noise\"\n                strength = 1.0\n\n            try:\n                child_ids = env.backward(\n                    anchor.id,\n                    target_time=float(schedule[\"refine_time\"]),\n                    noise_policy=noise_policy,\n                    num_children=num_children,\n                    strength=strength,\n                )\n            except (BudgetExceededError, InvalidActionError):\n                return\n\n","exit_code":0,"status":"completed"}}
