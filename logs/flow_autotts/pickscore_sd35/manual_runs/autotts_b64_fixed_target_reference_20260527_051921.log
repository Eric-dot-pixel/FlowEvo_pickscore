f.get_state().particles[particle_id]\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p = self._particles[particle_id]\n        if p.status == 'pruned':\n            raise InvalidActionError()\n        self._charge(1)\n        aid = self._next_aid\n        self._next_aid += 1\n        score = 0.6 + 0.02 * particle_id + 0.15 * p.time - 0.01 * p.num_children\n        preview = PreviewRecord(\n            id=aid,\n            particle_id=particle_id,\n            time=p.time,\n            score=score,\n            score_dict={'score': score},\n            uncertainty=max(0.0, 0.5 - 0.3 * p.time),\n            drift=max(0.0, 0.4 - 0.2 * p.time),\n        )\n        self._previews[aid] = preview\n        p.last_preview_id = aid\n        p.nfe_used += 1\n        return preview\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        if mask is not None:\n            raise InvalidActionError()\n        parent_preview = self._previews[anchor_id]\n        parent = self._particles[parent_preview.particle_id]\n        parent.num_children += num_children\n        ids = []\n        for _ in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = P(\n                id=pid,\n                time=max(0.0, min(1.0, target_time)),\n                status='completed' if target_time >= 1.0 else 'active',\n                parent_id=parent.id,\n                source_anchor_id=anchor_id,\n            )\n            ids.append(pid)\n        return ids\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            p = self._particles[pid]\n            if p.status == 'completed':\n                raise InvalidActionError()\n            p.status = 'pruned'\n    def answer(self, rule='best_preview_score'):\n        best = None\n        for preview in self._previews.values():\n            p = self._particles[preview.particle_id]\n            if p.status == 'pruned':\n                continue\n            if best is None or (preview.score or -1e9) > (best.score or -1e9):\n                best = preview\n        return AnswerRecord(\n            particle_id=None if best is None else best.particle_id,\n            preview_id=None if best is None else best.id,\n            latent=(),\n            reward=None if best is None else best.score,\n            nfe_used=self._nfe,\n            rule=rule,\n            event_log=[],\n            score_dict={},\n        )\n    def get_state(self):\n        particles = {\n            pid: ParticleSummary(\n                id=p.id,\n                time=p.time,\n                parent_id=p.parent_id,\n                source_anchor_id=p.source_anchor_id,\n                nfe_used=p.nfe_used,\n                status=p.status,\n                last_preview_id=p.last_preview_id,\n                num_children=p.num_children,\n            )\n            for pid, p in self._particles.items()\n        }\n        active = [pid for pid, p in self._particles.items() if p.status == 'active']\n        completed = [pid for pid, p in self._particles.items() if p.status == 'completed']\n        pruned = [pid for pid, p in self._particles.items() if p.status == 'pruned']\n        return ControllerState(\n            prompt='fake',\n            budget_left=self.budget_left,\n            active_particle_ids=active,\n            completed_particle_ids=completed,\n            pruned_particle_ids=pruned,\n            particles=particles,\n            previews=dict(self._previews),\n            event_log=[],\n        )\n\ncontroller = OptimalController()\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FakeEnv()\n    ans = controller.solve(env, beta)\n    print(beta, ans.nfe_used, ans.particle_id, ans.preview_id)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, ParticleSummary, PreviewRecord\n\n@dataclass\nclass P:\n    id: int\n    time: float = 0.0\n    status: str = 'active'\n    last_preview_id: int | None = None\n    parent_id: int | None = None\n    source_anchor_id: int | None = None\n    nfe_used: int = 0\n    num_children: int = 0\n\nclass FakeEnv:\n    def __init__(self, budget=64, steps=10):\n        self.time_grid = tuple(i / steps for i in range(steps + 1))\n        self.budget = budget\n        self._nfe = 0\n        self._next_pid = 0\n        self._next_aid = 0\n        self._particles = {}\n        self._previews = {}\n    @property\n    def budget_left(self):\n        return self.budget - self._nfe\n    def _charge(self, n):\n        if self._nfe + n > self.budget:\n            raise BudgetExceededError()\n        self._nfe += n\n    def spawn(self, n):\n        ids = []\n        for _ in range(n):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = P(id=pid)\n            ids.append(pid)\n        return ids\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        if solver not in {'euler', 'sde'}:\n            raise InvalidActionError()\n        p = self._particles[particle_id]\n        if p.status \"'!= '\"'active':\n            raise InvalidActionError()\n        cur = round(p.time * 10)\n        tgt = round(target_time * 10)\n        if tgt <= cur:\n            raise InvalidActionError()\n        self._charge(tgt - cur)\n        p.time = self.time_grid[tgt]\n        p.nfe_used += tgt - cur\n        if p.time >= 1.0:\n            p.status = 'completed'\n        return self.get_state().particles[particle_id]\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p = self._particles[particle_id]\n        if p.status == 'pruned':\n            raise InvalidActionError()\n        self._charge(1)\n        aid = self._next_aid\n        self._next_aid += 1\n        score = 0.6 + 0.02 * particle_id + 0.15 * p.time - 0.01 * p.num_children\n        preview = PreviewRecord(\n            id=aid,\n            particle_id=particle_id,\n            time=p.time,\n            score=score,\n            score_dict={'score': score},\n            uncertainty=max(0.0, 0.5 - 0.3 * p.time),\n            drift=max(0.0, 0.4 - 0.2 * p.time),\n        )\n        self._previews[aid] = preview\n        p.last_preview_id = aid\n        p.nfe_used += 1\n        return preview\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        if mask is not None:\n            raise InvalidActionError()\n        parent_preview = self._previews[anchor_id]\n        parent = self._particles[parent_preview.particle_id]\n        parent.num_children += num_children\n        ids = []\n        for _ in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = P(\n                id=pid,\n                time=max(0.0, min(1.0, target_time)),\n                status='completed' if target_time >= 1.0 else 'active',\n                parent_id=parent.id,\n                source_anchor_id=anchor_id,\n            )\n            ids.append(pid)\n        return ids\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            p = self._particles[pid]\n            if p.status == 'completed':\n                raise InvalidActionError()\n            p.status = 'pruned'\n    def answer(self, rule='best_preview_score'):\n        best = None\n        for preview in self._previews.values():\n            p = self._particles[preview.particle_id]\n            if p.status == 'pruned':\n                continue\n            if best is None or (preview.score or -1e9) > (best.score or -1e9):\n                best = preview\n        return AnswerRecord(\n            particle_id=None if best is None else best.particle_id,\n            preview_id=None if best is None else best.id,\n            latent=(),\n            reward=None if best is None else best.score,\n            nfe_used=self._nfe,\n            rule=rule,\n            event_log=[],\n            score_dict={},\n        )\n    def get_state(self):\n        particles = {\n            pid: ParticleSummary(\n                id=p.id,\n                time=p.time,\n                parent_id=p.parent_id,\n                source_anchor_id=p.source_anchor_id,\n                nfe_used=p.nfe_used,\n                status=p.status,\n                last_preview_id=p.last_preview_id,\n                num_children=p.num_children,\n            )\n            for pid, p in self._particles.items()\n        }\n        active = [pid for pid, p in self._particles.items() if p.status == 'active']\n        completed = [pid for pid, p in self._particles.items() if p.status == 'completed']\n        pruned = [pid for pid, p in self._particles.items() if p.status == 'pruned']\n        return ControllerState(\n            prompt='fake',\n            budget_left=self.budget_left,\n            active_particle_ids=active,\n            completed_particle_ids=completed,\n            pruned_particle_ids=pruned,\n            particles=particles,\n            previews=dict(self._previews),\n            event_log=[],\n        )\n\ncontroller = OptimalController()\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FakeEnv()\n    ans = controller.solve(env, beta)\n    print(beta, ans.nfe_used, ans.particle_id, ans.preview_id)\nPY\"","aggregated_output":"0.0 10 None None\n0.25 18 1 2\n0.5 36 2 3\n0.75 44 4 7\n1.0 63 6 10\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_34","type":"agent_message","text":"Implemented the controller in [optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo/flow_autotts/controllers/optimal.py).\n\nThe idea is: keep low beta disciplined, then at mid/high beta use preview feedback in two new ways. First, rank only each particle’s latest preview, not all historical previews, so stale anchors do not keep winning budget. Second, when the leader is ambiguous, finish a reserved challenger branch before spending on local backward refinement; only after that does the controller use selective `backward` from close leaders. This targets the current weak region at `beta=0.50`, while also helping `0.75` and `1.00` use compute more comparably to the injected target curve.\n\nI inspected the context-pack baseline/target rows for `beta = 0.00, 0.25, 0.50, 0.75, 1.00`, the incumbent frontier rows from `r0000`, the rejected-round notes for `r0001` and `r0002`, and the controller snapshots for `r0000`, `r0001`, and `r0002`. The latest incumbent numbers in the pack were:\n- `0.00`: reward `0.819160`, mean NFE `10.0`, above baseline.\n- `0.25`: reward `0.828068`, mean NFE `20.0`, above baseline.\n- `0.50`: reward `0.831124`, mean NFE `36.0`, below baseline `0.836650`.\n- `0.75`: reward `0.839364`, mean NFE `48.0`, below baseline `0.843990`.\n- `1.00`: reward `0.843137`, mean NFE `62.88`, below baseline `0.847290` and slightly under target.\nThe last two proposals were real behavior changes, not cosmetic ones: `r0001` added more confirmation/SDE staging, and `r0002` added reserve/tournament behavior, but both mostly shifted budget away from useful late evidence.\n\nExact beta schedule:\n- `beta=0.00`: target `10`, deterministic-only single-root full forward.\n- `beta=0.25`: target `20`, `roots=2`, `warm_time=0.5`, `keep_floor=1`, `keep_cap=1`, `reserve_cap=0`, `max_children=0`, `tail_limit=1`.\n- `beta=0.50`: target `36`, `roots=3`, `warm_time=0.4`, `keep_floor=2`, `keep_cap=2`, `reserve_cap=1`, `rescue_limit=1`, `late_confirm_limit=1`, `max_children=1`, `refine_time=0.72`, `tail_limit=2`.\n- `beta=0.75`: target `48`, `roots=3`, `warm_time=0.4`, `keep_floor=2`, `keep_cap=2`, `reserve_cap=1`, `rescue_limit=1`, `late_confirm_limit=1`, `max_children=2`, `refine_time=0.72`, `tail_limit=3`.\n- `beta=1.00`: target `64`, `roots=4`, `warm_time=0.3`, `keep_floor=2`, `keep_cap=3`, `reserve_cap=2`, `rescue_limit=2`, `late_confirm_limit=2`, `max_children=3`, `refine_time=0.6`, `tail_limit=4`.\nBudget willingness is monotonic because target NFE is `10/20/36/48/64`, width is `1/2/3/3/4`, reserves are `0/0/1/1/2`, child budget is `0/0/1/2/3`, and tail budget is `0/1/2/3/4`.\n\nWhat is behaviorally new versus the recent best:\n- Latest-preview-only ranking instead of ranking across all historical previews.\n- Ambiguity-gated challenger rescue: keep reserve branches at mid/high beta and finish them when top-gap or uncertainty says the leader is not settled.\n- Tail budget moved away from redundant same-state confirmation toward finishing unfinished branches first, then one more selective local refinement.\n\nChecks run:\n- `python -m py_compile flow_autotts/controllers/optimal.py`\n- A tiny fake-env dry run over betas `0.0, 0.25, 0.5, 0.75, 1.0`\nThe toy run used about `10 / 18 / 36 / 44 / 63` NFE, so the controller stays under budget and reaches the intended high-beta ceiling without exceeding it.\n\nTarget-NFE reflection:\n- `beta=0.00`, target `10`: no underuse; fixed deterministic path. This is intentional and preserved.\n- `beta=0.25`, target `20`: slight underuse is still possible if the early winner is clear. I left that mostly justified rather than forcing extra low-value actions, because this regime already beats baseline.\n- `beta=0.50`, target `36`: this was the main weakness. I adjusted utilization by increasing width to `3`, adding `1` reserve challenger, and keeping `1` local refine slot. This should spend closer to target with better allocation.\n- `beta=0.75`, target `48`: underuse is less justified here, so I added reserve rescue plus `2` refinement children and a larger tail budget. It should stay closer to `48` unless the preview leader separates very early.\n- `beta=1.00`, target `64`: underuse was a known problem. I increased width/reserves/refinement/tail budget, and `_reserve()` always caps planned spend at `min(env.budget, target_nfe)`, so with target `64` it cannot start any action that would exceed `64`. The toy dry run reached `63`, which is the intended behavior band.\n\nExpected improvement target and risks:\n- Intended improvement: primarily `beta=0.50`, secondarily `0.75` and `1.00`.\n- Main risk: reserve rescue can spend on a mediocre challenger if warm previews are noisy, and `0.75` may still slightly underspend when one branch dominates early.\n- Low-beta risk is intentionally minimized by keeping `0.00` unchanged and `0.25` conservative."}}
