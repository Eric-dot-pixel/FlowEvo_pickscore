env, target_nfe, needed):\n                break\n            self._advance_and_preview(env, particle_id, target_time=1.0, solver=\"euler\")\n\n    def _finish_reserves(\n        self,\n        env: FlowTTSEnv,\n        reserves: list[int],\n        target_nfe: int,\n        schedule: dict[str, float | int],\n    ) -> None:\n        limit = int(schedule[\"finish_reserves\"])\n        finished = 0\n        for particle_id in reserves:\n            if finished >= limit:\n                return\n            particle = self._particle(env, particle_id)\n            if particle is None or particle.status == \"pruned\":\n                continue\n            needed = self._finish_preview_cost(env, particle.time)\n            if not self._reserve(env, target_nfe, needed):\n                return\n            preview = self._advance_and_preview(env, particle_id, target_time=1.0, solver=\"euler\")\n            if preview is not None:\n                finished += 1\n\n    def _select_survivors(\n        self,\n        ranked: list[PreviewRecord],\n        schedule: dict[str, float | int],\n    ) -> tuple[list[int], list[int]]:\n        if not ranked:\n            return [], []\n\n        keep = min(len(ranked), int(schedule[\"keep_floor\"]))\n        keep_cap = min(len(ranked), int(schedule[\"keep_cap\"]))\n        reserve_cap = min(max(0, len(ranked) - keep), int(schedule[\"reserve_cap\"]))\n        top = ranked[0]\n        top_score = float(top.score or 0.0)\n\n        for preview in ranked[keep:]:\n            gap = top_score - float(preview.score or 0.0)\n            if keep < keep_cap and gap <= float(schedule[\"close_gap\"]):\n                keep += 1\n                continue\n            if (\n                keep < keep_cap\n                and float(top.uncertainty or 0.0) >= float(schedule[\"uncertainty_keep\"])\n                and gap <= float(schedule[\"wide_gap\"])\n            ):\n                keep += 1\n            break\n\n        survivor_ids = [preview.particle_id for preview in ranked[:keep]]\n        reserve_ids = [preview.particle_id for preview in ranked[keep : keep + reserve_cap]]\n        return survivor_ids, reserve_ids\n\n    def _depth_tournament(\n        self,\n        env: FlowTTSEnv,\n        ranked: list[PreviewRecord],\n        target_nfe: int,\n        schedule: dict[str, float | int],\n        stage: str,\n    ) -> None:\n        slots_key = \"mid_tournament_slots\" if stage == \"mid\" else \"late_tournament_slots\"\n        slots = min(len(ranked), int(schedule[slots_key]))\n        if slots <= 0 or not self._needs_tournament(ranked, schedule):\n            return\n\n        tournament_time = float(\n            schedule[\"mid_tournament_time\"] if stage == \"mid\" else schedule[\"late_tournament_time\"]\n        )\n        for preview in ranked[:slots]:\n            particle = self._particle(env, preview.particle_id)\n            if particle is None or particle.status == \"pruned\":\n                continue\n            next_time = max(tournament_time, particle.time)\n            if next_time <= particle.time + 1e-9 and particle.time >= 1.0:\n                continue\n            if next_time <= particle.time + 1e-9:\n                continue\n            needed = self._move_cost(env, particle.time, next_time) + 1\n            if not self._reserve(env, target_nfe, needed):\n                return\n            self._advance_and_preview(env, preview.particle_id, target_time=next_time, solver=\"euler\")\n\n    def _needs_tournament(\n        self,\n        ranked: list[PreviewRecord],\n        schedule: dict[str, float | int],\n","exit_code":0,"status":"completed"}}
