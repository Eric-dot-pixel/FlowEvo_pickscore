{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.env import FlowTTSEnv\nfrom flow_autotts.core.model_api import IdentityVAE\n\nclass ToyModel:\n    def velocity(self, z, t, condition=None):\n        return tuple(1.0 - x for x in z)\n\nclass ToyScorer:\n    def score(self, z1_hat, condition=None):\n        score = -sum((x - 1.0) ** 2 for x in z1_hat)\n        return score, {\\\"toy\\\": score}\n\ncontroller = OptimalController()\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FlowTTSEnv(\n        model=ToyModel(),\n        vae=IdentityVAE(),\n        scorer=ToyScorer(),\n        prompt=\\\"toy\\\",\n        budget=64,\n        time_grid=[i / 10 for i in range(11)],\n        seed=123,\n        latent_shape=(4,),\n    )\n    ans = controller.solve(env, beta)\n    print(beta, ans.nfe_used, ans.rule, ans.reward)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.env import FlowTTSEnv\nfrom flow_autotts.core.model_api import IdentityVAE\n\nclass ToyModel:\n    def velocity(self, z, t, condition=None):\n        return tuple(1.0 - x for x in z)\n\nclass ToyScorer:\n    def score(self, z1_hat, condition=None):\n        score = -sum((x - 1.0) ** 2 for x in z1_hat)\n        return score, {\\\"toy\\\": score}\n\ncontroller = OptimalController()\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FlowTTSEnv(\n        model=ToyModel(),\n        vae=IdentityVAE(),\n        scorer=ToyScorer(),\n        prompt=\\\"toy\\\",\n        budget=64,\n        time_grid=[i / 10 for i in range(11)],\n        seed=123,\n        latent_shape=(4,),\n    )\n    ans = controller.solve(env, beta)\n    print(beta, ans.nfe_used, ans.rule, ans.reward)\nPY\"","aggregated_output":"0.0 1 latest_active -0.0\n0.25 6 best_preview_score -0.22484674204118027\n0.5 18 best_preview_score -0.20721875746515186\n0.75 20 latest_active -0.28204775321645664\n1.0 24 latest_active -0.1613533868495046\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_37","type":"agent_message","text":"The dry-run surfaced one expected artifact: the lightweight core env charges one NFE per `forward` call regardless of time distance, so its realized NFE is much lower than SD3.5’s step-based env. I’m adding a second local check with a tiny mock env that charges by step index like the SD3.5 environment, so I can validate the beta schedule against the intended `10/20/36/48/64` regime more directly."}}
{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, EventRecord, ParticleSummary, PreviewRecord\n\n@dataclass\nclass P:\n    id: int\n    step: int\n    status: str = 'active'\n    parent_id: int | None = None\n    source_anchor_id: int | None = None\n    last_preview_id: int | None = None\n    num_children: int = 0\n    nfe_used: int = 0\n\n@dataclass\nclass A:\n    id: int\n    particle_id: int\n    step: int\n    score: float\n    uncertainty: float\n    drift: float\n\nclass StepEnv:\n    def __init__(self, budget=64, steps=10):\n        self.budget = budget\n        self._nfe = 0\n        self.time_grid = tuple(i / steps for i in range(steps + 1))\n        self._steps = steps\n        self._next_pid = 0\n        self._next_aid = 0\n        self._particles = {}\n        self._anchors = {}\n        self._events = []\n        self._answered = False\n    @property\n    def budget_left(self):\n        return self.budget - self._nfe\n    def _charge(self, c):\n        if self._nfe + c > self.budget:\n            raise BudgetExceededError\n        self._nfe += c\n    def spawn(self, n):\n        if n <= 0:\n            raise InvalidActionError\n        ids = []\n        for _ in range(n):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = P(id=pid, step=0)\n            ids.append(pid)\n        return ids\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        p = self._particles[particle_id]\n        if p.status \"'!= '\"'active':\n            raise InvalidActionError\n        target_step = min(self._steps, max(0, int(round(target_time * self._steps))))\n        if target_step <= p.step:\n            raise InvalidActionError\n        cost = target_step - p.step\n        self._charge(cost)\n        p.step = target_step\n        p.nfe_used += cost\n        if p.step >= self._steps:\n            p.status = 'completed'\n        return self.get_state().particles[particle_id]\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p = self._particles[particle_id]\n        if p.status == 'pruned':\n            raise InvalidActionError\n        self._charge(1)\n        score = 0.6 + 0.02 * p.step - 0.03 * (p.id % 4) + 0.005 * ((p.id // 2) % 3)\n        uncertainty = max(0.0, 1.0 - p.step / self._steps)\n        drift = max(0.0, 0.9 - 0.08 * p.step + 0.03 * (p.id % 2))\n        aid = self._next_aid\n        self._next_aid += 1\n        self._anchors[aid] = A(aid, particle_id, p.step, score, uncertainty, drift)\n        p.last_preview_id = aid\n        p.nfe_used += 1\n        return self.get_state().previews[aid]\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        a = self._anchors[anchor_id]\n        target_step = min(self._steps, max(0, int(round(target_time * self._steps))))\n        ids = []\n        for _ in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            status = 'completed' if target_step >= self._steps else 'active'\n            self._particles[pid] = P(id=pid, step=target_step, status=status, parent_id=a.particle_id, source_anchor_id=a.id)\n            ids.append(pid)\n        self._particles[a.particle_id].num_children += num_children\n        return ids\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            p = self._particles[pid]\n            if p.status == 'completed':\n                raise InvalidActionError\n            p.status = 'pruned'\n    def answer(self, rule='best_preview_score'):\n        self._answered = True\n        if rule == 'best_preview_score' and self._anchors:\n            best = max(self._anchors.values(), key=lambda a: a.score)\n            return AnswerRecord(best.particle_id, best.id, (), best.score, self._nfe, rule, list(self._events), {'score': best.score})\n        candidates = [p for p in self._particles.values() if p.status in {'active', 'completed'}]\n        if not candidates:\n            return AnswerRecord(None, None, (), None, self._nfe, rule, list(self._events), {})\n        chosen = max(candidates, key=lambda p: (p.step, p.id))\n        if chosen.status == 'active':\n            self.forward(chosen.id, 1.0)\n        reward = 0.6 + 0.02 * self._particles[chosen.id].step - 0.03 * (chosen.id % 4) + 0.005 * ((chosen.id // 2) % 3)\n        return AnswerRecord(chosen.id, chosen.last_preview_id, (), reward, self._nfe, rule, list(self._events), {'score': reward})\n    def get_state(self):\n        particles = {pid: ParticleSummary(id=p.id, time=p.step / self._steps, parent_id=p.parent_id, source_anchor_id=p.source_anchor_id, nfe_used=p.nfe_used, status=p.status, last_preview_id=p.last_preview_id, num_children=p.num_children) for pid, p in self._particles.items()}\n        previews = {aid: PreviewRecord(id=a.id, particle_id=a.particle_id, time=a.step / self._steps, score=a.score, score_dict={'score': a.score}, uncertainty=a.uncertainty, drift=a.drift, embedding_ref=None) for aid, a in self._anchors.items()}\n        active = [pid for pid, p in self._particles.items() if p.status == 'active']\n        comp = [pid for pid, p in self._particles.items() if p.status == 'completed']\n        pruned = [pid for pid, p in self._particles.items() if p.status == 'pruned']\n        return ControllerState(prompt='mock', budget_left=self.budget_left, active_particle_ids=active, completed_particle_ids=comp, pruned_particle_ids=pruned, particles=particles, previews=previews, event_log=[])\n\ncontroller = OptimalController()\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = StepEnv()\n    ans = controller.solve(env, beta)\n    print({'beta': beta, 'nfe': ans.nfe_used, 'rule': ans.rule, 'reward': ans.reward})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, EventRecord, ParticleSummary, PreviewRecord\n\n@dataclass\nclass P:\n    id: int\n    step: int\n    status: str = 'active'\n    parent_id: int | None = None\n    source_anchor_id: int | None = None\n    last_preview_id: int | None = None\n    num_children: int = 0\n    nfe_used: int = 0\n\n@dataclass\nclass A:\n    id: int\n    particle_id: int\n    step: int\n    score: float\n    uncertainty: float\n    drift: float\n\nclass StepEnv:\n    def __init__(self, budget=64, steps=10):\n        self.budget = budget\n        self._nfe = 0\n        self.time_grid = tuple(i / steps for i in range(steps + 1))\n        self._steps = steps\n        self._next_pid = 0\n        self._next_aid = 0\n        self._particles = {}\n        self._anchors = {}\n        self._events = []\n        self._answered = False\n    @property\n    def budget_left(self):\n        return self.budget - self._nfe\n    def _charge(self, c):\n        if self._nfe + c > self.budget:\n            raise BudgetExceededError\n        self._nfe += c\n    def spawn(self, n):\n        if n <= 0:\n            raise InvalidActionError\n        ids = []\n        for _ in range(n):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = P(id=pid, step=0)\n            ids.append(pid)\n        return ids\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        p = self._particles[particle_id]\n        if p.status \"'!= '\"'active':\n            raise InvalidActionError\n        target_step = min(self._steps, max(0, int(round(target_time * self._steps))))\n        if target_step <= p.step:\n            raise InvalidActionError\n        cost = target_step - p.step\n        self._charge(cost)\n        p.step = target_step\n        p.nfe_used += cost\n        if p.step >= self._steps:\n            p.status = 'completed'\n        return self.get_state().particles[particle_id]\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p = self._particles[particle_id]\n        if p.status == 'pruned':\n            raise InvalidActionError\n        self._charge(1)\n        score = 0.6 + 0.02 * p.step - 0.03 * (p.id % 4) + 0.005 * ((p.id // 2) % 3)\n        uncertainty = max(0.0, 1.0 - p.step / self._steps)\n        drift = max(0.0, 0.9 - 0.08 * p.step + 0.03 * (p.id % 2))\n        aid = self._next_aid\n        self._next_aid += 1\n        self._anchors[aid] = A(aid, particle_id, p.step, score, uncertainty, drift)\n        p.last_preview_id = aid\n        p.nfe_used += 1\n        return self.get_state().previews[aid]\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        a = self._anchors[anchor_id]\n        target_step = min(self._steps, max(0, int(round(target_time * self._steps))))\n        ids = []\n        for _ in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            status = 'completed' if target_step >= self._steps else 'active'\n            self._particles[pid] = P(id=pid, step=target_step, status=status, parent_id=a.particle_id, source_anchor_id=a.id)\n            ids.append(pid)\n        self._particles[a.particle_id].num_children += num_children\n        return ids\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            p = self._particles[pid]\n            if p.status == 'completed':\n                raise InvalidActionError\n            p.status = 'pruned'\n    def answer(self, rule='best_preview_score'):\n        self._answered = True\n        if rule == 'best_preview_score' and self._anchors:\n            best = max(self._anchors.values(), key=lambda a: a.score)\n            return AnswerRecord(best.particle_id, best.id, (), best.score, self._nfe, rule, list(self._events), {'score': best.score})\n        candidates = [p for p in self._particles.values() if p.status in {'active', 'completed'}]\n        if not candidates:\n            return AnswerRecord(None, None, (), None, self._nfe, rule, list(self._events), {})\n        chosen = max(candidates, key=lambda p: (p.step, p.id))\n        if chosen.status == 'active':\n            self.forward(chosen.id, 1.0)\n        reward = 0.6 + 0.02 * self._particles[chosen.id].step - 0.03 * (chosen.id % 4) + 0.005 * ((chosen.id // 2) % 3)\n        return AnswerRecord(chosen.id, chosen.last_preview_id, (), reward, self._nfe, rule, list(self._events), {'score': reward})\n    def get_state(self):\n        particles = {pid: ParticleSummary(id=p.id, time=p.step / self._steps, parent_id=p.parent_id, source_anchor_id=p.source_anchor_id, nfe_used=p.nfe_used, status=p.status, last_preview_id=p.last_preview_id, num_children=p.num_children) for pid, p in self._particles.items()}\n        previews = {aid: PreviewRecord(id=a.id, particle_id=a.particle_id, time=a.step / self._steps, score=a.score, score_dict={'score': a.score}, uncertainty=a.uncertainty, drift=a.drift, embedding_ref=None) for aid, a in self._anchors.items()}\n        active = [pid for pid, p in self._particles.items() if p.status == 'active']\n        comp = [pid for pid, p in self._particles.items() if p.status == 'completed']\n        pruned = [pid for pid, p in self._particles.items() if p.status == 'pruned']\n        return ControllerState(prompt='mock', budget_left=self.budget_left, active_particle_ids=active, completed_particle_ids=comp, pruned_particle_ids=pruned, particles=particles, previews=previews, event_log=[])\n\ncontroller = OptimalController()\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = StepEnv()\n    ans = controller.solve(env, beta)\n    print({'beta': beta, 'nfe': ans.nfe_used, 'rule': ans.rule, 'reward': ans.reward})\nPY\"","aggregated_output":"{'beta': 0.0, 'nfe': 10, 'rule': 'latest_active', 'reward': 0.8}\n{'beta': 0.25, 'nfe': 18, 'rule': 'best_preview_score', 'reward': 0.8}\n{'beta': 0.5, 'nfe': 33, 'rule': 'best_preview_score', 'reward': 0.8}\n{'beta': 0.75, 'nfe': 46, 'rule': 'latest_active', 'reward': 0.7100000000000001}\n{'beta': 1.0, 'nfe': 62, 'rule': 'latest_active', 'reward': 0.805}\n","exit_code":0,"status":"completed"}}
