\"fresh_noise\"\n                strength = 1.0\n\n            try:\n                child_id = env.backward(\n                    anchor.id,\n                    target_time=float(schedule[\"refine_time\"]),\n                    noise_policy=noise_policy,\n                    num_children=1,\n                    strength=strength,\n                )[0]\n            except (BudgetExceededError, InvalidActionError):\n                return\n\n            preview = self._advance_and_preview(env, child_id, target_time=1.0, solver=\"euler\")\n            if preview is None:\n                return\n            children_done += 1\n            self._prune_after_refine(env, schedule)\n\n    def _tail_refine_or_confirm(\n        self,\n        env: FlowTTSEnv,\n        target_nfe: int,\n        schedule: dict[str, float | int],\n    ) -> None:\n        actions_left = int(schedule[\"tail_actions\"])\n        while actions_left > 0:\n            ranked = self._ranked_latest_previews(env)\n            if not ranked:\n                return\n\n            best_anchor = ranked[0]\n            gap = self._top_gap(ranked)\n            unfinished = self._best_unfinished_preview(env, ranked)\n            if (\n                unfinished is not None\n                and gap <= float(schedule[\"wide_gap\"])\n                and self._reserve(\n                    env,\n                    target_nfe,\n                    self._finish_preview_cost(env, unfinished.time),\n                )\n            ):\n                preview = self._advance_and_preview(\n                    env,\n                    unfinished.particle_id,\n                    target_time=1.0,\n                    solver=\"euler\",\n                )\n                if preview is None:\n                    return\n                actions_left -= 1\n                continue\n\n            if (\n                int(schedule[\"max_children\"]) > 0\n                and self._reserve(env, target_nfe, self._child_bundle_cost(env, float(schedule[\"refine_time\"]), 1))\n                and (\n                    gap <= float(schedule[\"tournament_gap\"])\n                    or float(best_anchor.drift or 0.0) >= float(schedule[\"tournament_drift\"])\n                )\n            ):\n                try:\n                    child_id = env.backward(\n                        best_anchor.id,\n                        target_time=float(schedule[\"refine_time\"]),\n                        noise_policy=\"mixed_noise\",\n                        num_children=1,\n                        strength=float(schedule[\"mixed_strength\"]),\n                    )[0]\n                except (BudgetExceededError, InvalidActionError):\n                    return\n                preview = self._advance_and_preview(env, child_id, target_time=1.0, solver=\"euler\")\n                if preview is None:\n                    return\n                actions_left -= 1\n                continue\n\n            return\n\n    def _commit_best_anchor(\n        self,\n        env: FlowTTSEnv,\n        target_nfe: int,\n        schedule: dict[str, float | int],\n    ) -> bool:\n        if int(schedule[\"commit_best\"]) <= 0:\n            return False\n        ranked = self._ranked_latest_previews(env)\n        if not ranked:\n            return False\n        best = ranked[0]\n        if best.time < 1.0 - 1e-9:\n            return False\n        if not self._reserve(env, target_nfe, needed=0):\n            return False\n        try:\n            child_id = env.backward(\n                best.id,\n                target_time=1.0,\n                noise_policy=\"inferred_noise\",\n                num_children=1,\n                strength=1.0,\n            )[0]\n        except (BudgetExceededError, InvalidActionError):\n            return False\n        particle = self._particle(env, child_id)\n        if particle is None or particle.status == \"pruned\":\n            return False\n        return True\n\n    def _eligible_anchors(\n        self,\n        ranked: list[PreviewRecord],\n        schedule: dict[str, float | int],\n    ) -> list[PreviewRecord]:\n        if not ranked:\n            return []\n        best = float(ranked[0].score or 0.0)\n        limit = min(len(ranked), int(schedule[\"max_refine_anchors\"]))\n        anchors: list[PreviewRecord] = []\n        for preview in ranked[:limit]:\n            gap = best - float(preview.score or 0.0)\n            if gap <= float(schedule[\"refine_gap\"]) or preview is ranked[0]:\n                anchors.append(preview)\n        return anchors\n\n    def _prune_after_refine(\n        self,\n        env: FlowTTSEnv,\n        schedule: dict[str, float | int],\n    ) -> None:\n        ranked = self._ranked_latest_previews(env)\n        if len(ranked) < 2:\n            return\n        best = float(ranked[0].score or 0.0)\n        keep = {\n            preview.particle_id\n            for preview in ranked\n            if best - float(preview.score or 0.0) <= float(schedule[\"wide_gap\"])\n        }\n        keep.update(preview.particle_id for preview in ranked[: int(schedule[\"keep_floor\"])])\n        state = env.get_state()\n        prune_ids = [pid for pid in state.active_particle_ids if pid not in keep]\n        if prune_ids:\n            self._prune_particles(env, prune_ids)\n\n    def _best_unfinished_preview(\n        self,\n        env: FlowTTSEnv,\n        ranked: list[PreviewRecord],\n    ) -> PreviewRecord | None:\n        state = env.get_state()\n        for preview in ranked:\n            particle = state.particles.get(preview.particle_id)\n            if particle is None or particle.status == \"pruned\":\n                continue\n            if particle.time < 1.0 - 1e-9:\n                return preview\n        return None\n\n    def _prune_particles(self, env: FlowTTSEnv, particle_ids: list[int]) -> None:\n        if not particle_ids:\n            return\n        active_ids = set()\n        for particle_id in particle_ids:\n            particle = self._particle(env, particle_id)\n            if particle is not None and particle.status == \"active\":\n                active_ids.add(particle_id)\n        if not active_ids:\n            return\n        try:\n            env.prune(sorted(active_ids))\n        except InvalidActionError:\n            return\n\n    def _ranked_latest_previews(\n        self,\n        env: FlowTTSEnv,\n        particle_ids: list[int] | None = None,\n    ) -> list[PreviewRecord]:\n        state = env.get_state()\n        allowed = None if particle_ids is None else set(particle_ids)\n        latest: list[PreviewRecord] = []\n        for particle in state.particles.values():\n            if particle.status == \"pruned\" or particle.last_preview_id is None:\n                continue\n            if allowed is not None and particle.id not in allowed:\n                continue\n            preview = state.previews.get(particle.last_preview_id)\n            if preview is not None and preview.score is not None:\n                latest.append(preview)\n        return sorted(\n            latest,\n            key=lambda preview: (\n                float(preview.score),\n                -float(preview.uncertainty or 0.0),\n                float(preview.time),\n                -float(preview.drift or 0.0),\n                -int(preview.id),\n            ),\n            reverse=True,\n        )\n\n    def _particle(self, env: FlowTTSEnv, particle_id: int) -> ParticleSummary | None:\n        return env.get_state().particles.get(particle_id)\n\n    def _finish_preview_cost(self, env: FlowTTSEnv, current_time: float) -> int:\n        return self._move_cost(env, current_time, 1.0) + 1\n\n    def _child_bundle_cost(self, env: FlowTTSEnv, target_time: float, num_children: int) -> int:\n        per_child = self._move_cost(env, target_time, 1.0) + 1\n        return max(1, int(num_children) * per_child)\n\n    def _move_cost(self, env: FlowTTSEnv, start_time: float, target_time: float) -> int:\n        start = self._time_to_step(env, start_time)\n","exit_code":0,"status":"completed"}}
