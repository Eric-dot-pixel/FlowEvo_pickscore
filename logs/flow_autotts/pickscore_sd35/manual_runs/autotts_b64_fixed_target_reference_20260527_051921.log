"single-root preview (spawn=1.00, preview=6.00, prune=1.00, nfe=19.00)\",\n          \"beta\": 0.25,\n          \"nfe\": 19,\n          \"reward\": 0.8242775021791459,\n          \"reward_per_nfe\": 0.04338302643048136\n        },\n        {\n          \"action_statistics\": {\n            \"answer\": 1.0,\n            \"backward\": 1.0,\n            \"forward\": 6.0,\n            \"mean_nfe\": 36.0,\n            \"preview\": 10.0,\n            \"prune\": 1.0,\n            \"spawn\": 1.0\n          },\n          \"behavior_summary\": \"preview-guided backward refinement (spawn=1.00, preview=10.00, backward=1.00, prune=1.00, nfe=36.00)\",\n          \"beta\": 0.5,\n          \"nfe\": 36,\n          \"reward\": 0.8345449330806732,\n          \"reward_per_nfe\": 0.023181803696685366\n        },\n        {\n          \"action_statistics\": {\n            \"answer\": 1.0,\n            \"backward\": 2.0,\n            \"forward\": 8.0,\n            \"mean_nfe\": 48.0,\n            \"preview\": 12.0,\n            \"spawn\": 1.0\n          },\n          \"behavior_summary\": \"preview-guided backward refinement (spawn=1.00, preview=12.00, backward=2.00, nfe=48.00)\",\n          \"beta\": 0.75,\n          \"nfe\": 48,\n          \"reward\": 0.8371562694311142,\n          \"reward_per_nfe\": 0.01744075561314821\n        },\n        {\n          \"action_statistics\": {\n            \"answer\": 1.0,\n            \"backward\": 2.848,\n            \"forward\": 10.0,\n            \"mean_nfe\": 64.0,\n            \"preview\": 16.848,\n            \"prune\": 0.848,\n            \"spawn\": 1.0\n          },\n          \"behavior_summary\": \"preview-guided backward refinement (spawn=1.00, preview=16.85, backward=2.85, prune=0.85, nfe=64.00)\",\n          \"beta\": 1.0,\n          \"nfe\": 64,\n          \"reward\": 0.8419563006162644,\n          \"reward_per_nfe\": 0.01315556719712913\n        }\n      ],\n      \"round_id\": 0\n    }\n  ],\n  \"sample_seed\": 42,\n  \"sample_size\":