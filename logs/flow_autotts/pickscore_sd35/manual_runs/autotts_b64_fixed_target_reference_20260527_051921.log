{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass, field\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, EventRecord, ParticleSummary, PreviewRecord\n\n@dataclass\nclass P:\n    id:int\n    time:float=0.0\n    status:str='active'\n    last_preview_id:int|None=None\n    parent_id:int|None=None\n    source_anchor_id:int|None=None\n    nfe_used:int=0\n    num_children:int=0\n\nclass FakeEnv:\n    def __init__(self,budget=64):\n        self.time_grid=tuple(i/10 for i in range(11))\n        self.budget=budget\n        self.budget_left=budget\n        self._particles={}\n        self._previews={}\n        self._anchors={}\n        self._next_pid=0\n        self._next_aid=0\n        self._events=[]\n    def spawn(self,n):\n        if n<=0: raise InvalidActionError('bad spawn')\n        out=[]\n        for _ in range(n):\n            pid=self._next_pid; self._next_pid+=1\n            self._particles[pid]=P(id=pid)\n            out.append(pid)\n        return out\n    def forward(self,pid,target_time,solver='euler',cfg=None):\n        if solver not in {'euler','sde'}: raise InvalidActionError('solver')\n        p=self._particles[pid]\n        if p.status\"'!='\"'active': raise InvalidActionError('not active')\n        steps=max(0,round(target_time*10)-round(p.time*10))\n        if steps<=0: raise InvalidActionError('no advance')\n        if self.budget_left<steps: raise BudgetExceededError()\n        self.budget_left-=steps\n        p.nfe_used+=steps\n        p.time=target_time\n        if p.time>=1.0: p.status='completed'\n        return self.get_state().particles[pid]\n    def preview(self,pid,mode='clean_anchor',scorer='default'):\n        if mode\"'!='\"'clean_anchor': raise InvalidActionError('mode')\n        p=self._particles[pid]\n        if p.status=='pruned': raise InvalidActionError('pruned')\n        if self.budget_left<1: raise BudgetExceededError()\n        self.budget_left-=1\n        score=(pid+1)*0.05 + p.time*0.6 - 0.02*(p.parent_id is not None)\n        uncertainty=max(0.0,1.0-p.time)\n        aid=self._next_aid; self._next_aid+=1\n        pr=PreviewRecord(id=aid, particle_id=pid, time=p.time, score=score, uncertainty=uncertainty, drift=max(0.0,1.0-p.time), score_dict={})\n        self._previews[aid]=pr\n        self._anchors[aid]=pr\n        p.last_preview_id=aid\n        p.nfe_used+=1\n        return pr\n    def backward(self,anchor_id,target_time,noise_policy='fresh_noise',num_children=1,mask=None,strength=1.0):\n        if mask is not None: raise InvalidActionError('mask')\n        if num_children<=0: raise InvalidActionError('children')\n        anchor=self._anchors[anchor_id]\n        out=[]\n        for _ in range(num_children):\n            pid=self._next_pid; self._next_pid+=1\n            parent=self._particles[anchor.particle_id]\n            self._particles[pid]=P(id=pid,time=target_time,parent_id=anchor.particle_id,source_anchor_id=anchor_id,status='active' if target_time<1.0 else 'completed')\n            parent.num_children+=1\n            out.append(pid)\n        return out\n    def prune(self,particle_ids):\n        for pid in particle_ids:\n            p=self._particles[pid]\n            if p.status=='completed': raise InvalidActionError('completed')\n            p.status='pruned'\n    def answer(self,rule='best_preview_score'):\n        if rule=='best_preview_score' and self._previews:\n            best=max(self._previews.values(), key=lambda x: x.score)\n            return AnswerRecord(best.particle_id,best.id,(),best.score,self.budget-self.budget_left,rule,[],{})\n        active=[p for p in self._particles.values() if p.status in {'active','completed'}]\n        if not active:\n            return AnswerRecord(None,None,(),None,self.budget-self.budget_left,rule,[],{})\n        chosen=max(active,key=lambda p:(p.time,p.id))\n        return AnswerRecord(chosen.id,chosen.last_preview_id,(),0.0,self.budget-self.budget_left,rule,[],{})\n    def get_state(self):\n        particles={pid:ParticleSummary(id=p.id,time=p.time,parent_id=p.parent_id,source_anchor_id=p.source_anchor_id,nfe_used=p.nfe_used,status=p.status,last_preview_id=p.last_preview_id,num_children=p.num_children) for pid,p in self._particles.items()}\n        previews=dict(self._previews)\n        active=[pid for pid,p in self._particles.items() if p.status=='active']\n        completed=[pid for pid,p in self._particles.items() if p.status=='completed']\n        pruned=[pid for pid,p in self._particles.items() if p.status=='pruned']\n        return ControllerState(prompt='x',budget_left=self.budget_left,active_particle_ids=active,completed_particle_ids=completed,pruned_particle_ids=pruned,particles=particles,previews=previews,event_log=[])\n\nctrl=OptimalController()\nfor beta in [0.0,0.25,0.5,0.75,1.0]:\n    env=FakeEnv(64)\n    ans=ctrl.solve(env,beta)\n    print(beta, ans.nfe_used)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
