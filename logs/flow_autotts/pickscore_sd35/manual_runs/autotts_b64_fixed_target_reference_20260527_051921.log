{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' logs/flow_autotts/pickscore_sd35/history_autotts_b64_fixed_target_reference_20260527_051921/r0003_20260527_051921_793d5c44/flow_autotts/controllers/optimal.py\"","aggregated_output":"\"\"\"Candidate controller for SD3.5 PickScore discovery.\"\"\"\n\nfrom __future__ import annotations\n\nfrom flow_autotts.core.env import FlowTTSEnv\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ParticleSummary, PreviewRecord\n\n\nclass OptimalController:\n    \"\"\"Beta-scheduled preview search with challenger rescue and selective refinement.\"\"\"\n\n    def solve(self, env: FlowTTSEnv, beta: float) -> AnswerRecord:\n        beta = self._clamp_beta(beta)\n        schedule = self._schedule(env, beta)\n        target_nfe = min(int(env.budget), int(schedule[\"target_nfe\"]))\n\n        if int(schedule[\"deterministic_only\"]) > 0:\n            return self._deterministic_finish(env)\n\n        try:\n            root_ids = env.spawn(int(schedule[\"roots\"]))\n        except (BudgetExceededError, InvalidActionError):\n            return self._safe_answer(env)\n\n        warm_ids: list[int] = []\n        for particle_id in root_ids:\n            if not self._reserve(env, target_nfe, int(schedule[\"warm_cost\"])):\n                break\n            preview = self._advance_and_preview(\n                env,\n                particle_id,\n                target_time=float(schedule[\"warm_time\"]),\n                solver=\"euler\",\n            )\n            if preview is not None:\n                warm_ids.append(particle_id)\n\n        if not warm_ids:\n            return self._safe_answer(env)\n\n        ranked_warm = self._ranked_latest_previews(env, particle_ids=warm_ids)\n        survivors, reserves = self._select_survivors(ranked_warm, schedule)\n        if not survivors and ranked_warm:\n            survivors = [ranked_warm[0].particle_id]\n            reserves = [preview.particle_id for preview in ranked_warm[1:]]\n        self._prune_particles(env, [pid for pid in root_ids if pid not in set(survivors + reserves)])\n\n        self._finish_particle_group(env, survivors, target_nfe)\n        self._rescue_reserves(env, reserves, target_nfe, schedule)\n\n        ranked_final = self._ranked_latest_previews(env)\n        if not ranked_final:\n            return self._safe_answer(env)\n\n        self._late_search(env, target_nfe, schedule)\n        self._spend_tail(env, target_nfe, schedule)\n        return self._safe_answer(env)\n\n    def _schedule(self, env: FlowTTSEnv, beta: float) -> dict[str, float | int]:\n        target_curve = {\n            0.0: 10,\n            0.25: 20,\n            0.5: 36,\n            0.75: 48,\n            1.0: 64,\n        }\n        target_nfe = min(int(env.budget), max(1, int(round(self._interpolate(beta, target_curve)))))\n        deterministic_only = 1 if beta <= 0.0 else 0\n\n        roots = 1 if beta < 0.2 else 2 if beta < 0.45 else 3 if beta < 0.9 else 4\n        warm_time = 0.5 if beta < 0.3 else 0.4 if beta < 0.8 else 0.3\n        warm_cost = self._move_cost(env, 0.0, warm_time) + 1\n        roots = min(roots, max(1, target_nfe // max(2, warm_cost)))\n\n        keep_floor = 1 if beta < 0.5 else 2\n        keep_cap = min(roots, 1 if beta < 0.35 else 2 if beta < 0.9 else 3)\n        reserve_cap = min(max(0, roots - keep_floor), 0 if beta < 0.45 else 1 if beta < 0.85 else 2)\n\n        return {\n            \"target_nfe\": target_nfe,\n            \"deterministic_only\": deterministic_only,\n            \"roots\": roots,\n            \"warm_time\": warm_time,\n            \"warm_cost\": warm_cost,\n            \"keep_floor\": keep_floor,\n            \"keep_cap\": keep_cap,\n            \"reserve_cap\": reserve_cap,\n            \"close_gap\": 0.012 if beta < 0.35 else 0.017 if beta < 0.8 else 0.022,\n            \"wide_gap\": 0.045 if beta < 0.35 else 0.058 if beta < 0.8 else 0.072,\n            \"uncertainty_keep\": 0.52 if beta < 0.5 else 0.46 if beta < 0.85 else 0.4,\n            \"rescue_gap\": 0.0 if beta < 0.45 else 0.02 if beta < 0.8 else 0.028,\n            \"rescue_uncertainty\": 0.55 if beta < 0.7 else 0.48,\n            \"rescue_limit\": 0 if beta < 0.45 else 1 if beta < 0.9 else 2,\n            \"late_confirm_limit\": 0 if beta < 0.45 else 1 if beta < 0.8 else 2,\n            \"confirm_gap\": 0.012 if beta < 0.45 else 0.018 if beta < 0.8 else 0.024,\n            \"confirm_drift\": 0.44 if beta < 0.45 else 0.34 if beta < 0.8 else 0.26,\n            \"refine_time\": 0.82 if beta < 0.5 else 0.72 if beta < 0.8 else 0.6,\n            \"max_children\": 0 if beta < 0.42 else 1 if beta < 0.7 else 2 if beta < 0.9 else 3,\n            \"anchor_cap\": 1 if beta < 0.7 else 2,\n            \"refine_gap\": 0.024 if beta < 0.7 else 0.034 if beta < 0.9 else 0.046,\n            \"fresh_gap\": 0.0 if beta < 0.7 else 0.016 if beta < 0.9 else 0.022,\n            \"mixed_strength\": 0.38 if beta < 0.8 else 0.3,\n            \"prune_gap\": 0.05 if beta < 0.7 else 0.06 if beta < 0.9 else 0.075,\n            \"tail_limit\": 1 if beta < 0.3 else 2 if beta < 0.6 else 3 if beta < 0.9 else 4,\n        }\n\n    def _deterministic_finish(self, env: FlowTTSEnv) -> AnswerRecord:\n        try:\n            particle_id = env.spawn(1)[0]\n            particle = self._particle(env, particle_id)\n            if particle is not None and particle.time < 1.0:\n                env.forward(particle_id, target_time=1.0, solver=\"euler\")\n            return env.answer(rule=\"latest_active\")\n        except (BudgetExceededError, InvalidActionError):\n            return env.answer(rule=\"latest_active\")\n\n    def _advance_and_preview(\n        self,\n        env: FlowTTSEnv,\n        particle_id: int,\n        target_time: float,\n        solver: str,\n    ) -> PreviewRecord | None:\n        particle = self._particle(env, particle_id)\n        if particle is None or particle.status == \"pruned\":\n            return None\n        try:\n            if target_time > particle.time:\n                env.forward(particle_id, target_time=target_time, solver=solver)\n            elif not self._needs_latest_preview(env, particle_id):\n                return self._latest_preview(env, particle_id)\n            return env.preview(particle_id, mode=\"clean_anchor\", scorer=\"default\")\n        except (BudgetExceededError, InvalidActionError):\n            return None\n\n    def _finish_particle_group(\n        self,\n        env: FlowTTSEnv,\n        particle_ids: list[int],\n        target_nfe: int,\n    ) -> None:\n        for particle_id in particle_ids:\n            particle = self._particle(env, particle_id)\n            if particle is None or particle.status == \"pruned\":\n                continue\n            needed = self._finish_preview_cost(env, particle.time)\n            if not self._reserve(env, target_nfe, needed):\n                break\n            self._advance_and_preview(env, particle_id, target_time=1.0, solver=\"euler\")\n\n    def _select_survivors(\n        self,\n        ranked: list[PreviewRecord],\n        schedule: dict[str, float | int],\n    ) -> tuple[list[int], list[int]]:\n        if not ranked:\n            return [], []\n\n        keep = min(len(ranked), int(schedule[\"keep_floor\"]))\n        keep_cap = min(len(ranked), int(schedule[\"keep_cap\"]))\n        reserve_cap = min(max(0, len(ranked) - keep), int(schedule[\"reserve_cap\"]))\n        top = ranked[0]\n        top_score = float(top.score or 0.0)\n\n        for preview in ranked[keep:]:\n            gap = top_score - float(preview.score or 0.0)\n            if keep < keep_cap and gap <= float(schedule[\"close_gap\"]):\n                keep += 1\n                continue\n            if (\n                keep < keep_cap\n                and float(top.uncertainty or 0.0) >= float(schedule[\"uncertainty_keep\"])\n                and gap <= float(schedule[\"wide_gap\"])\n            ):\n                keep += 1\n            break\n\n        survivor_ids = [preview.particle_id for preview in ranked[:keep]]\n        reserve_ids = [preview.particle_id for preview in ranked[keep : keep + reserve_cap]]\n        return survivor_ids, reserve_ids\n\n    def _rescue_reserves(\n        self,\n        env: FlowTTSEnv,\n        reserve_ids: list[int],\n        target_nfe: int,\n        schedule: dict[str, float | int],\n    ) -> None:\n        limit = int(schedule[\"rescue_limit\"])\n        if limit <= 0 or not reserve_ids:\n            return\n\n        used = 0\n        while used < limit:\n            ranked = self._ranked_latest_previews(env)\n            if len(ranked) < 2 or not self._needs_rescue(ranked, schedule):\n                return\n            candidate = self._best_reserve_preview(env, reserve_ids)\n            if candidate is None:\n                return\n            particle = self._particle(env, candidate.particle_id)\n            if particle is None or particle.status == \"pruned\":\n                return\n            needed = self._finish_preview_cost(env, particle.time)\n            if not self._reserve(env, target_nfe, needed):\n                return\n            preview = self._advance_and_preview(env, candidate.particle_id, target_time=1.0, solver=\"euler\")\n            if preview is None:\n                return\n            used += 1\n\n    def _late_search(\n        self,\n        env: FlowTTSEnv,\n        target_nfe: int,\n        schedule: dict[str, float | int],\n    ) -> None:\n        self._finish_uncertain_survivor(env, target_nfe, schedule)\n        self._confirm_close_finish(env, target_nfe, schedule)\n        self._refine_close_finish(env, target_nfe, schedule)\n\n    def _finish_uncertain_survivor(\n        self,\n        env: FlowTTSEnv,\n        target_nfe: int,\n        schedule: dict[str, float | int],\n    ) -> None:\n        ranked = self._ranked_latest_previews(env)\n        if len(ranked) < 2:\n            return\n        if not self._needs_rescue(ranked, schedule):\n            return\n        for preview in ranked[:2]:\n            particle = self._particle(env, preview.particle_id)\n            if particle is None or particle.status == \"pruned\":\n                continue\n            if particle.time >= 1.0 - 1e-9:\n                continue\n            needed = self._finish_preview_cost(env, particle.time)\n            if not self._reserve(env, target_nfe, needed):\n                return\n            self._advance_and_preview(env, preview.particle_id, target_time=1.0, solver=\"euler\")\n            return\n\n    def _confirm_close_finish(\n        self,\n        env: FlowTTSEnv,\n        target_nfe: int,\n        schedule: dict[str, float | int],\n    ) -> None:\n        limit = int(schedule[\"late_confirm_limit\"])\n        if limit <= 0:\n            return\n\n        used = 0\n        while used < limit and self._reserve(env, target_nfe, 1):\n            ranked = self._ranked_latest_previews(env)\n            if not ranked or not self._needs_confirmation(ranked, schedule):\n                return\n","exit_code":0,"status":"completed"}}
