    if p.status == 'completed':\n                raise InvalidActionError('cannot prune completed')\n            p.status = 'pruned'\n    def answer(self, rule='best_preview_score'):\n        if rule == 'best_preview_score' and self._previews:\n            best = max(self._previews.values(), key=lambda p: p.score)\n            return AnswerRecord(best.particle_id, best.id, (), best.score, self._nfe, rule, [])\n        live = [p for p in self._particles.values() if p.status in ('active', 'completed')]\n        pid = max(live, key=lambda p: (p.time, p.id)).id if live else None\n        return AnswerRecord(pid, self._particles[pid].last_preview_id if pid is not None else None, (), None, self._nfe, rule, [])\n    def get_state(self):\n        active = [pid for pid, p in self._particles.items() if p.status == 'active']\n        completed = [pid for pid, p in self._particles.items() if p.status == 'completed']\n        pruned = [pid for pid, p in self._particles.items() if p.status == 'pruned']\n        return ControllerState(\n            prompt='x',\n            budget_left=self.budget_left,\n            active_particle_ids=active,\n            completed_particle_ids=completed,\n            pruned_particle_ids=pruned,\n            particles={pid: ParticleSummary(pid, p.time, p.parent_id, p.source_anchor_id, p.nfe_used, p.status, p.last_preview_id, p.num_children) for pid, p in self._particles.items()},\n            previews=dict(self._previews),\n            event_log=[],\n        )\n\ncontroller = OptimalController()\nfor beta, budget in [(0.0, 64), (0.25, 64), (0.5, 64), (0.75, 64), (1.0, 64)]:\n    env = FakeEnv(budget=budget, steps=10)\n    ans = controller.solve(env, beta)\n    print(beta, ans.nfe_used, ans.rule, ans.preview_id)\n    assert ans.nfe_used <= 64\nprint('ok')\nPY\"","aggregated_output":"0.0 10 latest_active None\n0.25 18 best_preview_score 4\n0.5 36 best_preview_score 9\n0.75 48 best_preview_score 11\n1.0 64 best_preview_score 16\nok\n","exit_code":0,"