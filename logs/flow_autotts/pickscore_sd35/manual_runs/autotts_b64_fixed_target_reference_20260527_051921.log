{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' logs/flow_autotts/pickscore_sd35/history_autotts_b64_fixed_target_reference_20260527_051921/r0002_20260527_051921_793d5c44/flow_autotts/controllers/optimal.py\"","aggregated_output":"\"\"\"Candidate controller for SD3.5 PickScore discovery.\"\"\"\n\nfrom __future__ import annotations\n\nfrom flow_autotts.core.env import FlowTTSEnv\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, PreviewRecord\n\n\nclass OptimalController:\n    \"\"\"Beta-scheduled preview tournament with ambiguity-triggered refinement.\"\"\"\n\n    def solve(self, env: FlowTTSEnv, beta: float) -> AnswerRecord:\n        beta = self._clamp_beta(beta)\n        schedule = self._schedule(env, beta)\n        target_nfe = min(int(env.budget), int(schedule[\"target_nfe\"]))\n\n        if int(schedule[\"deterministic_only\"]) > 0:\n            return self._deterministic_finish(env)\n\n        try:\n            root_ids = env.spawn(int(schedule[\"roots\"]))\n        except (BudgetExceededError, InvalidActionError):\n            return self._safe_answer(env)\n\n        warm_ids: list[int] = []\n        for particle_id in root_ids:\n            if not self._reserve(env, target_nfe, int(schedule[\"warm_cost\"])):\n                break\n            preview = self._advance_and_preview(\n                env,\n                particle_id,\n                target_time=float(schedule[\"warm_time\"]),\n                solver=\"euler\",\n            )\n            if preview is not None:\n                warm_ids.append(particle_id)\n\n        if not warm_ids:\n            return self._safe_answer(env)\n\n        ranked_warm = self._ranked_latest_previews(env, particle_ids=warm_ids)\n        survivors, reserves = self._select_survivors(ranked_warm, schedule)\n        if not survivors:\n            survivors = [ranked_warm[0].particle_id]\n            reserves = [preview.particle_id for preview in ranked_warm[1:]]\n        self._prune_particles(env, [pid for pid in root_ids if pid not in set(survivors + reserves)])\n\n        ranked_after_warm = self._ranked_latest_previews(env, particle_ids=survivors)\n        if ranked_after_warm:\n            self._depth_tournament(\n                env,\n                ranked_after_warm,\n                target_nfe,\n                schedule,\n                stage=\"mid\",\n            )\n\n        self._finish_survivors(env, survivors, target_nfe)\n        ranked_final = self._ranked_latest_previews(env)\n        if not ranked_final:\n            return self._safe_answer(env)\n\n        self._depth_tournament(\n            env,\n            ranked_final,\n            target_nfe,\n            schedule,\n            stage=\"late\",\n        )\n        self._refine_anchors(env, target_nfe, schedule)\n        self._finish_reserves(env, reserves, target_nfe, schedule)\n        self._tail_refine_or_confirm(env, target_nfe, schedule)\n        committed = self._commit_best_anchor(env, target_nfe, schedule)\n        if committed:\n            try:\n                return env.answer(rule=\"latest_active\")\n            except (BudgetExceededError, InvalidActionError):\n                return self._safe_answer(env)\n        return self._safe_answer(env)\n\n    def _schedule(self, env: FlowTTSEnv, beta: float) -> dict[str, float | int]:\n        target_curve = {\n            0.0: 10,\n            0.25: 20,\n            0.5: 36,\n            0.75: 48,\n            1.0: 64,\n        }\n        target_nfe = min(int(env.budget), max(1, int(round(self._interpolate(beta, target_curve)))))\n        steps = max(1, len(env.time_grid) - 1)\n        deterministic_only = 1 if beta <= 0.0 else 0\n\n        roots = 1 if beta < 0.18 else 2 if beta < 0.45 else 3 if beta < 0.85 else 4\n        warm_time = 0.5 if beta < 0.3 else 0.4 if beta < 0.75 else 0.3\n        warm_cost = self._move_cost(env, 0.0, warm_time) + 1\n        mid_tournament_time = 0.7 if beta < 0.4 else 0.8 if beta < 0.8 else 0.9\n        late_tournament_time = 0.85 if beta < 0.4 else 0.95 if beta < 0.8 else 1.0\n        refine_time = 0.9 if beta < 0.45 else 0.8 if beta < 0.75 else 0.7 if beta < 0.95 else 0.6\n\n        keep_floor = 1 if beta < 0.45 else 2\n        keep_cap = min(roots, 1 if beta < 0.35 else 2 if beta < 0.85 else 3)\n        reserve_cap = min(max(0, roots - keep_floor), 0 if beta < 0.4 else 1 if beta < 0.85 else 2)\n        max_children = 0 if beta < 0.42 else 1 if beta < 0.65 else 2 if beta < 0.9 else 3\n\n        return {\n            \"target_nfe\": target_nfe,\n            \"steps\": steps,\n            \"deterministic_only\": deterministic_only,\n            \"roots\": min(roots, max(1, target_nfe // max(2, warm_cost))),\n            \"warm_time\": warm_time,\n            \"warm_cost\": warm_cost,\n            \"keep_floor\": keep_floor,\n            \"keep_cap\": keep_cap,\n            \"reserve_cap\": reserve_cap,\n            \"close_gap\": 0.012 if beta < 0.35 else 0.018 if beta < 0.75 else 0.024,\n            \"wide_gap\": 0.045 if beta < 0.35 else 0.06 if beta < 0.75 else 0.075,\n            \"uncertainty_keep\": 0.52 if beta < 0.45 else 0.46 if beta < 0.85 else 0.4,\n            \"mid_tournament_slots\": 0 if beta < 0.25 else 1 if beta < 0.7 else 2,\n            \"late_tournament_slots\": 0 if beta < 0.35 else 1 if beta < 0.55 else 2 if beta < 0.9 else 3,\n            \"tournament_gap\": 0.015 if beta < 0.45 else 0.022 if beta < 0.85 else 0.03,\n            \"tournament_drift\": 0.52 if beta < 0.45 else 0.38 if beta < 0.85 else 0.24,\n            \"mid_tournament_time\": mid_tournament_time,\n            \"late_tournament_time\": late_tournament_time,\n            \"refine_time\": refine_time,\n            \"max_children\": max_children,\n            \"max_refine_anchors\": 1 if beta < 0.7 else 2,\n            \"refine_gap\": 0.022 if beta < 0.7 else 0.032 if beta < 0.9 else 0.045,\n            \"mixed_strength\": 0.4 if beta < 0.75 else 0.3,\n            \"fresh_if_close\": 1 if beta >= 0.75 else 0,\n            \"fresh_gap\": 0.015 if beta < 0.75 else 0.022,\n            \"finish_reserves\": 0 if beta < 0.45 else 1 if beta < 0.85 else 2,\n            \"tail_actions\": 1 if beta < 0.3 else 2 if beta < 0.65 else 3 if beta < 0.9 else 4,\n            \"commit_best\": 1 if beta >= 0.55 else 0,\n        }\n\n    def _deterministic_finish(self, env: FlowTTSEnv) -> AnswerRecord:\n        try:\n            particle_id = env.spawn(1)[0]\n            particle = self._particle(env, particle_id)\n            if particle is not None and particle.time < 1.0:\n                env.forward(particle_id, target_time=1.0, solver=\"euler\")\n            return env.answer(rule=\"latest_active\")\n        except (BudgetExceededError, InvalidActionError):\n            return env.answer(rule=\"latest_active\")\n\n    def _advance_and_preview(\n        self,\n        env: FlowTTSEnv,\n        particle_id: int,\n        target_time: float,\n        solver: str,\n    ) -> PreviewRecord | None:\n        particle = self._particle(env, particle_id)\n        if particle is None or particle.status == \"pruned\":\n            return None\n        try:\n            if target_time > particle.time:\n                env.forward(particle_id, target_time=target_time, solver=solver)\n            return env.preview(particle_id, mode=\"clean_anchor\", scorer=\"default\")\n        except (BudgetExceededError, InvalidActionError):\n            return None\n\n    def _finish_survivors(self, env: FlowTTSEnv, particle_ids: list[int], target_nfe: int) -> None:\n        for particle_id in particle_ids:\n            particle = self._particle(env, particle_id)\n            if particle is None or particle.status == \"pruned\":\n                continue\n            needed = self._finish_preview_cost(env, particle.time)\n            if not self._reserve(env, target_nfe, needed):\n                break\n            self._advance_and_preview(env, particle_id, target_time=1.0, solver=\"euler\")\n\n    def _finish_reserves(\n        self,\n        env: FlowTTSEnv,\n        reserves: list[int],\n        target_nfe: int,\n        schedule: dict[str, float | int],\n    ) -> None:\n        limit = int(schedule[\"finish_reserves\"])\n        finished = 0\n        for particle_id in reserves:\n            if finished >= limit:\n                return\n            particle = self._particle(env, particle_id)\n            if particle is None or particle.status == \"pruned\":\n                continue\n            needed = self._finish_preview_cost(env, particle.time)\n            if not self._reserve(env, target_nfe, needed):\n                return\n            preview = self._advance_and_preview(env, particle_id, target_time=1.0, solver=\"euler\")\n            if preview is not None:\n                finished += 1\n\n    def _select_survivors(\n        self,\n        ranked: list[PreviewRecord],\n        schedule: dict[str, float | int],\n    ) -> tuple[list[int], list[int]]:\n        if not ranked:\n            return [], []\n\n        keep = min(len(ranked), int(schedule[\"keep_floor\"]))\n        keep_cap = min(len(ranked), int(schedule[\"keep_cap\"]))\n        reserve_cap = min(max(0, len(ranked) - keep), int(schedule[\"reserve_cap\"]))\n        top = ranked[0]\n        top_score = float(top.score or 0.0)\n\n        for preview in ranked[keep:]:\n            gap = top_score - float(preview.score or 0.0)\n            if keep < keep_cap and gap <= float(schedule[\"close_gap\"]):\n                keep += 1\n                continue\n            if (\n                keep < keep_cap\n                and float(top.uncertainty or 0.0) >= float(schedule[\"uncertainty_keep\"])\n                and gap <= float(schedule[\"wide_gap\"])\n            ):\n                keep += 1\n            break\n\n        survivor_ids = [preview.particle_id for preview in ranked[:keep]]\n        reserve_ids = [preview.particle_id for preview in ranked[keep : keep + reserve_cap]]\n        return survivor_ids, reserve_ids\n\n    def _depth_tournament(\n        self,\n        env: FlowTTSEnv,\n        ranked: list[PreviewRecord],\n        target_nfe: int,\n        schedule: dict[str, float | int],\n        stage: str,\n    ) -> None:\n        slots_key = \"mid_tournament_slots\" if stage == \"mid\" else \"late_tournament_slots\"\n        slots = min(len(ranked), int(schedule[slots_key]))\n        if slots <= 0 or not self._needs_tournament(ranked, schedule):\n            return\n\n        tournament_time = float(\n            schedule[\"mid_tournament_time\"] if stage == \"mid\" else schedule[\"late_tournament_time\"]\n        )\n        for preview in ranked[:slots]:\n            particle = self._particle(env, preview.particle_id)\n            if particle is None or particle.status == \"pruned\":\n                continue\n            next_time = max(tournament_time, particle.time)\n            if next_time <= particle.time + 1e-9 and particle.time >= 1.0:\n                continue\n            if next_time <= particle.time + 1e-9:\n                continue\n            needed = self._move_cost(env, particle.time, next_time) + 1\n            if not self._reserve(env, target_nfe, needed):\n                return\n            self._advance_and_preview(env, preview.particle_id, target_time=next_time, solver=\"euler\")\n\n    def _needs_tournament(\n        self,\n        ranked: list[PreviewRecord],\n        schedule: dict[str, float | int],\n","exit_code":0,"status":"completed"}}
